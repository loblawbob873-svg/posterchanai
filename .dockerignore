# Keep the build context small and never ship secrets / local state.
.git
.gitignore
**/__pycache__/
**/*.pyc
*.pyo

# Local virtualenvs (huge; the image builds its own at /opt/venv)
venv*/
.venv/
env/

# Local runtime state — must NOT bake into the image (mount a volume instead)
posterchanai.db
posterchanai.db-*
data/
models/
.run/
*.gguf
*.safetensors

# Secrets / local config
.env
botframework/bots_config_export.json
# The HOST SearXNG's generated config: this node's settings.yml, its .secret and its cache DBs.
# The image bakes its own at /etc/searxng (Dockerfile) and points SEARXNG_SETTINGS_PATH there, so
# copying these in would achieve nothing except baking one node's cookie-signing key into an image.
searxng/
# `install.sh --office` downloads Collabora's CODE AppImage here — several hundred MB of
# third-party binary, and per-architecture. The IMAGE does not use it at all: docker-compose runs
# the `collabora/code` container instead (profile: office), so copying this in would bake a large
# binary into every image built on a machine that happens to have installed the bare-metal editor.
officeserver/

# Editor / OS cruft
.vscode/
.idea/
.DS_Store

# Docs and the bot framework's own export are not needed at runtime build time
# (source is still copied; this only trims obvious bulk)
*.log

# Depth model is fetched at runtime by docker-entrypoint.sh (keep image lean, build reproducible)
assets/depth_anything_v2_vits.onnx
*.onnx

# Build artifacts and local tool state that live in a working tree but never in a checkout. The image
# does `COPY . /app`, so without these a local build sent a 41 GB context and baked 12 GB of ISOs
# (iso-out/) into the image -- found 2026-09-25 during the GPU-stack upgrade.
iso-out/
*.iso
*.qcow2
.claude/
.recovery/
