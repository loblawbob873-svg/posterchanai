{
  "name": "posterchan-desktop",
  "version": "1.0.3",
  "private": true,
  "description": "PosterChan desktop app (Electron) — a native window onto a PosterChan instance",
  "desktopName": "place.poster.desktop.desktop",
  "main": "main.js",
  "scripts": {
    "start": "npm run www && electron .",
    "www": "bash build-www.sh",
    "icon": "node -e \"require('fs').mkdirSync('build',{recursive:true});require('fs').copyFileSync('../static/icon-512.png','build/icon.png');require('fs').copyFileSync('../static/icon-512.png','icon.png')\"",
    "prebuild": "npm run icon && npm run www",
    "build:win": "npm run prebuild && electron-builder --win nsis --publish never",
    "build:linux": "npm run prebuild && electron-builder --linux AppImage --publish never",
    "build:mac": "npm run prebuild && electron-builder --mac dmg --x64 --arm64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "build": {
    "appId": "place.poster.desktop",
    "productName": "PosterChan",
    "copyright": "PosterChan",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["*.js", "*.html", "icon.png", "package.json", "www/**/*"],
    "extraResources": [{ "from": "resources/tor", "to": "tor" }],
    "win": {
      "icon": "build/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "artifactName": "PosterChan-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "menuCategory": false,
      "shortcutName": "PosterChan",
      "runAfterFinish": true
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "PosterChan uses your camera for video calls and live streams.",
        "NSMicrophoneUsageDescription": "PosterChan uses your microphone for calls, live streams and voice input."
      },
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "artifactName": "PosterChan-${arch}.dmg"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "syncDesktopName": true,
      "synopsis": "PosterChan — Nostr client, chat and media",
      "target": [{ "target": "AppImage", "arch": ["x64"] }],
      "artifactName": "PosterChan.AppImage"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://poster.place/desktop/",
        "channel": "latest"
      }
    ]
  }
}
