 package nostr
 
 import (
+	"os"
 	"path/filepath"
 	"strconv"
+	"strings"
 	"time"
 
 	"github.com/nbd-wtf/go-nostr"
@@ -250,9 +252,27 @@ func BuildSoftwareAssetEvent(meta *AssetMetadata, pubkey string) *nostr.Event {
 	}
 
 	// APK certificate hash - REQUIRED for Android per NIP-82
+	// relay.zapstore.dev checks only the FIRST apk_certificate_hash against the certificate it pinned for the app
+	// (probed 2026-10-25: the pinned hash alone or first passes; the same hash second is refused). An app pinned to
+	// a predecessor in the APK's signing lineage names that pin first; the active signer still follows.
+	pinned := strings.ToLower(strings.TrimSpace(os.Getenv("ZSP_ANDROID_PINNED_CERTIFICATE_HASH")))
+	if pinned != "" && pinned != strings.ToLower(meta.CertFingerprint) {
+		tags = append(tags, nostr.Tag{"apk_certificate_hash", pinned})
+	}
 	if meta.CertFingerprint != "" {
 		tags = append(tags, nostr.Tag{"apk_certificate_hash", meta.CertFingerprint})
 	}
+	// Android accepts an APK signed by a rotated key when its proof-of-rotation
+	// links back to the installed signer. Zapstore currently preflights updates
+	// by intersecting the installed hash with these tags, before PackageInstaller
+	// can validate that lineage. Advertise prior approved lineage certificates as
+	// additional hashes while keeping CertFingerprint (the active signer) first.
+	for _, fingerprint := range strings.Split(os.Getenv("ZSP_ANDROID_PREVIOUS_CERTIFICATE_HASHES"), ",") {
+		fingerprint = strings.ToLower(strings.TrimSpace(fingerprint))
+		if fingerprint != "" && fingerprint != strings.ToLower(meta.CertFingerprint) && fingerprint != pinned {
+			tags = append(tags, nostr.Tag{"apk_certificate_hash", fingerprint})
+		}
+	}
 
 	return &nostr.Event{
 		Kind:      KindSoftwareAsset,
