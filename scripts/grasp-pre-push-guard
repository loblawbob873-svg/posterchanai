#!/bin/sh
# pre-push hook: stop a plain `git push` to an https GRASP remote BEFORE it fails cryptically.
#
# Why this exists: pushing to https://poster.place/git/<npub>/<id>.git needs a fresh NIP-98 header
# (git_auth.decide_push_ref route 0) or a maintainer-signed 30618 pinning the exact sha (route 1,
# what a nostr:// remote publishes for itself). Plain git can do neither, so the push travels all the
# way to the server and comes back as:
#
#     ! [remote rejected] main -> main (pre-receive hook declined)
#
# which names neither the cause nor the fix. Anyone with muscle memory for `git push` hits it. This
# turns that into an instruction, locally, before anything is transferred.
#
# Install (per repo, alongside the alias):
#     ln -sf /path/to/scripts/grasp-pre-push-guard .git/hooks/pre-push
#     git config alias.pushn '!/path/to/scripts/git-push-nostr'
#
# git invokes this as: pre-push <remote-name> <remote-url>
set -e

# git-push-nostr sets this: that push DOES carry the header, so stand aside. Guarding it would block
# the one command this hook recommends.
[ -n "$GIT_PUSH_NOSTR" ] && exit 0

url="$2"
case "$url" in
    # Only the GRASP host's https clone URLs. A nostr:// remote authorizes itself, and any other
    # remote (github, a plain server) is none of this hook's business.
    https://*/git/npub1*|http://*/git/npub1*) ;;
    *) exit 0 ;;
esac

remote="${1:-origin}"
cat >&2 <<EOF

  This remote is a GRASP (git-over-nostr) repo served over https:
      $url

  A plain \`git push\` carries no NIP-98 header, so the host's pre-receive hook will
  decline it. Push with the wrapper instead — same arguments:

      git pushn $remote <branch>

  (\`git pushn\` is a git alias for scripts/git-push-nostr, which mints a fresh
  maintainer-signed token bound to this repo's receive-pack URL. It cannot be a stored
  http.extraHeader: the host requires created_at within ±60s.)

EOF
exit 1
