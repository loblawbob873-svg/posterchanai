#!/usr/bin/env python3
"""git credential helper that mints a fresh NIP-98 (kind 27235) token per request.

Why this exists: nothing in the git client stack can emit GRASP's native
`Authorization: Nostr <b64-event>` header, so a PRIVATE repo on the built-in git host would be
unreadable. The host therefore also accepts the same base64 NIP-98 event as the password half of
HTTP Basic (`git_auth.verify_nip98(..., allow_basic=True)`, READ gate only) — and any git client can
produce a password via a credential helper. This is that helper.

Minting per invocation is the point: git calls a credential helper for every request, so each token
is fresh and comfortably inside the host's 300s read-freshness window. A stored token would go stale
and start 401ing five minutes in.

Deliberately dependency-free so it can be deployed to a machine with no posterchanai checkout (the
router, a laptop): it needs python3, `git`, and the two pure-stdlib crypto modules next to it.

Install (per repo, or --global):
    git config credential.https://poster.place.helper /path/to/git-credential-nostr
    git config credential.https://poster.place.useHttpPath true   # REQUIRED

`useHttpPath` is not optional: without it git hands the helper only protocol+host, so the token
could not carry a `u` tag naming this repo — and the host rejects any token not bound to the repo
being read. Without the path we emit nothing and fail closed rather than mint an unbound token.

Key resolution, in order:
  1. `nostr.nsec` in git config (what `ngit account login` sets) — the portable path;
  2. this node's posterchanai operator key, if a checkout is importable.
The signer must be in the repo's access set: maintainers (owner ∪ the 30617 `maintainers` tag) ∪ the
per-repo `readers` list. A machine that only needs to pull should get its OWN key added as a reader
rather than a copy of the owner's key.
"""

import base64
import json
import os
import subprocess
import sys
import time

NIP98_KIND = 27235
_HERE = os.path.dirname(os.path.abspath(__file__))


def _load_crypto():
    """bech32 + bip340, loaded BY PATH from a sibling copy or a posterchanai checkout.

    By path, not by package import: `app.services.nostr.__init__` pulls in `websockets` and the rest
    of the app, which a bare deployment machine (and the system python) does not have. These two
    modules are pure stdlib on their own.
    """
    import importlib.util
    candidates = (
        (os.path.join(_HERE, "bech32.py"), os.path.join(_HERE, "bip340.py")),
        (os.path.join(os.path.dirname(_HERE), "app", "services", "nostr", "bech32.py"),
         os.path.join(os.path.dirname(_HERE), "app", "services", "nostr", "bip340.py")),
    )
    for bech_path, bip_path in candidates:
        if not (os.path.exists(bech_path) and os.path.exists(bip_path)):
            continue
        mods = []
        for name, path in (("_ncred_bech32", bech_path), ("_ncred_bip340", bip_path)):
            spec = importlib.util.spec_from_file_location(name, path)
            mod = importlib.util.module_from_spec(spec)
            sys.modules[name] = mod
            spec.loader.exec_module(mod)
            mods.append(mod)
        return mods[0], mods[1]
    raise ImportError("bech32.py/bip340.py not found next to %s" % _HERE)


def _git_config(key: str) -> str:
    try:
        r = subprocess.run(["git", "config", "--get", key],
                           capture_output=True, text=True, timeout=15)
        return r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def _seckey(bech32mod) -> bytes | None:
    nsec = _git_config("nostr.nsec")
    if nsec:
        key = bech32mod.decode_key(nsec)
        if key:
            return key
    try:                                    # optional: posterchanai operator key
        root = os.path.dirname(_HERE)
        if root not in sys.path:
            sys.path.insert(0, root)
        from app.services import settings_store
        settings_store.load_local()
        from app.services import keystore
        nsec = keystore.get_operator_nsec()
        return bech32mod.decode_key(nsec) if nsec else None
    except Exception:
        return None


def _read_request() -> dict:
    """Parse git's credential protocol: key=value lines, terminated by a blank line or EOF."""
    out = {}
    for line in sys.stdin:
        line = line.rstrip("\n")
        if not line:
            break
        if "=" in line:
            k, v = line.split("=", 1)
            out[k] = v
    return out


def _sign_event(bip340mod, seckey: bytes, tags: list) -> dict:
    import hashlib
    pubkey = bip340mod.pubkey_from_seckey(seckey).hex()
    created_at = int(time.time())
    ser = json.dumps([0, pubkey, created_at, NIP98_KIND, tags, ""],
                     separators=(",", ":"), ensure_ascii=False).encode("utf-8")
    eid = hashlib.sha256(ser).hexdigest()
    sig = bip340mod.sign(bytes.fromhex(eid), seckey).hex()
    return {"id": eid, "pubkey": pubkey, "created_at": created_at, "kind": NIP98_KIND,
            "tags": tags, "content": "", "sig": sig}


def main() -> int:
    op = sys.argv[1] if len(sys.argv) > 1 else ""
    # `store`/`erase` are no-ops: nothing to persist, and the token is single-use by design.
    if op != "get":
        return 0

    req = _read_request()
    protocol = req.get("protocol") or "https"
    host = req.get("host") or ""
    path = req.get("path") or ""
    if not host or not path:
        # No path => credential.useHttpPath is unset. A token with no repo binding would be
        # rejected by the host anyway, so emit nothing and let git report the auth failure.
        sys.stderr.write("git-credential-nostr: need credential.useHttpPath=true for %s\n"
                         % (host or "?"))
        return 0

    bech32mod, bip340mod = _load_crypto()
    seckey = _seckey(bech32mod)
    if not seckey:
        sys.stderr.write("git-credential-nostr: no key (set git config nostr.nsec)\n")
        return 0

    url = "%s://%s/%s" % (protocol, host, path.lstrip("/"))
    ev = _sign_event(bip340mod, seckey, [["u", url], ["method", "GET"]])
    token = base64.b64encode(json.dumps(ev).encode("utf-8")).decode("ascii")
    npub = bech32mod.encode("npub", bytes.fromhex(ev["pubkey"]))

    sys.stdout.write("username=%s\npassword=%s\n" % (npub, token))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
