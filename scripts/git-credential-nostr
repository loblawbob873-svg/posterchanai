#!/usr/bin/env python3
"""git credential helper that mints a fresh NIP-98 (kind 27235) token per request.

Why this exists: ngit's remote helper is libgit2-based. It cannot set an arbitrary header, so it
can never send GRASP's native `Authorization: Nostr <b64-event>` — which means it could not read a
PRIVATE repo on the built-in git host at all. It *can* run a git credential helper, and the host now
also accepts the same base64 NIP-98 event as the password half of HTTP Basic
(`git_auth.verify_nip98(..., allow_basic=True)`, READ gate only). This is that helper.

Minting per invocation is the point: git calls a credential helper for every request, so each token
is fresh and comfortably inside the host's 300s read-freshness window. A stored/cached token would
go stale and 401 five minutes in.

Install (per repo, or --global):
    git config credential.https://poster.place.helper /path/to/scripts/git-credential-nostr
    git config credential.https://poster.place.useHttpPath true   # REQUIRED

`useHttpPath` is not optional: without it git hands the helper only protocol+host, so the token
could not carry a `u` tag naming this repo — and the host rejects any token not bound to the repo
being read. Without the path we emit nothing and fail closed rather than mint an unbound token.

Signs with this node's operator key (`keystore.get_operator_nsec`). The signer must be in the repo's
access set: maintainers (owner ∪ the 30617 `maintainers` tag) ∪ the per-repo `readers` list.
"""

import base64
import json
import os
import sys

_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
if _ROOT not in sys.path:
    sys.path.insert(0, _ROOT)

NIP98_KIND = 27235


def _read_request() -> dict:
    """Parse git's credential protocol: key=value lines, terminated by a blank line or EOF."""
    out = {}
    for line in sys.stdin:
        line = line.rstrip("\n")
        if not line:
            break
        if "=" in line:
            k, v = line.split("=", 1)
            out[k] = v
    return out


def main() -> int:
    op = sys.argv[1] if len(sys.argv) > 1 else ""
    # `store`/`erase` are no-ops: nothing to persist, and the token is single-use by design.
    if op != "get":
        return 0

    req = _read_request()
    protocol = req.get("protocol") or "https"
    host = req.get("host") or ""
    path = req.get("path") or ""
    if not host or not path:
        # No path => credential.useHttpPath is unset. A token with no repo binding would be
        # rejected by the host anyway, so emit nothing and let git report the auth failure.
        sys.stderr.write("git-credential-nostr: need credential.useHttpPath=true for %s\n" % (host or "?"))
        return 0

    from app.services import settings_store
    settings_store.load_local()
    try:
        from app.database import SessionLocal
        db = SessionLocal()
        try:
            settings_store.hydrate_from_db(db)
        finally:
            db.close()
    except Exception:
        pass  # local settings alone are enough to find the key; DB may be down

    from app.services import keystore
    from app.services.nostr import nostr_service
    from app.services.nostr.event import build_event

    nsec = keystore.get_operator_nsec()
    if not nsec:
        sys.stderr.write("git-credential-nostr: no operator key on this node\n")
        return 0

    seckey = nostr_service.decode_seckey(nsec)
    npub = nostr_service.npub_of(nostr_service.derive_pubkey(seckey))
    url = "%s://%s/%s" % (protocol, host, path.lstrip("/"))
    ev = build_event(seckey, NIP98_KIND, "", tags=[["u", url], ["method", "GET"]])
    token = base64.b64encode(json.dumps(ev).encode("utf-8")).decode("ascii")

    sys.stdout.write("username=%s\npassword=%s\n" % (npub, token))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
