#!/usr/bin/env python3
"""`git push` to the built-in GRASP host over PLAIN HTTPS, authorized by a fresh NIP-98 header.

Why this exists: a clone URL like `https://poster.place/git/<npub>/<id>.git` is served by nginx and
needs no special client to READ — `git-credential-nostr` covers the private-repo read gate. WRITES
are a different gate. `git_auth.decide_push_ref` accepts a push two ways:

  (0) a fresh kind-27235 NIP-98 header signed by a maintainer, bound to THIS receive-pack URL, or
  (1) a maintainer-signed kind-30618 state event on the hosting node's relay pinning the exact sha.

The `nostr://` remote (git-remote-nostr/ngit) takes route 1: it publishes the 30618, then pushes.
Plain git cannot publish a Nostr event, so an `https://` remote must take route 0 — and the Basic
envelope that `git-credential-nostr` mints is deliberately READ-ONLY (`allow_basic` is never passed
on the push path, asserted by tests/test_git_push_auth.py). So a plain `git push` to an https GRASP
remote is REJECTED unless something adds the header. This is that something.

The header cannot live in `git config http.extraHeader`: the host checks `created_at` within ±60s,
so a stored one is stale a minute later. It has to be minted per push, which is why this is a
wrapper rather than a config setting.

Usage (anywhere `git push` would be used, same arguments):
    git-push-nostr                          # push the current branch to origin
    git-push-nostr origin main
    git-push-nostr --force origin main:main

Install as a git alias so it reads naturally in a repo whose origin is an https GRASP URL:
    git config alias.pushn '!/path/to/git-push-nostr'
    git pushn origin main

Key resolution, crypto loading and the fail-closed posture are shared with `git-credential-nostr`
(imported by path) so there is ONE place that decides which key signs for this machine.
"""

import base64
import importlib.machinery      # NOT implied by importlib.util — the loader lives here
import importlib.util
import json
import os
import subprocess
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
_CRED = os.path.join(_HERE, "git-credential-nostr")


def _load_cred_helper():
    """Import the sibling credential helper as a module (it has a dash in its name, and no .py).

    Reused rather than copied: it already resolves the signing key (git config `nostr.nsec`, else
    this node's posterchanai operator key) and loads bech32/bip340 by path. Two copies of that logic
    would drift, and the failure mode of drift here is "pushes from this machine are signed by the
    wrong key", which reads as an ACL problem rather than a bug.
    """
    spec = importlib.util.spec_from_loader(
        "_gcn", importlib.machinery.SourceFileLoader("_gcn", _CRED))
    mod = importlib.util.module_from_spec(spec)
    sys.modules["_gcn"] = mod
    spec.loader.exec_module(mod)
    return mod


def _git(*args) -> tuple:
    r = subprocess.run(["git"] + list(args), capture_output=True, text=True)
    return r.returncode, (r.stdout or "") + (r.stderr or "")


def _remote_name(argv: list) -> str:
    """The remote in a push argument list: the first non-flag word. `git push -f origin main` and
    `git push origin` both name it; a bare `git push` means the branch's configured remote."""
    for a in argv:
        if not a.startswith("-"):
            return a
    rc, out = _git("config", "--get", "branch.%s.remote" %
                   _git("rev-parse", "--abbrev-ref", "HEAD")[1].strip())
    return out.strip() or "origin"


def main(argv: list) -> int:
    remote = _remote_name(argv)
    rc, url = _git("remote", "get-url", "--push", remote)
    url = url.strip()
    if rc != 0 or not url:
        sys.stderr.write("git-push-nostr: no push URL for remote %r\n" % remote)
        return 2

    if not url.startswith(("http://", "https://")):
        # A nostr:// remote already authorizes itself by publishing the 30618 (route 1) — adding a
        # header would do nothing. Hand it straight to git rather than silently doing something else.
        sys.stderr.write("git-push-nostr: %s is not an http(s) remote; using plain git push\n" % remote)
        return subprocess.run(["git", "push"] + argv).returncode

    base = url[:-1] if url.endswith("/") else url
    if not base.endswith(".git"):
        # The host binds the token to the repo by requiring its `u` path to contain
        # "<id>.git/git-receive-pack". A URL without the suffix would mint a token the host cannot
        # match, and the push would fail as an auth error rather than as the URL mistake it is.
        sys.stderr.write("git-push-nostr: push URL %r does not end in .git — the NIP-98 token could "
                         "not be bound to this repo\n" % base)
        return 2
    push_url = "%s/git-receive-pack" % base

    cred = _load_cred_helper()
    bech32mod, bip340mod = cred._load_crypto()
    seckey = cred._seckey(bech32mod)
    if not seckey:
        sys.stderr.write("git-push-nostr: no signing key (set `git config --global nostr.nsec …`)\n")
        return 2

    # method=POST: the push gate keeps require_method=True (reads relax it because a clone reuses one
    # static header across the info/refs GET and the upload-pack POST; a write is higher-stakes).
    ev = cred._sign_event(bip340mod, seckey, [["u", push_url], ["method", "POST"]])
    header = "Authorization: Nostr %s" % base64.b64encode(
        json.dumps(ev, separators=(",", ":")).encode("utf-8")).decode("ascii")

    # GIT_PUSH_NOSTR tells the pre-push guard (scripts/grasp-pre-push-guard, installed as a repo's
    # .git/hooks/pre-push) that this push DOES carry the header, so it should stand aside. Without it
    # the guard would block the very command it exists to recommend.
    env = dict(os.environ, GIT_PUSH_NOSTR="1")
    return subprocess.run(
        ["git", "-c", "http.extraHeader=%s" % header, "push"] + argv, env=env).returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
