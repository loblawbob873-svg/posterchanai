[Unit]
Description=Posterchanai AI Chat Application
After=network.target

[Service]
Type=simple
User=verita84
Group=verita84
WorkingDirectory=/home/verita84/posterchanai

# Uses start.sh to properly source Intel oneAPI environment
ExecStart=/home/verita84/posterchanai/start.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
