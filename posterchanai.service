[Unit]
Description=Posterchanai AI Chat Application
After=network.target

[Service]
Type=simple
User=verita84
Group=verita84
WorkingDirectory=/home/verita84/posterchanai
Environment="PATH=/home/verita84/posterchanai/venv/bin"
ExecStart=/home/verita84/posterchanai/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
