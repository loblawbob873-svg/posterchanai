<?xml version="1.0" encoding="utf-8"?>
<!-- The app's own dark/cyan, hardcoded: a widget is inflated by the LAUNCHER, which does not carry
     this app's theme, so ?attr colours resolve to the launcher's palette instead of ours. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <solid android:color="#E60B1420"/>
  <corners android:radius="18dp"/>
  <stroke android:width="1dp" android:color="#3300F0FF"/>
</shape>
