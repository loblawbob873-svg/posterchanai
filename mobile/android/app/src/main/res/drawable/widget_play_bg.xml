<?xml version="1.0" encoding="utf-8"?>
<!-- The primary action, and the only control that is always present (prev/next are hidden until
     something is playing). A filled disc is what makes it read as the button rather than as the
     middle of three equal glyphs — the same reason a play button is a circle in every media app. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
  <gradient
      android:type="linear"
      android:angle="135"
      android:startColor="#3D3CE8FF"
      android:endColor="#3DFF5CF0" />
  <stroke android:width="1dp" android:color="#773CE8FF"/>
</shape>
