<?xml version="1.0" encoding="utf-8"?>
<!-- The album tile. There is no artwork to show — a track is an encrypted blob only the client can
     decrypt, and the launcher has no key — so this is a DESIGNED placeholder rather than a bare icon
     floating on the background: a rounded cyan→magenta square that reads as cover art at a glance.
     Same gradient identity as the shell, turned the other way (315°) so the two do not look like one
     flat wash. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <gradient
      android:type="linear"
      android:angle="315"
      android:startColor="#333CE8FF"
      android:endColor="#33FF5CF0" />
  <corners android:radius="12dp"/>
  <stroke android:width="1dp" android:color="#443CE8FF"/>
</shape>
