<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- targetSdk 35 = Android 15 forces edge-to-edge, drawing the WebView UNDER the status/nav bars
             (the recurring "logout clipped / date over logo / buttons cut off" bugs). Opt out so Android
             insets the content below the system bars natively. Valid API 35+; ignored on older devices. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- One event line in the calendar widget. A STYLE rather than four copies of the same eight
         attributes: RemoteViews cannot set text appearance at runtime on older platforms, so the
         rows have to be identical by construction. -->
    <style name="PcWidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#E8FBFF</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- THE HOME SCREEN'S THEME. Three things it must do that an ordinary activity theme does not:
         show the wallpaper THROUGH the window (windowShowWallpaper + a transparent background, both
         — either alone gives a black home screen), draw no title bar, and skip the window animation
         so pressing HOME feels instant rather than like opening an app.

         Parent is a PLATFORM theme, not Theme.AppCompat: HomeActivity is a plain android.app.Activity
         on purpose. The launcher is the fallback that has to work when everything else in this app is
         broken, so it depends on as little of this app as possible — no AppCompat delegate, no
         Capacitor bridge, no WebView. -->
    <style name="PcHomeTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
