<?xml version="1.0" encoding="utf-8"?>
<!-- THE ONE WIDGET IN THIS APP THAT POLLS, and it is worth saying why.

     The calendar widget is pushed a month ahead and the music widget is pushed on every change, so
     both set updatePeriodMillis="0" and neither ever wakes the phone. A forecast is the one thing
     here that genuinely goes stale on its own, so this one asks for an hourly tick — which the
     platform clamps to a 30-minute minimum and batches with other wake-ups anyway. A tap refreshes
     immediately, which is what makes an hour rather than a minute acceptable.

     `configure` is what makes the "where are you" picker open the moment the widget is placed. A
     widget that lands blank and offers no way to fix itself is the classic grey box. -->
<!-- minResizeWidth / minResizeHeight ARE NOT OPTIONAL ON A PHONE, and their absence is what
     "widgets need support to fit on mobile phone screen" actually was. Without them EVERY launcher
     - ours included - treats minWidth/minHeight as the floor, so the widget can only ever be placed
     at exactly the size it asked for: a phone grid is 4 columns by 3-6 rows against a tablet's 5-7
     by 6-8, and the same rectangle that lands on one is refused by the other with "no room".
     Declaring the floor is the widget SAYING which smaller shapes it can still draw, which is the
     whole point of resizeMode. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="80dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="80dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/widget_weather"
    android:previewLayout="@layout/widget_weather"
    android:configure="place.poster.app.weather.WeatherConfigActivity"
    android:description="@string/weather_widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
