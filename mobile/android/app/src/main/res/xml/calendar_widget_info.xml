<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis="0": there is nothing to poll for. What changes the display is a push from
     the app (CalendarPlugin.push) or the date rolling over, and both arrive as broadcasts — and the
     platform clamps polling to 30 minutes anyway, which would be a wake-up an hour to redraw the
     same list. -->
<!-- minResizeWidth / minResizeHeight ARE NOT OPTIONAL ON A PHONE, and their absence is what
     "widgets need support to fit on mobile phone screen" actually was. Without them EVERY launcher
     - ours included - treats minWidth/minHeight as the floor, so the widget can only ever be placed
     at exactly the size it asked for: a phone grid is 4 columns by 3-6 rows against a tablet's 5-7
     by 6-8, and the same rectangle that lands on one is refused by the other with "no room".
     Declaring the floor is the widget SAYING which smaller shapes it can still draw, which is the
     whole point of resizeMode. -->
<!-- maxResizeWidth / maxResizeHeight: THE PROVIDER'S OWN CEILING, and on a phone it is the half
     that matters. A widget that has been placed is stored with a SPAN, and nothing re-derives it —
     so a span produced by the density-inflated arithmetic that used to run here (a 180dp card
     asking for six of a four-column grid, capped to the full width) stayed full width for ever, on
     every draw, with no way back except removing it. Reported as "the weather widget is just too
     gigantic on phones". Stating the ceiling lets the launcher put a widget back inside what the
     widget itself says it wants, once, instead of guessing. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="80dp"
    android:maxResizeWidth="560dp"
    android:maxResizeHeight="600dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_calendar"
    android:previewLayout="@layout/widget_calendar"
    android:description="@string/calendar_widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
