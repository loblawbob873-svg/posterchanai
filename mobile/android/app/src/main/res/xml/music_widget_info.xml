<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis="0": the widget is PUSHED by MusicService whenever the track or play state
     changes, so a polling wake-up would only ever redraw what is already on screen (and the platform
     clamps it to 30 minutes anyway, which is useless for a transport). -->
<!-- minResizeWidth / minResizeHeight ARE NOT OPTIONAL ON A PHONE, and their absence is what
     "widgets need support to fit on mobile phone screen" actually was. Without them EVERY launcher
     - ours included - treats minWidth/minHeight as the floor, so the widget can only ever be placed
     at exactly the size it asked for: a phone grid is 4 columns by 3-6 rows against a tablet's 5-7
     by 6-8, and the same rectangle that lands on one is refused by the other with "no room".
     Declaring the floor is the widget SAYING which smaller shapes it can still draw, which is the
     whole point of resizeMode. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_music"
    android:previewLayout="@layout/widget_music"
    android:description="@string/music_widget_description"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen" />
