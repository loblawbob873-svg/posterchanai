<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pc_th_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/pc_th_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/pc_th_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:contentDescription="@string/sms_back" />

        <TextView
            android:id="@+id/pc_th_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="2dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pc_th_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pc_th_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/pc_th_call"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:contentDescription="@string/sms_call" />

        <ImageView
            android:id="@+id/pc_th_menu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="11dp"
            android:contentDescription="@string/sms_menu" />
    </LinearLayout>

    <!-- Context from the person's own calendar, when there is any: "Sprint review at 3:00 PM".
         Hidden unless a real event with this person is coming up — a row that is always there and
         usually empty is a row people stop reading. -->
    <TextView
        android:id="@+id/pc_th_context"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="6dp"
        android:padding="10dp"
        android:textSize="12sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/pc_th_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:clipToPadding="false"
        android:stackFromBottom="true"
        android:transcriptMode="normal"
        android:scrollbarStyle="outsideOverlay" />

    <LinearLayout
        android:id="@+id/pc_th_attachment_draft"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:padding="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView android:id="@+id/pc_th_attachment_preview"
            android:layout_width="60dp" android:layout_height="60dp"
            android:scaleType="centerCrop" android:contentDescription="@string/sms_add_attachment" />
        <TextView android:id="@+id/pc_th_attachment_status"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginLeft="10dp" android:maxLines="2" />
        <Button android:id="@+id/pc_th_attachment_remove"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/sms_delete_msg" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pc_th_compose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_margin="8dp"
        android:padding="4dp">

        <ImageView
            android:id="@+id/pc_th_attach"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:contentDescription="@string/sms_add_attachment"
            android:src="@drawable/ic_pc_paperclip" />

        <ImageView
            android:id="@+id/pc_th_emoji"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:contentDescription="@string/sms_add_emoji"
            android:src="@drawable/ic_pc_smile" />

        <EditText
            android:id="@+id/pc_th_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:maxLines="6"
            android:padding="12dp"
            android:background="@null"
            android:hint="@string/sms_hint"
            android:inputType="textShortMessage|textMultiLine|textCapSentences|textAutoCorrect"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/pc_th_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:layout_marginRight="4dp"
            android:textSize="11sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/pc_th_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:contentDescription="@string/sms_send" />
    </LinearLayout>
</LinearLayout>
