<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ will not show a notification without this being GRANTED at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets an incoming call take the screen rather than arrive as a quiet banner. Android 14+
         grants this to calling apps; anywhere it is not granted the call degrades to a heads-up. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Receive a single file/text shared FROM another app (OS share sheet → PosterChan). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- Receive multiple files shared at once. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>

        </activity>

        <!-- A SECOND entry in the OS share sheet: "PosterChan AI". Same activity, different door — Android
             shows one target per exported component, so an alias is how one app offers two share destinations.
             Which one the user picked is read back from the launch intent's component (ShareTargetPlugin):
             the default target composes a post, this one drops the file/text into the AI chat. -->
        <activity-alias
            android:name=".ShareToAi"
            android:targetActivity=".MainActivity"
            android:label="PosterChan AI"
            android:icon="@mipmap/ic_launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Screen sharing while live. MediaProjection may only run from a foreground service, and from
             Android 14 the service must declare BOTH types it uses: mediaProjection (the capture) and
             microphone (we stream the mic over the screen as a voiceover). -->
        <!-- NIP-55: other Nostr apps on this phone ask US to sign, the way they ask Amber.
             An ACTION_VIEW on a `nostrsigner:` URI; we answer with setResult and finish.

             THIS IS WHY IT IS CHEAP. No service, no socket, no wakelock, no WebView — the OS starts
             this Activity when somebody asks and the process goes away again after. Between requests
             the signer costs nothing, because it is not running. The relay-based signer it replaces
             had to keep a browser engine resident to be reachable at all.

             `singleTask` + `excludeFromRecents`: a signing prompt is not a place in the back stack,
             and it must not leave what an app asked to sign sitting in the recents preview. -->
        <activity
            android:name=".signer.SignerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nostrsigner" />
            </intent-filter>
        </activity>

        <service
            android:name=".screenshare.ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <!-- Music: the lock-screen / shade / car transport, and the home-screen widget.
             A WebView implements navigator.mediaSession but publishes nothing to the OS (that half
             lives in Chrome, not in the WebView), so without this service music in the APK had no
             controls anywhere outside the app. mediaPlayback is also what keeps the WebView's render
             process off the low-memory killer's list while the screen is off.
             exported=false throughout: the only things that talk to it are our own plugin, our own
             notification, our own widget, and the platform's media-button router — none of which is
             another app. -->
        <service
            android:name=".music.MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- "Stay connected" — the persistent notification other messaging apps show. A FALLBACK, not
             the plan: push through a UnifiedPush distributor reaches a closed app for free and is what
             should be used. But a phone with no distributor installed receives NOTHING when the app is
             closed, which is indistinguishable from the feature being broken, and this is the answer
             for that case. Off by default; the notification says what it costs and turns it off in one
             tap. `specialUse`, NOT `dataSync`: Android 15 caps dataSync at six hours per day, which for
             a stay-connected service means it silently stops working most of the time. -->
        <service
            android:name=".push.StayAwakeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's own Nostr relay connection open so direct messages and
                               incoming calls arrive when no push distributor is installed. User
                               opt-in, off by default, cancellable from the notification." />
        </service>

        <!-- Voice/video calls. NOT the same reason as the music service above: since Android 11 an app
             in the BACKGROUND may not capture the microphone or camera at all unless a foreground
             service of the matching type is running. Without this, pressing Home mid-call silences
             your microphone instantly and silently — the other party hears nothing, the UI looks
             perfect, and nothing is logged. It also keeps the process off the cached-process freezer,
             which is what lets the WebRTC connection survive a locked screen.
             Both types are declared because a video call needs both; the service asks for camera only
             when the call actually has video. -->
        <service
            android:name=".call.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!-- Start at boot. NOT launching the app — Android has refused to allow that from the
             background for years and it is what people uninstall an app for. It restarts the ONE
             thing that was running before the reboot: the "stay connected" service, and only if the
             user turned it on (off by default, so on a normal install this receiver does nothing).
             BOOT_COMPLETED is an explicit exemption to Android 12's ban on background
             foreground-service starts, so it is allowed here and nowhere else. -->
        <receiver
            android:name=".push.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Today's events on the home screen. Same split as the music widget: the LAUNCHER draws it
             and has no key, no session and no business having either, so the WebView pushes what it
             has already decrypted and this renders it. ACTION_DATE_CHANGED is registered because
             without it the widget shows YESTERDAY's list until something else happens to redraw it,
             which on a home screen can be hours. -->
        <receiver
            android:name=".calendar.CalendarWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <!-- Headset / steering-wheel buttons on Android versions that deliver them as a broadcast.
             MediaSessionCompat looks this receiver up BY NAME at construction and warns (then routes
             nothing) when it is absent — it is what forwards the button to the service above. -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- The home-screen widget. exported=false is correct even though the launcher draws it: the
             APPWIDGET_UPDATE broadcast comes from the system, which is exempt, and our own buttons
             are explicit intents from inside the app. -->
        <receiver
            android:name=".music.MusicWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_widget_info" />
        </receiver>

        <!-- Password autofill. exported + the BIND_AUTOFILL_SERVICE permission is what lets the
             SYSTEM bind it and nothing else; the permission is held by the platform alone, so this
             is not an entry point any other app can reach. AutofillService is API 26 and minSdk is
             23 — on 23-25 the system simply never binds it, so no guard is needed here beyond the
             @RequiresApi on the class. -->
        <service
            android:name=".vault.PosterChanAutofillService"
            android:exported="true"
            android:label="PosterChan Passwords"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
    
        <!-- The account our contacts belong to. A RawContact must have an account, and this account
             is what makes the feature reversible: the Contacts app groups our cards under
             "PosterChan", the user can hide them there, and removing the account deletes every one.
             The authenticator behind it is a STUB — nothing here authenticates anything (the key is
             a Nostr key held in the WebView), and there is deliberately NO sync adapter, because a
             system-scheduled sync runs in a process that cannot read an encrypted card.
             exported=true is required: the binder is the platform's, and it is guarded by answering
             only ACTION_AUTHENTICATOR_INTENT. -->
        <service
            android:name=".contacts.AuthenticatorService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/contacts_authenticator" />
            <!-- The EDIT SCHEMA. Its presence is what lets the phone's Contacts app edit our cards
                 and save new ones into this account — the sync reads them back. It declares exactly
                 the fields we round-trip: see the file, which explains why "exactly" matters. -->
            <meta-data
                android:name="android.provider.CONTACTS_STRUCTURE"
                android:resource="@xml/contacts_structure" />
        </service>

        <!-- Where a UnifiedPush distributor delivers. In connector 3.x this is a SERVICE on the
             PUSH_EVENT action, and it must NOT be exported — the distributor binds it by permission,
             and exporting it would let any app on the phone feed us notifications. -->
        <service
            android:name="place.poster.app.push.PushEventService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

    </application>

    <!-- NIP-55: which other apps we are allowed to SEE. Android 11+ hides the package list by default, so
         without this queryIntentActivities() for "nostrsigner:" comes back empty and the app reports "no
         signer installed" on a phone that has Amber sitting right there. Declaring the intent (not the
         package) keeps it signer-agnostic — any app registering the scheme is discoverable. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="nostrsigner" />
        </intent>
        <!-- Orbot, by package: unlike the signer (any app registering the scheme will do) there is exactly
             one Orbot, and we look it up by name via getPackageInfo(), which package visibility gates the
             same way. Without this the Tor panel reports "Orbot not installed" on a phone that has it. -->
        <package android:name="org.torproject.android" />
        <!-- Launchable apps, so the autofill association picker can show "Chase" instead of
             "com.chase.sig.android". Android 11+ hides the package list, and getApplicationLabel()
             for an app we cannot SEE throws NameNotFoundException — which the picker catches and
             degrades to the raw package name, i.e. to the list of reverse-DNS strings the picker
             exists to avoid. The MAIN/LAUNCHER intent (not QUERY_ALL_PACKAGES, which Play restricts)
             is the narrow form: it reveals nothing beyond what the launcher already shows. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Permissions: networking, camera + mic (getUserMedia / attach a photo), media read for attaching
         files, notifications, and network-state for the relay reconnect logic. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Voice/video calls: keep the CPU/mic alive so a call survives the screen turning off / brief backgrounding. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Screen sharing (live streaming): the WebView has no getDisplayMedia, so the screen is captured
         natively via MediaProjection, which Android only allows from a mediaProjection foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Music playing with the screen off: the media-session foreground service (lock screen, shade,
         car, widget). Android 14+ refuses to START a service whose declared type it has no permission
         for, so this is not optional decoration — without it the controls never appear. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- A video call's foreground service declares `camera` as well as `microphone`, and Android 14+
         refuses to START a service whose declared type it has no permission for. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- The "stay connected" service (off by default) — see StayAwakeService for why specialUse. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Start at boot (see BootReceiver): restarts the stay-connected service the user opted into,
         and redraws the home-screen calendar the launcher rebuilt from scratch. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Putting your PosterChan address book into the phone's OWN Contacts app (opt-in, off by
         default, asked for at the moment the switch is flipped). WRITE is the feature; READ is what
         makes it a RECONCILE rather than a wipe-and-rewrite — it reads back the raw contacts under
         our own account type (and nothing else) so a card can be updated in place, keeping the
         favourite star and the contact id, and so a contact deleted in the app can be deleted here
         instead of living on in the dialer. Both are in the CONTACTS group, so Android asks once. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- ContentResolver.setIsSyncable / setSyncAutomatically REQUIRE this, and throw SecurityException
         without it. ContactWriter calls both to take our account OFF the sync framework (there is no
         sync adapter to run — see its class comment), and undeclared they threw on every call: the
         verdict "the account exists" was computed from whether those two calls succeeded, so a phone
         with the account plainly present was told it had none and NOT ONE CONTACT WAS EVER WRITTEN.
         ensureAccount no longer conflates the two, but the calls are meant to work, so: declared.
         It is a NORMAL permission — granted at install, no prompt, no runtime request. -->
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />

    <!-- required="false" so tablets / camera-less devices can still install and run. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
</manifest>
