# Copy to `.env` (same directory as docker-compose.yml) and edit. Docker Compose reads it
# automatically, so these apply to `docker compose ...` on the command line AND to the VS Code
# Docker extension, which has no way to pass --profile itself.
#
#   cp .env.example .env
#
# Full walkthrough for a Nostr-only node: docs/NOSTR_DOCKER.md

# --- Which parts of the stack to run ----------------------------------------------------------
# EVERY service except postgres sits behind a profile, so with this unset `docker compose up -d`
# starts postgres ALONE — no app, no relay, no proxy, and no error saying so. Pick ONE backend
# profile, and add `tls` for the bundled nginx+certbot HTTPS proxy:
#
#   nostr   relay + web client + Blossom, no AI (~2 GB image)
#   cpu     full app, LLM/image on CPU
#   cuda | rocm | intel    full app on a GPU (see docs/DOCKER.md for host requirements)
#   tls     the HTTPS proxy — add it to any of the above
COMPOSE_PROFILES=nostr,tls

# --- Database ---------------------------------------------------------------------------------
# Postgres is the only supported database; it backs both the app and the Nostr relay. This is the
# one place the password is set — the postgres service and the app both read it.
# Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=change-this-to-a-long-random-string

# Leave DATABASE_URL UNSET unless you are pointing at your own external Postgres. The compose file
# builds the right URL from POSTGRES_PASSWORD above, and a value here overrides it for the `split`
# profile's containers. (It must never be sqlite — that backend is gone.)
#DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/posterchan_relay

# --- HTTPS (only used with the `tls` profile) --------------------------------------------------
# Fills in the proxy's server_name and its self-signed certificate's CN, on FIRST BOOT ONLY. After
# that the proxy's config file is yours — edit it in the container and re-run certbot.
POSTERCHANAI_DOMAIN=example.com

# --- Ports ------------------------------------------------------------------------------------
# With the proxy in front, keep the app and relay on loopback so http://<your-ip>:3051 stops
# answering around your TLS. The proxy reaches them over the Docker network, not these mappings.
POSTERCHANAI_PORT=127.0.0.1:3051
POSTERCHANAI_NOSTR_RELAY_PORT=127.0.0.1:3052
#
# ONLY those two. TURN (3478, 49160-49200/udp) and streaming (1935 RTMP from OBS, 8889 + 8189/udp
# WHIP from phones) are reached DIRECTLY by peers and publishers — they are not HTTP, the proxy
# does not front them, and putting them on loopback silently breaks calls and going live.

# --- Optional features (all off by default; see docs/DOCKER.md) --------------------------------
#POSTERCHANAI_GIT=1
#POSTERCHANAI_GIT_PUBLIC_BASE=https://example.com/git
#POSTERCHANAI_TURN=1        # voice/video calls — needs a public IP + the TURN ports forwarded
#POSTERCHANAI_STREAM=1      # OBS/phone live streaming — needs the streaming ports forwarded
#POSTERCHANAI_MUSIC=1       # music generation (builds ACE-Step into the image; GPU recommended)
#POSTERCHANAI_VIDEO=1       # text-to-video (needs a GPU profile)

# --- App --------------------------------------------------------------------------------------
# Session signing key. Leave unset and one is generated and persisted on first run; set it only if
# you want sessions to survive a volume wipe.
#SECRET_KEY=change-this-to-a-secure-random-key
