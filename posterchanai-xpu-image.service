# Posterchan AI Image Service - PyTorch XPU on Intel Arc GPU
# NOTE: This is a template file. The installer generates the actual service
# file with the correct user and paths in /etc/systemd/system/
#
# To use this template manually, replace:
#   - YOUR_USER with your username
#   - /path/to/posterchanai with the actual installation path

[Unit]
Description=Posterchan AI Image Generation (Intel XPU PyTorch)
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/posterchanai

# Minimal environment - the run script sets up oneAPI environment
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/home/YOUR_USER"

# Use separate database and port for image-only instance
Environment="POSTERCHANAI_DB=posterchanai-image.db"
Environment="POSTERCHANAI_PORT=3052"

# The run script (run-xpu-image.sh) handles oneAPI setup
ExecStart=/path/to/posterchanai/run-xpu-image.sh

# Quick restart - don't wait forever for stuck GPU processes
TimeoutStopSec=10
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

Restart=always
RestartSec=3
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
