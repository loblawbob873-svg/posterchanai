<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messages_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

    <!-- Quick actions: PIM, FILES, WEB, Generate, Translate, RAG (like web UI) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:background="@color/cyberpunk_bg_secondary">

        <LinearLayout
            android:id="@+id/quick_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="40dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_btn_chat"
                style="@style/Widget.PosterchanAI.Button.QuickAction"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/quick_chat"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_btn_pim"
                style="@style/Widget.PosterchanAI.Button.QuickAction"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/quick_pim"
                android:layout_marginStart="6dp"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_btn_files"
                style="@style/Widget.PosterchanAI.Button.QuickAction"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/quick_files"
                android:layout_marginStart="6dp"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_btn_web"
                style="@style/Widget.PosterchanAI.Button.QuickAction"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/quick_web"
                android:layout_marginStart="6dp"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_btn_generate"
                style="@style/Widget.PosterchanAI.Button.QuickAction"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/quick_generate"
                android:layout_marginStart="6dp"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_btn_translate"
                style="@style/Widget.PosterchanAI.Button.QuickAction"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/quick_translate"
                android:layout_marginStart="6dp"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_btn_rag"
                style="@style/Widget.PosterchanAI.Button.QuickAction"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/quick_rag"
                android:layout_marginStart="6dp"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/attach_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/attach_file"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_attach_24"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/camera_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/take_photo"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_camera_24"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/voice_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/voice_input"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_mic_24"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:hint="@string/message_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="48dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/send" />
    </LinearLayout>
</LinearLayout>
