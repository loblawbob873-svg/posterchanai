# ACE-Step music server for PosterChanAI's `musicgeni` command.
#
# Separate image from the main app: ACE-Step 1.5 needs Python 3.11–3.12 and a torch/transformers
# stack that conflicts with PosterChanAI's venv, and it ships a REST server (`acestep-api`). The
# app talks to it over HTTP (app/services/music_service.py) — same arrangement as the external
# image servers.
#
# ACE-Step is NOT on PyPI; it's installed from its git repo with `uv` (its own recommended
# installer, which also provisions Python 3.12).
#
# GPU: defaults to CUDA (uv sync's CUDA torch wheel bundles the runtime; needs only the host NVIDIA
# driver via nvidia-container-toolkit). For AMD ROCm / Intel XPU, pass TORCH_INDEX — the build then
# swaps to a matched torch+vision+audio trio, drops torchcodec (CUDA-only) and patches ACE-Step's
# audio save to use soundfile (torchcodec-free), e.g.:
#   docker build -f Dockerfile.acestep --build-arg TORCH_INDEX=https://download.pytorch.org/whl/rocm6.3 -t posterchanai-acestep:rocm .
#   (use rocm6.3+ — rocm6.2 ships torch 2.5.1, too old for ACE-Step which needs torch>=2.6)
#   docker build -f Dockerfile.acestep --build-arg TORCH_INDEX=https://download.pytorch.org/whl/xpu   -t posterchanai-acestep:xpu  .
FROM python:3.12-slim

ENV ACESTEP_API_HOST=0.0.0.0 \
    ACESTEP_API_PORT=8001 \
    UV_LINK_MODE=copy \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/root/.local/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        git ffmpeg ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

# uv (ACE-Step's recommended installer; provisions Python 3.12 + resolves the locked deps).
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

ARG ACESTEP_REF=main
RUN git clone --depth 1 --branch "${ACESTEP_REF}" https://github.com/ace-step/ACE-Step-1.5.git /opt/ace-step \
    || git clone --depth 1 https://github.com/ace-step/ACE-Step-1.5.git /opt/ace-step
WORKDIR /opt/ace-step
RUN uv sync

# Non-CUDA GPUs: swap the torch trio (matched ABI in ONE resolve), drop the CUDA-only torchcodec,
# and patch ACE-Step's audio save to use soundfile. No-op when TORCH_INDEX is empty (CUDA).
COPY scripts/acestep_soundfile_patch.py /tmp/acestep_soundfile_patch.py
ARG TORCH_INDEX=""
RUN if [ -n "$TORCH_INDEX" ]; then \
        uv pip install --reinstall torch torchvision torchaudio --index-url "$TORCH_INDEX" && \
        (uv pip uninstall torchcodec || true) && \
        python3 /tmp/acestep_soundfile_patch.py /opt/ace-step ; \
    fi
# (the patch step uses plain python3 — `uv run` would re-sync the venv to uv.lock and revert the
#  torch swap above back to CUDA. The runtime CMD uses .venv/bin directly for the same reason.)

EXPOSE 8001
# Models auto-download on first request into ~/.cache/huggingface (mount it as a volume to persist).
# Run the venv entrypoint DIRECTLY: `uv run` re-syncs to uv.lock (CUDA torch) on launch and would
# revert a ROCm/XPU torch swap back to CUDA → CPU fallback. `.venv` is created by `uv sync` above.
CMD ["/opt/ace-step/.venv/bin/acestep-api"]
