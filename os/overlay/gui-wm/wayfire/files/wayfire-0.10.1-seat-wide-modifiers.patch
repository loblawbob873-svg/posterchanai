+/* ONE PHYSICAL KEYBOARD CAN BE SEVERAL INPUT DEVICES. A gaming keyboard in N-key rollover mode
+ * (measured: ASUS ROG Strix Scope II 96) reports Super on one interface and the letters and arrows
+ * on another, and wlroots keeps modifier state per device -- so Super+G arrived as a bare G and no
+ * <super> key binding could ever match, while Super+click (which reads the seat's keyboard) worked.
+ * Match key bindings against what is held on ANY keyboard of the seat, as Sway's keyboard grouping
+ * effectively does. */
+static uint32_t wf_seat_wide_modifiers(wf::keyboard_t *self)
+{
+    uint32_t mods = self->get_modifiers();
+    for (auto& kbd : wf::get_core_impl().seat->priv->keyboards)
+    {
+        mods |= kbd->get_modifiers();
+    }
+
+    return mods;
+}
