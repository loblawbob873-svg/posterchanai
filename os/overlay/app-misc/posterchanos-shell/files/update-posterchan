#!/bin/bash
# Update PosterChan on PosterChanOS.
#
# WHY THIS IS A COMMAND AND NOT AN ALIAS. An alias exists only inside an interactive bash — it is
# invisible to `sudo`, to a .desktop entry, to a script, and over ssh, which are most of the ways
# somebody would actually reach for it. A file in /usr/local/bin works everywhere and can be pointed
# at by the start menu.
#
# WHAT IT UPDATES, and why it is two packages. `posterchan-desktop` is the app — an AppImage from the
# release, extracted into /opt/posterchan. `posterchanos-shell` is the SESSION: sway's config, the
# pc-* helpers, the Plymouth theme. They ship separately and are versioned separately, and updating
# one alone leaves the desktop and the app that draws it out of step — a key binding that sends a
# tick nothing listens for, or a helper the app expects and does not find.
set -u

RED=$'\033[1;31m'; YEL=$'\033[1;33m'; GRN=$'\033[1;32m'; CYA=$'\033[1;36m'; OFF=$'\033[0m'
PKGS="app-misc/posterchan-desktop app-misc/posterchanos-shell"

# ROOT, BY RE-EXEC RATHER THAN BY REFUSING. Being told "run this with sudo" is a worse answer than
# being asked for a password, and this is the command somebody types when they want the update, not
# when they want a lecture about privileges.
if [ "$(id -u)" -ne 0 ]; then
	exec sudo -- "$0" "$@"
fi

# ONE UPDATE OWNS PORTAGE'S OVERLAY CHECKOUT AT A TIME. `emaint sync` does not serialize the Git
# object writes itself: two launchers started together can leave a zero-byte loose object, after
# which every later update falls back to stale metadata and incorrectly says "Already up to date".
# Hold the lock for this process's lifetime; a second invocation waits and then re-checks normally.
mkdir -p /run/lock
exec 9>/run/lock/posterchan-update.lock
flock 9

command -v emerge >/dev/null 2>&1 || {
	echo "${RED}This is for PosterChanOS — there is no emerge on this machine.${OFF}"
	exit 1
}

# ---------------------------------------------------------------- how this machine got its desktop
#
# TWO WAYS, and asking which is the whole of this script's job.
#
# The overlay path (`emerge app-misc/posterchan-desktop`) is the tidy one, and on a machine where
# those packages are actually installed it is what should run. But the INSTALLER does not use it:
# gentoo.sh downloads the release and extracts it into /opt/posterchan directly, so on every machine
# installed from the ISO portage has never heard of the desktop -- `qlist` lists nothing, and an
# update built on `emerge -u` has nothing to update. It failed twice over on the first machine that
# ran it: the overlay had no git remote to sync from ("overlay not found"), and the ebuild had no
# Manifest, so the binary it did fetch was refused ("VERIFY FAILED! Insufficient data for checksum
# verification").
#
# So: use portage where portage owns it, and otherwise do exactly what the installer did.
have_pkgs="$(qlist -Iv app-misc/posterchan-desktop app-misc/posterchanos-shell 2>/dev/null | sort)"

if [ -n "$have_pkgs" ]; then
	echo "${CYA}Syncing the PosterChanOS overlay${OFF}"
	if ! emaint sync -r posterchan; then
		# The public bare repository can be restored from backup after storage failure. In that case
		# an installed checkout and the restored release channel have unrelated Git histories, and
		# Portage's ordinary sync refuses to cross them. This directory is only Portage's disposable
		# overlay cache: fetch and reset that one bounded checkout, never user files or /etc.
		if [ -d /var/db/repos/posterchan/.git ] \
			&& git -C /var/db/repos/posterchan fetch --prune origin main \
			&& git -C /var/db/repos/posterchan reset --hard FETCH_HEAD; then
			echo "${GRN}Repaired the local PosterChanOS overlay checkout.${OFF}"
		else
			echo "${YEL}Could not reach the overlay — trying the update with what is already here.${OFF}"
		fi
	fi
	echo "${CYA}Updating${OFF} $PKGS"
	if ! emerge -u --quiet-build=n $PKGS; then
		echo
		echo "${RED}The update failed. Nothing was replaced — the running desktop is untouched.${OFF}"
		exit 1
	fi
	after="$(qlist -Iv app-misc/posterchan-desktop app-misc/posterchanos-shell 2>/dev/null | sort)"
	echo
	if [ "$have_pkgs" = "$after" ]; then
		echo "${GRN}Already up to date.${OFF}"
		exit 0
	fi
	printf "${GRN}Now installed:${OFF}\n"; printf '  %s\n' $after
else
	# ------------------------------------------------------------ the release, straight into /opt
	#
	# THE OLD DESKTOP IS NOT TOUCHED UNTIL THE NEW ONE IS ON DISK AND HAS BEEN LOOKED AT. Downloaded,
	# extracted and checked in a temp directory, then swapped by rename. An update that fails leaves
	# the machine running exactly what it was running, which matters more here than anywhere else:
	# this IS the desktop, and a half-replaced one is a black screen with no way back.
	TMP="$(mktemp -d /var/tmp/pc-update.XXXXXX)" || exit 1
	trap 'rm -rf "$TMP"' EXIT
	NEW="$TMP/tree"

	# A PLAIN TARBALL FIRST, THE APPIMAGE ONLY IF THERE IS NOT ONE. The desktop ships in two shapes
	# from one build: the AppImage for an ordinary Linux desktop, where it auto-updates, and a
	# tar.zst of the same files for machines that install it into /opt. This is the second kind.
	# Mounting an AppImage needs FUSE, which a minimal profile does not have, and it verifies itself
	# on every start -- so taking one here meant downloading a self-mounting archive purely to unpack
	# it and throw the wrapper away. The fallback stays because a release cut before the tarball
	# existed has only the image.
	echo "${CYA}Downloading the current desktop${OFF}"
	TARURL="${PC_DESKTOP_TAR:-}"
	if [ -z "$TARURL" ]; then
		TARURL="$(curl -fsSL --retry 2 \
			https://api.github.com/repos/loblawbob873-svg/posterchanai/releases/tags/desktop-latest \
			2>/dev/null | grep -o 'https://[^"]*linux-x64\.tar\.zst' | head -1)"
	fi
	if [ -n "$TARURL" ] && curl -fL --progress-bar -o "$TMP/app.tar.zst" "$TARURL"; then
		mkdir -p "$NEW"
		if ! tar -C "$NEW" -xaf "$TMP/app.tar.zst"; then
			echo "${RED}The download did not unpack — it is probably incomplete. Nothing was changed.${OFF}"
			exit 1
		fi
	else
		REL="${PC_DESKTOP_URL:-https://github.com/loblawbob873-svg/posterchanai/releases/download/desktop-latest/PosterChan.AppImage}"
		echo "${YEL}No tarball in that release — falling back to the AppImage.${OFF}"
		if ! curl -fL --progress-bar -o "$TMP/app.AppImage" "$REL"; then
			echo "${RED}Could not download it. Nothing was changed.${OFF}"
			exit 1
		fi
		chmod +x "$TMP/app.AppImage"
		# EXTRACTED, NEVER RUN AS ONE — see above.
		if ! ( cd "$TMP" && ./app.AppImage --appimage-extract >/dev/null 2>&1 ) \
			|| [ ! -x "$TMP/squashfs-root/AppRun" ]; then
			echo "${RED}The download did not extract — it is probably incomplete. Nothing was changed.${OFF}"
			exit 1
		fi
		NEW="$TMP/squashfs-root"
	fi
	# WHAT PROVES A GOOD TREE IS THE BINARY, NOT AppRun.
	#
	# AppRun is an APPIMAGE artefact -- electron-builder writes it when it wraps the build into an
	# image, and it is the shim that turns $APPDIR into a path. The tarball is the build BEFORE that
	# wrapping (dist/linux-unpacked), so it has no AppRun and never will. Checking for one rejected
	# a perfectly good download: "That download has no desktop in it. Nothing was changed."
	if [ -x "$NEW/posterchan-desktop" ]; then
		:
	elif [ -x "$NEW/AppRun" ]; then
		:
	else
		echo "${RED}That download has no desktop in it. Nothing was changed.${OFF}"
		exit 1
	fi
	chmod -R a+rX "$NEW"
	chmod 0755 "$NEW/AppRun" 2>/dev/null || true
	[ -f "$NEW/posterchan-desktop" ] && chmod 0755 "$NEW/posterchan-desktop"
	# Electron will not start unless its sandbox helper is setuid root, and no archive can carry that
	# bit. The alternative is --no-sandbox, i.e. turning the renderer sandbox off.
	[ -f "$NEW/chrome-sandbox" ] && chown root:root "$NEW/chrome-sandbox" && chmod 4755 "$NEW/chrome-sandbox"

	# IS IT ACTUALLY NEWER? Compared by the bytes of the launcher's own bundle rather than by a
	# version string, because the rolling release re-uses one url and a machine that re-downloads the
	# same build should say so instead of announcing an update nobody got.
	if [ -f /opt/posterchan/resources/app.asar ] && [ -f "$NEW/resources/app.asar" ] \
		&& cmp -s /opt/posterchan/resources/app.asar "$NEW/resources/app.asar"; then
		echo "${GRN}Already up to date.${OFF}"
		exit 0
	fi

	echo "${CYA}Installing${OFF}"
	OLD="/opt/posterchan.old.$$"
	mkdir -p /opt
	if [ -d /opt/posterchan ]; then mv /opt/posterchan "$OLD" || exit 1; fi
	if ! mv "$NEW" /opt/posterchan; then
		# Put it back. A machine with no /opt/posterchan boots sway with nothing in it.
		[ -d "$OLD" ] && mv "$OLD" /opt/posterchan
		echo "${RED}Could not install it — the previous desktop was put back.${OFF}"
		exit 1
	fi
	rm -rf "$OLD"

	# The wrapper the session execs. AppRun finds the binary through $APPDIR, which the AppImage
	# RUNTIME would have set — exactly the thing extracting removes.
	# THE WRAPPER RUNS WHICHEVER SHAPE IS INSTALLED. A tarball install has the binary and no AppRun;
	# an AppImage extraction has both, and its AppRun is the shim that needs $APPDIR. Preferring the
	# binary means the tarball path does not depend on a file the AppImage runtime invented.
	cat >/usr/local/bin/posterchan <<-'WRAP'
		#!/bin/sh
		export APPDIR=/opt/posterchan
		: "${ELECTRON_OZONE_PLATFORM_HINT:=auto}"
		export ELECTRON_OZONE_PLATFORM_HINT
		if [ -x "$APPDIR/posterchan-desktop" ]; then exec "$APPDIR/posterchan-desktop" "$@"; fi
		exec "$APPDIR/AppRun" "$@"
	WRAP
	chmod 0755 /usr/local/bin/posterchan
	echo "${GRN}Updated.${OFF}"
fi

# THE RESTART IS NOT DONE HERE, and that is deliberate. On PosterChanOS the shell IS the desktop:
# restarting it closes every window, and doing that inside an update somebody ran while working is
# how an update becomes something they avoid. Said, not performed.
echo
echo "${YEL}The new desktop starts at your next login.${OFF}"
echo "${YEL}To pick it up now (this closes your windows):${OFF}"
echo "    swaymsg exec 'sh -c \"pkill -f posterchan[-]desktop; sleep 3; exec /usr/local/bin/pc-shell-start\"'"

# /etc/sway/config IS PORTAGE'S. An etc-update replaces a hand-edited one with the shipped version —
# intended for a shipped session, and exactly what silently reverted the key bindings during
# development, so it is worth a sentence at the moment it becomes true rather than a surprise later.
if command -v dispatch-conf >/dev/null 2>&1 || command -v etc-update >/dev/null 2>&1; then
	if find /etc -name '._cfg????_*' -print -quit 2>/dev/null | grep -q .; then
		echo
		echo "${YEL}Portage left config updates to review (etc-update).${OFF}"
		echo "${YEL}NOTE: /etc/sway/config is one of ours — accepting the new one discards local edits.${OFF}"
	fi
fi
