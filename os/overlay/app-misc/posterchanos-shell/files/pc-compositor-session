#!/bin/sh
# PosterChanOS compositor selector. Sway remains the proven default because the desktop's native
# window bridge currently speaks Sway IPC. Wayfire can be selected for staged testing without
# removing the known-good session: write "wayfire" to ~/.config/posterchanos/compositor.
set -u

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/posterchanos"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/posterchanos"
selection_file="$config_dir/compositor"
mkdir -p "$state_dir"

selected="${PC_COMPOSITOR:-}"
if [ -z "$selected" ] && [ -r "$selection_file" ]; then
	IFS= read -r selected <"$selection_file"
fi
case "$selected" in
	wayfire|sway) ;;
	*) selected=sway ;;
esac

run_sway() {
	export XDG_CURRENT_DESKTOP=sway
	export XDG_SESSION_DESKTOP=sway
	exec sway >"$state_dir/sway.log" 2>&1
}

if [ "$selected" = wayfire ]; then
	# QEMU's non-GL virtio-vga exposes a DRM card but no accelerated VirGL context. Chromium's
	# compositor aborts (SIGTRAP) when it tries that unusable render node. Keep physical GPUs and
	# VirGL-capable guests accelerated; only the virtio device with no render-node capability uses
	# Mesa's supported llvmpipe path. This is deliberately not Electron --disable-gpu.
	if grep -qs '^0x1af4$' /sys/class/drm/card*/device/vendor 2>/dev/null; then
		export LIBGL_ALWAYS_SOFTWARE=1
		export WLR_RENDERER_ALLOW_SOFTWARE=1
		PC_SHELL_EXTRA_ARGS="${PC_SHELL_EXTRA_ARGS:+$PC_SHELL_EXTRA_ARGS }--use-angle=swiftshader --enable-unsafe-swiftshader"
		export PC_SHELL_EXTRA_ARGS
	fi
	health=${PC_WAYFIRE_HEALTH:-/usr/local/bin/pc-wayfire-health}
	# Refuse the compositor switch while the installed Electron package is still Sway-only.  This
	# runs before DRM ownership changes, so an overlay/Desktop publication race cannot black-screen
	# the session and rely on the later watchdog to put it back.
	if ! command -v wayfire >/dev/null 2>&1 || ! wayfire --version >/dev/null 2>&1; then
		printf '%s\n' "Wayfire was selected but its executable/ABI is unavailable; falling back to Sway." \
			>>"$state_dir/compositor-fallback.log"
	elif [ ! -x "$health" ] || ! "$health" bundle >>"$state_dir/compositor-fallback.log" 2>&1; then
		printf '%s\n' "Wayfire was selected but the installed desktop is not Wayfire-ready; falling back to Sway." \
			>>"$state_dir/compositor-fallback.log"
	else
		export XDG_CURRENT_DESKTOP=wayfire
		export XDG_SESSION_DESKTOP=wayfire
		: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
		export XDG_RUNTIME_DIR
		PC_WAYFIRE_READY_FILE="$XDG_RUNTIME_DIR/posterchan-wayfire-ready"
		PC_WAYFIRE_SHELL_PID_FILE="$XDG_RUNTIME_DIR/posterchan-wayfire-shell.pid"
		export PC_WAYFIRE_READY_FILE PC_WAYFIRE_SHELL_PID_FILE
		rm -f "$PC_WAYFIRE_READY_FILE" "$PC_WAYFIRE_SHELL_PID_FILE"
		wayfire -c "${PC_WAYFIRE_CONFIG:-/etc/wayfire.ini}" >"$state_dir/wayfire.log" 2>&1 &
		wayfire_pid=$!
		n=0
		while kill -0 "$wayfire_pid" 2>/dev/null && [ ! -e "$PC_WAYFIRE_READY_FILE" ] && [ "$n" -lt 600 ]; do
			sleep 0.1; n=$((n + 1))
		done
		if [ ! -e "$PC_WAYFIRE_READY_FILE" ] && kill -0 "$wayfire_pid" 2>/dev/null; then
			kill "$wayfire_pid" 2>/dev/null || true
		elif [ -e "$PC_WAYFIRE_READY_FILE" ] && kill -0 "$wayfire_pid" 2>/dev/null; then
			# A shell restart deliberately creates a short gap between the old Electron process and
			# its replacement.  Treating that gap as a compositor failure killed Wayfire, raced the
			# replacement onto the dying socket, then fell the whole login back to Sway.  Supervise
			# the PID file as a replaceable generation: allow the launcher a bounded interval to
			# publish a different live PID while Wayfire itself remains healthy.
			shell_pid=''
			while kill -0 "$wayfire_pid" 2>/dev/null; do
				[ ! -r "$PC_WAYFIRE_SHELL_PID_FILE" ] || IFS= read -r shell_pid <"$PC_WAYFIRE_SHELL_PID_FILE"
				case "$shell_pid" in ''|*[!0-9]*) shell_pid='' ;; esac
				if [ -n "$shell_pid" ] && kill -0 "$shell_pid" 2>/dev/null; then
					while kill -0 "$wayfire_pid" 2>/dev/null && kill -0 "$shell_pid" 2>/dev/null; do sleep 1; done
				fi
				old_pid=$shell_pid n=0 shell_pid=''
				while kill -0 "$wayfire_pid" 2>/dev/null && [ "$n" -lt 30 ]; do
					[ ! -r "$PC_WAYFIRE_SHELL_PID_FILE" ] || IFS= read -r shell_pid <"$PC_WAYFIRE_SHELL_PID_FILE"
					case "$shell_pid" in ''|*[!0-9]*) shell_pid='' ;; esac
					[ -n "$shell_pid" ] && [ "$shell_pid" != "$old_pid" ] && kill -0 "$shell_pid" 2>/dev/null && break
					shell_pid=''; sleep 0.1; n=$((n + 1))
				done
				[ -n "$shell_pid" ] || break
			done
			kill -0 "$wayfire_pid" 2>/dev/null && kill "$wayfire_pid" 2>/dev/null || true
		fi
		wait "$wayfire_pid"
		status=$?
		# Re-read unconditionally: pc-shell-start-wayfire may replace a failed first GPU/surface attempt,
		# so the PID remembered when ready was first observed is not necessarily the final live child.
		if [ -r "$PC_WAYFIRE_SHELL_PID_FILE" ]; then
			IFS= read -r shell_pid <"$PC_WAYFIRE_SHELL_PID_FILE"
			case "$shell_pid" in ''|*[!0-9]*) shell_pid='' ;; esac
		fi
		# Wayfire may exit before Electron notices its display socket disappeared. Starting Sway while
		# that recorded shell is still alive makes pc-shell-start reject itself as a duplicate; the
		# stale process then exits and leaves Sway with no desktop. Reap this session's exact PID first.
		if [ -n "${shell_pid:-}" ] && kill -0 "$shell_pid" 2>/dev/null; then
			kill -TERM "$shell_pid" 2>/dev/null || true
			n=0
			while kill -0 "$shell_pid" 2>/dev/null && [ "$n" -lt 30 ]; do sleep 0.1; n=$((n + 1)); done
			kill -0 "$shell_pid" 2>/dev/null && kill -KILL "$shell_pid" 2>/dev/null || true
		fi
		rm -f "$PC_WAYFIRE_READY_FILE" "$PC_WAYFIRE_SHELL_PID_FILE"
		printf '%s\n' "Wayfire exited with status $status; falling back to Sway for this login." \
			>>"$state_dir/compositor-fallback.log"
	fi
fi

run_sway
