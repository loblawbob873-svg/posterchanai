#!/bin/sh
# Turn the display off after a while, and let somebody change how long.
#
# WHY A SCRIPT AND NOT A LINE IN THE SWAY CONFIG. `swayidle -w timeout 120 …` in sway's config is
# one number compiled into a file that portage owns: changing it means editing a config that
# etc-update replaces on the next upgrade, and there is nowhere for a person to set it from. This
# reads the number from a file anybody can write and restarts the daemon when it changes, so the
# desktop can offer it as a control later without touching the session config again.
#
# NO DIM STAGE, and that is deliberate rather than an omission. Every laptop dims before it blanks,
# and it is the right behaviour -- but dimming needs a backlight control, and the profile
# deliberately does not carry one: app-misc/brightnessctl is not in the Gentoo tree, and the slider
# in the tray works through a udev rule handing the backlight to the `video` group. Wiring a "dim"
# stage that calls something absent would be a stage that silently does nothing, which is worse than
# not claiming it.
#
# `-w` (wait) matters on the resume side: without it swayidle races the compositor and the screen
# can come back before it has been told to, leaving a display that is on and reported off.
set -eu

# Per identity, writable without sudo, and protected by that identity's 0700 home. A setting under
# /etc looked persistent but `pc-idle set` ran as the desktop user and could never create it.
CONF="${PC_IDLE_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/posterchanos/idle}"
DEFAULT=120                       # two minutes, which is what was asked for
HOLD="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/posterchan-keep-awake"

read_secs() {
    s=""
    [ -r "$CONF" ] && s="$(cat "$CONF" 2>/dev/null | tr -dc '0-9')"
    [ -n "$s" ] || s="$DEFAULT"
    # 0 means never, and is a real answer -- somebody watching a film should be able to say it.
    [ "$s" -ge 0 ] 2>/dev/null || s="$DEFAULT"
    echo "$s"
}

case "${1:-run}" in
  hold)
      case "${2:-status}" in
        on)  : >"$HOLD"; pkill -x swayidle 2>/dev/null || true; echo on ;;
        off) rm -f "$HOLD"; pkill -x swayidle 2>/dev/null || true
             setsid "$0" run >/dev/null 2>&1 & echo off ;;
        status) [ -e "$HOLD" ] && echo on || echo off ;;
        *) echo "usage: pc-idle hold on|off|status" >&2; exit 2 ;;
      esac
      ;;
  set)
      # `pc-idle set 300`, or `pc-idle set 0` for never.
      n="$(echo "${2:-}" | tr -dc '0-9')"
      [ -n "$n" ] || { echo "usage: pc-idle set <seconds>   (0 = never)" >&2; exit 2; }
      mkdir -p "$(dirname "$CONF")"
      echo "$n" >"$CONF"
      # Restart the watcher so the new number takes effect now rather than at the next login.
      pkill -x swayidle 2>/dev/null || true
      [ "$n" -gt 0 ] && setsid "$0" run >/dev/null 2>&1 &
      echo "display turns off after ${n}s"
      ;;
  get)
      read_secs
      ;;
  status)
      # WHY IS THE SCREEN STILL ON? Four different causes, three of which leave every other
      # symptom looking perfectly healthy, so guessing between them from the outside does not
      # work -- reported as "my desktop monitor has been on a long time" with a timeout that was
      # set correctly the whole time.
      secs="$(read_secs)"
      if [ "$secs" -eq 0 ] 2>/dev/null; then
          echo "timeout:    never (0) -- pc-idle set 120 to turn the display off again"
      else
          echo "timeout:    ${secs}s"
      fi
      if [ -e "$HOLD" ]; then
          echo "keep-awake: ON -- something asked to hold the screen awake; pc-idle hold off"
      else
          echo "keep-awake: off"
      fi
      if pgrep -x swayidle >/dev/null 2>&1; then
          echo "swayidle:   running (pid $(pgrep -x swayidle | tr '\n' ' ' | sed 's/ $//'))"
      elif [ "$secs" -eq 0 ] 2>/dev/null; then
          echo "swayidle:   not running, which is correct while the timeout is never"
      else
          echo "swayidle:   NOT RUNNING -- nothing is watching, so the display never turns off"
      fi
      # THE CAUSE THAT HIDES FROM EVERY CHECK ABOVE. Sway implements idle-inhibit by never
      # reporting the seat idle at all, so swayidle's timer does not fire late -- it never fires,
      # while the daemon sits there looking healthy and the configured timeout looks right.
      # Chromium takes an inhibitor for any page holding a screen wake lock or playing video (the
      # shell IS Chromium), and sway.config takes one for a fullscreen Steam game on purpose.
      tree="$(swaymsg -t get_tree 2>/dev/null || true)"
      if [ -z "$tree" ]; then
          echo "inhibitors: cannot ask sway (is SWAYSOCK set? run this inside the session)"
      elif ! command -v python3 >/dev/null 2>&1; then
          echo "inhibitors: cannot read the tree without python3"
      else
          printf '%s' "$tree" | python3 -c '
import json, sys
held = []
def walk(n):
    inh = n.get("idle_inhibitors") or {}
    who = [k for k, v in inh.items() if v and v != "none"]
    if who:
        held.append((n.get("app_id") or n.get("window_properties", {}).get("class") or "?",
                     (n.get("name") or "")[:60], ",".join(sorted(who))))
    for k in ("nodes", "floating_nodes"):
        for c in n.get(k) or []:
            walk(c)
try:
    walk(json.load(sys.stdin))
except Exception as exc:
    print("inhibitors: could not parse sway tree (%s)" % exc); raise SystemExit(0)
if not held:
    print("inhibitors: none -- nothing is holding the screen awake")
else:
    print("inhibitors: %d HOLDING THE SCREEN AWAKE" % len(held))
    for app, title, who in held:
        print("              %-24s %s  [%s]" % (app, title, who))
'
      fi
      ;;
  run|*)
      [ ! -e "$HOLD" ] || exit 0
      SECS="$(read_secs)"
      [ "$SECS" -gt 0 ] || exit 0        # never: nothing to run, and no daemon left behind
      # One instance. `exec_always` re-runs this on every sway reload, and two swayidles fight over
      # the same screen -- one turning it off while the other turns it on.
      pkill -x swayidle 2>/dev/null || true
      exec swayidle -w \
          timeout "$SECS" 'swaymsg "output * power off"' \
          resume          'swaymsg "output * power on"'
      ;;
esac
