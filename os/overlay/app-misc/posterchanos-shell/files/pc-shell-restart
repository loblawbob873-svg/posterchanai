#!/bin/sh
# Reload the PosterChan renderer without unmapping the desktop Wayland surface.
set -u
pattern='[/]opt/posterchan/'
if pgrep -f "$pattern" >/dev/null 2>&1; then
  exec swaymsg -t send_tick pc:restart
fi
# No shell exists to receive the recovery tick. The full launcher owns stale-lock cleanup,
# environment recovery, retries, serialization and proof that a replacement surface mapped.
exec /usr/local/bin/pc-shell-start
