#!/bin/sh
# Replace the PosterChan desktop process and load one coherent installed build.
#
# Do not try to infer whether an update happened by comparing /proc/<pid>/exe with the executable
# on disk. Electron itself is commonly byte-identical between PosterChan releases while
# resources/app.asar changed. In that case the executable comparison says "current", a renderer
# reload mixes a new page with the OLD main/preload/protocol code, and only a reboot appears to pick
# up the update. Ctrl+Alt+Backspace is the explicit recovery/restart shortcut, so correctness wins:
# always replace the process. The launcher serializes startup, removes dead singleton locks, and
# proves that the replacement surfaces mapped.
set -u
# The launcher's path, overridable so this script can be RUN by a test rather than read by one.
# The default is absolute on purpose: this is driven from a key binding and from sway, neither of
# which is guaranteed a useful PATH.
if [ -z "${PC_SHELL_START:-}" ]; then
	[ -z "${WAYFIRE_SOCKET:-}" ] && PC_SHELL_START=/usr/local/bin/pc-shell-start || \
		PC_SHELL_START=/usr/local/bin/pc-shell-start-wayfire
fi
# The update acknowledgement supplies the exact process that owns the canonical singleton.  The
# keyboard shortcut has no caller PID, so it discovers candidates, then applies the same strict
# identity check.  Never pattern-kill /opt/posterchan: installed diagnostic instances deliberately
# run that executable too, in a private singleton/compositor domain.
requested=${1:-}
case "$requested" in ''|*[!0-9]*) requested='' ;; esac
[ -n "$requested" ] && candidates=$requested || candidates=$(pgrep -f '[/]opt/posterchan/posterchan-desktop' 2>/dev/null || :)
pids=''
for pid in $candidates; do
	[ -r "/proc/$pid/cmdline" ] || continue
	cmd=$(tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null || :)
	case "$cmd" in
		*--pc-diagnostic-token=*|*--pc-diagnostic-profile=*|*--pc-diagnostic-swaysock=*) continue ;;
	esac
	case "$cmd" in
		/opt/posterchan/posterchan-desktop\ *--shell*) pids="$pids $pid" ;;
		*) [ "${PC_SHELL_TEST_ALLOW_PID:-}" = 1 ] && pids="$pids $pid" ;;
	esac
done

# An explicit PID that is gone or is not the canonical shell is a fail-closed request.  Starting a
# replacement anyway could race a live singleton we intentionally refused to target.
if [ -n "$requested" ] && [ -z "$pids" ]; then
	exit 64
fi

if [ -n "$pids" ]; then
	# SAY THAT THIS IS A RESTART, BEFORE THE SHELL DIES.
	#
	# pc-compositor-session supervises Wayfire by watching for a replacement shell PID and gives it
	# 3 seconds. That is right for a CRASH -- a shell that will never come back should fall the
	# login over to Sway quickly -- and far too short for a restart, because the launcher's own
	# bounded startup (up to 10s waiting for the Xwayland socket, then a health gate of up to 30s)
	# happens inside that window. So Ctrl+Alt+Backspace, and the automatic restart after an update,
	# killed Wayfire and dropped the whole session to Sway: the desktop came back, on the other
	# compositor, with only a line in compositor-fallback.log to say so.
	#
	# The marker is a mtime and nothing else. A restart that dies before the launcher can clear it
	# ages out on its own, so this can extend the supervisor's patience without ever removing the
	# crash fallback it exists for.
	: >"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/posterchan-shell-restarting" 2>/dev/null || true
	# STOP THE LAUNCHER, NOT ONLY THE SHELL -- OR THE OLD LAUNCHER FIGHTS THIS ONE AND BOTH LOSE.
	#
	# pc-shell-start-wayfire does not merely start the shell; it SUPERVISES it, and a shell that
	# exits is a failure it answers by retrying -- twice, and then by giving up for good. Killing
	# only the shell therefore looked, from the launcher still sitting in `wait`, exactly like a
	# crash: it spawned its own replacement, raced this script's replacement for the same singleton
	# and flock, burned both attempts inside a second (measured: two shells one second apart), then
	# printed "failed the Wayfire surface/GPU health gate" and exited. With no launcher left,
	# nothing ever published a replacement PID, so pc-compositor-session stopped Wayfire and the
	# whole login came back on Sway. Ctrl+Alt+Backspace and the post-update restart both did this.
	#
	# The launcher's own TERM trap stops its shell and exits without retrying, so terminating it
	# first is both the stop and the shutdown. The shell is TERMed below anyway: an older launcher,
	# or a shell started by hand, may own no launcher at all.
	launchers=''
	for proc in /proc/[0-9]*; do
		lpid=${proc##*/}
		[ "$lpid" = "$$" ] && continue
		[ -r "$proc/cmdline" ] || continue
		lcmd=$(tr '\000' ' ' < "$proc/cmdline" 2>/dev/null || :)
		case "$lcmd" in
			*pc-shell-start-wayfire*|*pc-shell-start\ *|*pc-shell-start) launchers="$launchers $lpid" ;;
			*) continue ;;
		esac
	done
	[ -z "$launchers" ] || kill $launchers 2>/dev/null || true
	# Stop it and fall through to the full launcher, which owns stale-lock
	# cleanup, environment recovery, retries and the proof that a replacement surface mapped.
	# TERM first and a bounded wait: Electron writes its singleton lock on the way out, and killing
	# it outright leaves the lock for the launcher to clean up as a "dead" one it has to guess about.
	kill $pids 2>/dev/null
	n=0
	while [ "$n" -lt 50 ]; do
		alive=0
		for pid in $pids; do kill -0 "$pid" 2>/dev/null && alive=1; done
		[ "$alive" -eq 1 ] || break
		sleep 0.1
		n=$((n + 1))
	done
	# Only the exact shell processes measured above. A pattern kill can catch a newly launched
	# replacement (or an unrelated command line containing /opt/posterchan) during this window.
	for pid in $pids; do kill -KILL "$pid" 2>/dev/null; done
fi

# No shell exists to receive the recovery tick. The full launcher owns stale-lock cleanup,
# environment recovery, retries, serialization and proof that a replacement surface mapped.
exec "$PC_SHELL_START"
