#!/usr/bin/python3
"""Small fail-closed Wayfire session probe used before the desktop is declared ready."""
import json
import os
import shutil
import socket
import struct
import subprocess
import sys
import tempfile
import time
import zlib


SOCKET = os.environ.get("WAYFIRE_SOCKET", "")
APP_IDS = {"posterchan-desktop", "PosterChan", "place.poster.desktop"}
PRIMARY_MARKER = ((209, 46, 145), (35, 205, 232), (121, 212, 71), (240, 180, 41))
SECONDARY_MARKER = ((75, 92, 255), (255, 92, 53), (155, 219, 77), (246, 213, 92))
MARKER = PRIMARY_MARKER


def request(method, data=None):
    body = json.dumps({"method": method, "data": data or {}}, separators=(",", ":")).encode()
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(2)
        client.connect(SOCKET)
        client.sendall(struct.pack("<I", len(body)) + body)
        raw = b""
        while len(raw) < 4:
            part = client.recv(4 - len(raw))
            if not part:
                raise RuntimeError("Wayfire IPC closed")
            raw += part
        size = struct.unpack("<I", raw)[0]
        raw = b""
        while len(raw) < size:
            part = client.recv(size - len(raw))
            if not part:
                raise RuntimeError("Wayfire IPC closed")
            raw += part
    result = json.loads(raw)
    if isinstance(result, dict) and result.get("error"):
        raise RuntimeError(str(result["error"]))
    return result


def rows(result, key):
    if isinstance(result, list):
        return result
    return result.get(key, []) if isinstance(result, dict) else []


def bundle_preflight():
    asar = os.environ.get("PC_DESKTOP_ASAR", "/opt/posterchan/resources/app.asar")
    with open(asar, "rb") as stream:
        header = stream.read(4 * 1024 * 1024)
    if b'wm-wayfire.js' not in header:
        raise RuntimeError("installed desktop lacks the Wayfire backend")


def preflight():
    bundle_preflight()
    if not SOCKET or not os.path.exists(SOCKET):
        raise RuntimeError("Wayfire IPC socket is unavailable")
    methods = request("list-methods")
    methods = methods.get("methods", []) if isinstance(methods, dict) else []
    required = {"window-rules/list-outputs", "window-rules/list-views",
                "window-rules/configure-view", "window-rules/focus-view"}
    missing = sorted(required - set(methods))
    if missing:
        raise RuntimeError("Wayfire IPC methods missing: " + ", ".join(missing))


def shell_layout(pid):
    outputs = rows(request("window-rules/list-outputs"), "outputs")
    output_ids = {int(row["id"]) for row in outputs if row.get("id") is not None}
    views = rows(request("window-rules/list-views"), "views")
    shells = [row for row in views
              if row.get("mapped", True)
              and str(row.get("app-id") or row.get("app_id") or row.get("app") or "") in APP_IDS
              and "Popup" not in str(row.get("title") or "")]
    if not output_ids or len(shells) != len(output_ids):
        return None
    if any(int(row.get("pid") or 0) != pid for row in shells):
        return None
    owned_outputs = {int(row.get("output-id") if row.get("output-id") is not None
                         else row.get("output_id", -1)) for row in shells}
    if owned_outputs != output_ids:
        return None
    return outputs, shells


def png_rgb(path):
    """Decode the non-interlaced 8-bit RGB/RGBA PNG emitted by grim, without optional Pillow."""
    raw = open(path, "rb").read()
    if raw[:8] != b"\x89PNG\r\n\x1a\n":
        raise RuntimeError("grim did not produce PNG")
    pos, width, height, colour, interlace, packed = 8, 0, 0, 0, 0, bytearray()
    while pos + 12 <= len(raw):
        size = struct.unpack(">I", raw[pos:pos + 4])[0]
        kind, data = raw[pos + 4:pos + 8], raw[pos + 8:pos + 8 + size]
        pos += 12 + size
        if kind == b"IHDR":
            width, height, depth, colour, _, _, interlace = struct.unpack(">IIBBBBB", data)
            if depth != 8 or colour not in (2, 6) or interlace:
                raise RuntimeError("unsupported grim PNG format")
        elif kind == b"IDAT": packed.extend(data)
        elif kind == b"IEND": break
    channels = 3 if colour == 2 else 4
    scan = zlib.decompress(bytes(packed)); stride = width * channels
    rows, offset, prior = [], 0, bytearray(stride)
    for _ in range(height):
        mode, offset = scan[offset], offset + 1
        current = bytearray(scan[offset:offset + stride]); offset += stride
        for x in range(stride):
            left = current[x - channels] if x >= channels else 0
            up = prior[x]; upper_left = prior[x - channels] if x >= channels else 0
            if mode == 1: current[x] = (current[x] + left) & 255
            elif mode == 2: current[x] = (current[x] + up) & 255
            elif mode == 3: current[x] = (current[x] + ((left + up) >> 1)) & 255
            elif mode == 4:
                p = left + up - upper_left
                pa, pb, pc = abs(p-left), abs(p-up), abs(p-upper_left)
                current[x] = (current[x] + (left if pa <= pb and pa <= pc else up if pb <= pc else upper_left)) & 255
            elif mode != 0: raise RuntimeError("unsupported PNG filter")
        rows.append(current); prior = current
    return width, height, channels, rows


def has_marker(path, colours=PRIMARY_MARKER):
    width, height, channels, rows = png_rgb(path)
    if width < 8 or height < 8:
        return False
    # The marker is at the shell's output-local top-left. Search a bounded corner because fractional
    # scaling can move/duplicate its pixels, but never accept a matching app image elsewhere.
    pixels = [tuple(row[x:x + 3]) for row in rows[:min(height, 96)]
              for x in range(0, min(width, 96) * channels, channels)
              if channels == 3 or row[x + 3] >= 240]
    return all(any(max(abs(pixel[i] - wanted[i]) for i in range(3)) <= 12
                   for pixel in pixels) for wanted in colours)


def rendered(outputs, shells):
    grim = os.environ.get("PC_GRIM", "grim")
    capture_timeout = float(os.environ.get("PC_GRIM_TIMEOUT", "10"))
    with tempfile.TemporaryDirectory(prefix="pc-wayfire-health-") as directory:
        # Damage BEFORE asking grim for a frame. Starting grim first raced the compositor: it could
        # complete from its cached pre-hydration buffer before the focus/cursor damage below, making
        # DP-2 fail even though an immediate ordinary screenshot contained its exact marker.
        for shell in shells:
            try:
                request("window-rules/focus-view", {"id": int(shell["id"])})
            except (KeyError, OSError, RuntimeError, ValueError):
                pass
        try:
            input_env = dict(os.environ)
            runtime = input_env.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
            input_env.setdefault("YDOTOOL_SOCKET", os.path.join(runtime, ".ydotool_socket"))
            tool = os.environ.get("PC_YDOTOOL", "ydotool")
            for delta in ("1", "-1"):
                subprocess.run([tool, "mousemove", "--", delta, "0"], stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=1, env=input_env)
        except (OSError, subprocess.TimeoutExpired):
            pass
        time.sleep(0.08)
        captures = []
        # Capture outputs concurrently so one stalled wlroots frame cannot consume the full startup
        # allowance once per monitor.
        for output in outputs:
            name = str(output.get("name") or "")
            if not name:
                raise RuntimeError("Wayfire output has no capture name")
            target = os.path.join(directory, str(output.get("id")) + ".png")
            capture = subprocess.Popen([grim, "-o", name, target], stdout=subprocess.DEVNULL,
                                       stderr=subprocess.PIPE)
            captures.append((name, target, capture))
        by_output = {int(shell.get("output-id") if shell.get("output-id") is not None
                         else shell.get("output_id", -1)): shell for shell in shells}
        # Match shell-displays' deterministic fallback: focused output, then top-left output.
        # View ids are compositor timing artifacts and can reverse across boots.
        primary_output = next((row for row in outputs if row.get("focused")), None)
        if primary_output is None:
            primary_output = min(outputs, key=lambda row: (
                int((row.get("geometry") or {}).get("x", 0)),
                int((row.get("geometry") or {}).get("y", 0)), str(row.get("name", ""))))
        for name, target, capture in captures:
            try:
                _, error = capture.communicate(timeout=capture_timeout)
            except subprocess.TimeoutExpired:
                capture.kill(); capture.communicate()
                print(f"pc-wayfire-health: {name} capture timed out", file=sys.stderr)
                return False
            output = next(row for row in outputs if str(row.get("name")) == name)
            shell = by_output.get(int(output.get("id")))
            colours = PRIMARY_MARKER if output is primary_output else SECONDARY_MARKER
            if capture.returncode or not os.path.isfile(target) or not has_marker(target, colours):
                preserved = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                                         "posterchan-health-" + name + ".png")
                if os.path.isfile(target): shutil.copyfile(target, preserved)
                print(f"pc-wayfire-health: {name} view={shell and shell.get('id')} marker="
                      f"{'primary' if colours is PRIMARY_MARKER else 'secondary'} absent; capture={preserved}",
                      file=sys.stderr)
                return False
    return True


def healthy(pid):
    layout = shell_layout(pid)
    return bool(layout and rendered(layout[0], layout[1]))


def process_alive(pid):
    os.kill(pid, 0)
    try:
        # kill(2) still succeeds for an unreaped child. Treating that zombie as alive made a GPU
        # startup crash consume the entire health timeout before the clean retry could begin.
        stat = open(f"/proc/{pid}/stat", encoding="ascii").read()
        end = stat.rfind(")")
        return end >= 0 and stat[end + 2:end + 3] != "Z"
    except FileNotFoundError:
        return False
    except OSError:
        return True


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "preflight"
    if mode == "bundle":
        bundle_preflight()
        return 0
    if mode == "preflight":
        preflight()
        return 0
    if mode != "wait" or len(sys.argv) < 3:
        raise RuntimeError("usage: pc-wayfire-health preflight | wait PID [SECONDS]")
    pid = int(sys.argv[2])
    timeout = float(sys.argv[3]) if len(sys.argv) > 3 else 30.0
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        try:
            if not process_alive(pid):
                break
            if healthy(pid):
                return 0
        except ProcessLookupError:
            break
        except (OSError, RuntimeError, ValueError):
            pass
        time.sleep(0.1)
    raise RuntimeError("desktop did not render exactly one verified shell surface on every output")


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as error:
        print(f"pc-wayfire-health: {error}", file=sys.stderr)
        raise SystemExit(1)
