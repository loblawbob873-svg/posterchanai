#!/bin/bash
# pc-anticheat -- Secure Boot ("anti-cheat") mode for System Settings and the installer, as root.
#
#   pc-anticheat status     JSON: what state the machine is in (anyone may ask; sudoers allows it)
#   pc-anticheat setup      ask for it: the posterchan-anticheat service runs `gentoo.sh anticheat`
#   pc-anticheat undo       take it away again (`gentoo.sh anticheat-off`), in the background
#   pc-anticheat run        the service's own step -- never called by hand
#   pc-anticheat run-off    the undo's own step -- never called by hand
#
# WHY A SERVICE AND A ONE-TIME PASSWORD. `gentoo.sh anticheat` downloads ~600 MB (shim, mokutil, the Gentoo-signed
# kernel image) and queues Gentoo's key for MOK enrolment, which a person confirms at the next boot in MokManager with
# a password chosen now. A desktop has no terminal to type it into, so the password is made here -- eight digits, one
# use, only ever typed into MokManager at the machine itself -- and handed to mokutil as a hash (PC_MOK_PASSWORD,
# gentoo.sh). System Settings shows it until the enrolment is done. Asked for by the graphical installer the same way:
# the install leaves /etc/posterchan/anticheat-requested and the service is enabled, so the first boot does it.
set -u
STATE_DIR="${PC_AC_STATE_DIR:-/var/lib/posterchan}"
STATE="$STATE_DIR/anticheat.json"
LOG="$STATE_DIR/anticheat.log"
REQUEST="${PC_AC_ROOT:-}/etc/posterchan/anticheat-requested"
MARKER="${PC_AC_ROOT:-}/etc/posterchan/anticheat"
GENTOO_SH="${PC_GENTOO_SH:-/usr/bin/gentoo.sh}"
UNIT=posterchan-anticheat.service

json() {   # json <state> [password] -- the one writer of the state file (python3 does the escaping)
	mkdir -p "$STATE_DIR"
	python3 - "$STATE" "$1" "${2:-}" "$LOG" <<'PY'
import json, os, sys, time
path, state, pw, log = sys.argv[1:5]
tail = ""
if state == "failed":
    try:
        tail = "".join(open(log, errors="replace").readlines()[-25:])
    except OSError:
        pass
doc = {"state": state, "at": int(time.time())}
if pw:
    doc["password"] = pw
if tail:
    doc["log"] = tail
tmp = path + ".new"
with open(tmp, "w") as f:
    json.dump(doc, f)
os.chmod(tmp, 0o600)   # it can hold the one-time MokManager code; status is read through sudo
os.replace(tmp, path)
PY
}

case "${1:-}" in
status)
	python3 - "$STATE" "$REQUEST" "$MARKER" <<'PY'
import json, os, subprocess, sys
path, request, marker = sys.argv[1:4]
try:
    doc = json.load(open(path))
except (OSError, ValueError):
    doc = {}
sb = "unknown"
try:
    out = subprocess.run(["mokutil", "--sb-state"], capture_output=True, text=True, timeout=10).stdout.lower()
    sb = "enabled" if "enabled" in out else "disabled" if "disabled" in out else "unknown"
except (OSError, subprocess.SubprocessError):
    pass
nvidia = False
for d in os.listdir("/sys/bus/pci/devices") if os.path.isdir("/sys/bus/pci/devices") else []:
    try:
        v = open(f"/sys/bus/pci/devices/{d}/vendor").read().strip()
        c = open(f"/sys/bus/pci/devices/{d}/class").read().strip()
        nvidia = nvidia or (v == "0x10de" and c.startswith("0x03"))
    except OSError:
        pass
state = doc.get("state") or ("enabled" if os.path.exists(marker) else "off")
if state == "enrol" and sb == "enabled":
    state = "enabled"            # the key was enrolled and Secure Boot is on: nothing left to tell the person
out = {"state": state, "requested": os.path.exists(request), "installed": os.path.exists(marker),
       "secureBoot": sb, "nvidia": nvidia}
if state == "enrol" and doc.get("password"):
    out["password"] = doc["password"]
if state == "failed" and doc.get("log"):
    out["log"] = doc["log"]
print(json.dumps(out))
PY
	;;
setup)
	mkdir -p "$(dirname "$REQUEST")" && : >"$REQUEST" || exit 1
	json requested
	systemctl start --no-block "$UNIT"
	;;
undo)
	json undoing
	systemd-run --quiet --no-block --unit=posterchan-anticheat-off --collect "$0" run-off
	;;
run)
	[ -e "$REQUEST" ] || exit 0
	json running
	pw="$(od -An -N8 -tu1 /dev/urandom | tr -s ' ' '\n' | grep -v '^$' | awk '{printf "%d", $1 % 10}')"
	if PC_MOK_PASSWORD="$pw" "$GENTOO_SH" anticheat >"$LOG" 2>&1; then
		rm -f "$REQUEST"
		json enrol "$pw"
	else
		json failed
		exit 1
	fi
	;;
run-off)
	if "$GENTOO_SH" anticheat-off >"$LOG" 2>&1; then
		rm -f "$REQUEST"
		json off
	else
		json failed
		exit 1
	fi
	;;
*)
	echo "usage: pc-anticheat status|setup|undo" >&2
	exit 2
	;;
esac
