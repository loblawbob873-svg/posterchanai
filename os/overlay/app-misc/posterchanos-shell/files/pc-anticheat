#!/bin/bash
# pc-anticheat -- Secure Boot ("anti-cheat") mode for System Settings and the installer, as root.
#
#   pc-anticheat status     JSON: what state the machine is in (anyone may ask; sudoers allows it)
#   pc-anticheat setup      ask for it: the posterchan-anticheat service runs `gentoo.sh anticheat`
#   pc-anticheat undo       take it away again (`gentoo.sh anticheat-off`), in the background
#   pc-anticheat run        the service's own step -- never called by hand
#   pc-anticheat run-off    the undo's own step -- never called by hand
#   pc-anticheat tpm        every boot (posterchan-anticheat-tpm.service): automatic TPM unlock under Secure Boot
#   pc-anticheat travel on|off   TRAVEL MODE: ask for the disk password at every start
#
# TRAVEL MODE ("If you travel, you will want a password to unlock", 2026-10-29). Turning only the TPM unlock off would
# protect nothing: the auto-unlock key file sits on the UNENCRYPTED boot partition and inside the startup images there.
# So `travel on` takes it out of all three places -- the TPM slot is wiped, the key file is moved into the encrypted
# root (/etc/posterchan/travel/, 0700/0400) and the startup images are rebuilt without it -- and every boot entry asks
# for the password. `travel off` puts the key file back, rebuilds the images and re-seals the TPM; nothing to type,
# since whoever turns it off is already signed in. The LUKS key slot the key file opens is never removed.
#
# THE DISK UNLOCKS BY ITSELF UNDER SECURE BOOT TOO ("tpm unlock should be automatic and part of the Secure Boot
# System Settings", 2026-10-29). Gentoo's signed kernel image cannot carry this machine's key file, so with Secure Boot
# on it asked for the disk password. On a boot WITH Secure Boot on and a TPM present, `tpm` adds a TPM2 key slot sealed
# to PCR 7 (the Secure Boot state), unlocked with the existing key file (/boot/keyfile.key) -- nothing to type, and the
# key file and the normal boot entry stay exactly as they were. The PCR 7 value it was sealed against is kept; when it
# changes (a key enrolled, firmware settings) that boot asks for the password once and this re-seals, wiping the old
# TPM slot. Sealing while Secure Boot is OFF would seal the wrong value, so it waits for a Secure Boot boot.
#
# WHY A SERVICE AND A ONE-TIME PASSWORD. `gentoo.sh anticheat` downloads ~600 MB (shim, mokutil, the Gentoo-signed
# kernel image) and queues Gentoo's key for MOK enrolment, which a person confirms at the next boot in MokManager with
# a password chosen now. A desktop has no terminal to type it into, so the password is made here -- eight digits, one
# use, only ever typed into MokManager at the machine itself -- and handed to mokutil as a hash (PC_MOK_PASSWORD,
# gentoo.sh). System Settings shows it until the enrolment is done. Asked for by the graphical installer the same way:
# the install leaves /etc/posterchan/anticheat-requested and the service is enabled, so the first boot does it.
set -u
STATE_DIR="${PC_AC_STATE_DIR:-/var/lib/posterchan}"
STATE="$STATE_DIR/anticheat.json"
LOG="$STATE_DIR/anticheat.log"
REQUEST="${PC_AC_ROOT:-}/etc/posterchan/anticheat-requested"
MARKER="${PC_AC_ROOT:-}/etc/posterchan/anticheat"
GENTOO_SH="${PC_GENTOO_SH:-/usr/bin/gentoo.sh}"
UNIT=posterchan-anticheat.service
TPMSTATE="$STATE_DIR/anticheat-tpm.json"
KEYFILE="${PC_AC_KEYFILE:-/boot/keyfile.key}"
TPMDEV="${PC_AC_TPM:-/sys/class/tpm/tpm0}"
TRAVEL="${PC_AC_ROOT:-}/etc/posterchan/travel"
DRACUT_CONF="${PC_AC_ROOT:-}/etc/dracut.conf"
ESP_DIR="${PC_AC_ESP:-/boot}"

rootdev() {   # the LUKS device the root file system is on
	local src; src="$(findmnt -no SOURCE / 2>/dev/null | sed 's/\[.*//')"
	cryptsetup status "${src##*/}" 2>/dev/null | awk '$1 == "device:" {print $2}'
}
rebuild_initrds() {   # every startup image of this machine, with the dracut.conf as it now stands
	# EVERY image on the boot partition, not only those with an entry: an old kernel's directory outlives its entry
	# and still held the key on the laptop (6.18.43/.48, 2026-10-29). One whose kernel is gone cannot be rebuilt and
	# boots nothing; with the key going away ("$1" = strip) it is deleted, otherwise left alone.
	local mid img kver n=0
	mid="$(cat "${PC_AC_ROOT:-}/etc/machine-id" 2>/dev/null)"
	for img in "$ESP_DIR/$mid"/*/initrd; do
		[ -n "$mid" ] && [ -f "$img" ] || continue
		kver="$(basename "$(dirname "$img")")"
		if [ -d "${PC_AC_ROOT:-}/usr/lib/modules/$kver" ] || [ -d "${PC_AC_ROOT:-}/lib/modules/$kver" ]; then
			dracut --force --quiet --add " crypt systemd-cryptsetup dm rootfs-block " "$img" "$kver" || return 1
			n=$((n + 1))
		elif [ "${1:-}" = strip ]; then
			rm -f "$img" || return 1
		fi
	done
	[ "$n" -gt 0 ]
}

json() {   # json <state> [password] -- the one writer of the state file (python3 does the escaping)
	mkdir -p "$STATE_DIR"
	python3 - "$STATE" "$1" "${2:-}" "$LOG" <<'PY'
import json, os, sys, time
path, state, pw, log = sys.argv[1:5]
tail = ""
if state == "failed":
    try:
        tail = "".join(open(log, errors="replace").readlines()[-25:])
    except OSError:
        pass
doc = {"state": state, "at": int(time.time())}
if pw:
    doc["password"] = pw
if tail:
    doc["log"] = tail
tmp = path + ".new"
with open(tmp, "w") as f:
    json.dump(doc, f)
os.chmod(tmp, 0o600)   # it can hold the one-time MokManager code; status is read through sudo
os.replace(tmp, path)
PY
}

case "${1:-}" in
status)
	python3 - "$STATE" "$REQUEST" "$MARKER" <<'PY'
import json, os, subprocess, sys
path, request, marker = sys.argv[1:4]
try:
    doc = json.load(open(path))
except (OSError, ValueError):
    doc = {}
sb = "unknown"
try:
    out = subprocess.run(["mokutil", "--sb-state"], capture_output=True, text=True, timeout=10).stdout.lower()
    sb = "enabled" if "enabled" in out else "disabled" if "disabled" in out else "unknown"
except (OSError, subprocess.SubprocessError):
    pass
nvidia = False
for d in os.listdir("/sys/bus/pci/devices") if os.path.isdir("/sys/bus/pci/devices") else []:
    try:
        v = open(f"/sys/bus/pci/devices/{d}/vendor").read().strip()
        c = open(f"/sys/bus/pci/devices/{d}/class").read().strip()
        nvidia = nvidia or (v == "0x10de" and c.startswith("0x03"))
    except OSError:
        pass
state = doc.get("state") or ("enabled" if os.path.exists(marker) else "off")
if state == "enrol" and sb == "enabled":
    state = "enabled"            # the key was enrolled and Secure Boot is on: nothing left to tell the person
out = {"state": state, "requested": os.path.exists(request), "installed": os.path.exists(marker),
       "secureBoot": sb, "nvidia": nvidia}
if state == "enrol" and doc.get("password"):
    out["password"] = doc["password"]
if state == "failed" and doc.get("log"):
    out["log"] = doc["log"]
try:
    out["tpm"] = json.load(open(os.path.join(os.path.dirname(path), "anticheat-tpm.json"))).get("state", "")
except (OSError, ValueError):
    out["tpm"] = ""
out["travel"] = os.path.exists(os.path.join(os.path.dirname(marker), "travel", "on"))
if not out["tpm"]:
    out["tpm"] = "absent" if not os.path.exists("/sys/class/tpm/tpm0") else "waiting"
print(json.dumps(out))
PY
	;;
setup)
	mkdir -p "$(dirname "$REQUEST")" && : >"$REQUEST" || exit 1
	json requested
	systemctl start --no-block "$UNIT"
	;;
undo)
	json undoing
	systemd-run --quiet --no-block --unit=posterchan-anticheat-off --collect "$0" run-off
	;;
run)
	[ -e "$REQUEST" ] || exit 0
	json running
	pw="$(od -An -N8 -tu1 /dev/urandom | tr -s ' ' '\n' | grep -v '^$' | awk '{printf "%d", $1 % 10}')"
	if PC_MOK_PASSWORD="$pw" "$GENTOO_SH" anticheat >"$LOG" 2>&1; then
		rm -f "$REQUEST"
		json enrol "$pw"
	else
		json failed
		exit 1
	fi
	;;
run-off)
	if "$GENTOO_SH" anticheat-off >"$LOG" 2>&1; then
		rm -f "$REQUEST"
		# The TPM unlock belongs to Secure Boot mode: off, its key slot goes too (the key file still opens the disk).
		dev="$(rootdev)"
		if [ -n "$dev" ] && [ -s "$KEYFILE" ] && systemd-cryptenroll "$dev" 2>/dev/null | grep -q tpm2; then
			systemd-cryptenroll "$dev" --unlock-key-file="$KEYFILE" --wipe-slot=tpm2 >>"$LOG" 2>&1 || true
		fi
		rm -f "$TPMSTATE" "$STATE_DIR/anticheat-tpm.pcr7"
		json off
	else
		json failed
		exit 1
	fi
	;;
tpm)
	[ -e "$MARKER" ] || exit 0
	if [ -e "$TRAVEL/on" ]; then printf '{"state": "travel", "at": %s}\n' "$(date +%s)" >"$TPMSTATE"; exit 0; fi
	tpmsay() { mkdir -p "$STATE_DIR"; printf '{"state": "%s", "at": %s}\n' "$1" "$(date +%s)" >"$TPMSTATE"; chmod 0644 "$TPMSTATE"; }
	mokutil --sb-state 2>/dev/null | grep -qi "SecureBoot enabled" || { tpmsay waiting; exit 0; }
	[ -e "$TPMDEV" ] || { tpmsay absent; exit 0; }
	[ -s "$KEYFILE" ] || { tpmsay nokey; exit 0; }
	# systemd without its TPM support (Gentoo's prebuilt one): rebuild it ONCE, in the background, then come back here.
	# Read from the feature list: `--tpm2-device=list` HANGS on a build without TPM support (measured).
	if ! systemd-cryptenroll --version 2>/dev/null | grep -q -- '+TPM2'; then
		if [ ! -e "$STATE_DIR/anticheat-tpm.building" ]; then
			: >"$STATE_DIR/anticheat-tpm.building"
			systemd-run --quiet --no-block --unit=posterchan-anticheat-tpm-support --collect /bin/sh -c \
				"'$GENTOO_SH' anticheat-tpm >'$STATE_DIR/anticheat-tpm.log' 2>&1; rm -f '$STATE_DIR/anticheat-tpm.building'; '$0' tpm"
		fi
		tpmsay building; exit 0
	fi
	src="$(findmnt -no SOURCE / 2>/dev/null | sed 's/\[.*//')"
	dev="$(cryptsetup status "${src##*/}" 2>/dev/null | awk '$1 == "device:" {print $2}')"
	[ -n "$dev" ] || { tpmsay failed; echo "pc-anticheat tpm: the root is not on a LUKS device ($src)" >&2; exit 1; }
	pcr="$(cat "$TPMDEV/pcr-sha256/7" 2>/dev/null)"
	# The record is "v2 <PCR 7>": a v1 seal (bare PCR value) was ALSO bound to the signed kernel image's RSA-4096 key
	# (systemd-cryptenroll picks the image's .pcrpkey up by itself), which the laptop's TPM refuses to load -- it asked
	# for the password at every start (2026-10-29). A v1 record therefore never matches, and the slot is sealed again.
	if systemd-cryptenroll "$dev" 2>/dev/null | grep -q tpm2 && [ -n "$pcr" ] \
		&& [ "v2 $pcr" = "$(cat "$STATE_DIR/anticheat-tpm.pcr7" 2>/dev/null)" ]; then
		tpmsay on; exit 0
	fi
	# PCR 7 only (`--tpm2-public-key=` turns the image key off), then PROVE the TPM opens it before saying "on".
	if systemd-cryptenroll "$dev" --unlock-key-file="$KEYFILE" --wipe-slot=tpm2 --tpm2-device=auto --tpm2-pcrs=7 --tpm2-public-key= \
		&& cryptsetup open --test-passphrase --token-only --token-type systemd-tpm2 "$dev"; then
		[ -n "$pcr" ] && printf 'v2 %s\n' "$pcr" >"$STATE_DIR/anticheat-tpm.pcr7"
		tpmsay on
	else
		tpmsay failed; exit 1
	fi
	;;
travel)
	case "${2:-}" in
	on)
		[ -e "$TRAVEL/on" ] && exit 0
		dev="$(rootdev)"; [ -n "$dev" ] || { echo "travel mode: the root is not on a LUKS device" >&2; exit 1; }
		[ -s "$KEYFILE" ] || { echo "travel mode: there is no key file at $KEYFILE to put away" >&2; exit 1; }
		mkdir -p "$TRAVEL" && chmod 0700 "$TRAVEL" || exit 1
		cp -a "$KEYFILE" "$TRAVEL/keyfile.key" && chmod 0400 "$TRAVEL/keyfile.key" && cmp -s "$KEYFILE" "$TRAVEL/keyfile.key" || exit 1
		# The images first (the step that can fail on its own), so a failure leaves everything as it was.
		sed -i 's|^\(install_items+=.*/boot/keyfile.key.*\)$|# travel mode: \1|' "$DRACUT_CONF"
		undo_images() { sed -i 's|^# travel mode: ||' "$DRACUT_CONF"; rebuild_initrds; }
		rebuild_initrds strip || { undo_images; echo "travel mode: the startup images could not be rebuilt -- nothing was changed" >&2; exit 1; }
		if systemd-cryptenroll "$dev" 2>/dev/null | grep -q tpm2; then
			systemd-cryptenroll "$dev" --unlock-key-file="$TRAVEL/keyfile.key" --wipe-slot=tpm2 \
				|| { undo_images; echo "travel mode: the TPM key could not be removed -- nothing was changed" >&2; exit 1; }
		fi
		: >"$TRAVEL/on"
		rm -f "$STATE_DIR/anticheat-tpm.pcr7" "$KEYFILE"
		printf '{"state": "travel", "at": %s}\n' "$(date +%s)" >"$TPMSTATE"
		;;
	off)
		[ -e "$TRAVEL/on" ] || exit 0
		[ -s "$TRAVEL/keyfile.key" ] || { echo "travel mode: the kept key file is missing" >&2; exit 1; }
		cp -a "$TRAVEL/keyfile.key" "$KEYFILE" && chmod 0400 "$KEYFILE" || exit 1
		sed -i 's|^# travel mode: ||' "$DRACUT_CONF"
		rebuild_initrds || { echo "travel mode: the startup images could not be rebuilt" >&2; exit 1; }
		rm -f "$TRAVEL/on" "$TPMSTATE" "$TRAVEL/keyfile.key"
		"$0" tpm || true      # re-seal now when Secure Boot is on; otherwise at the next Secure Boot start
		;;
	*) echo "usage: pc-anticheat travel on|off" >&2; exit 2 ;;
	esac
	;;
*)
	echo "usage: pc-anticheat status|setup|undo|tpm|travel on|off" >&2
	exit 2
	;;
esac
