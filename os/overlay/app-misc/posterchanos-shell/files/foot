#!/bin/sh
# PosterChanOS Foot defaults for streaming terminal UIs.
#
# Codex, Claude and similar TUIs repaint by issuing several small writes.  The stock 0.5 ms lower
# delay can expose the cleared intermediate frame as a flash.  Foot documents these two knobs as
# its compatibility path for non-atomic screen updates.  Both values remain below one 60 Hz frame,
# so interactive input is not made visibly sluggish.  Explicit options supplied by the user come
# later and therefore still override the OS defaults.
#
# AND THE DESKTOP'S COLOURS, UNLESS THE PERSON HAS CHOSEN THEIR OWN. Reported as "foot ... window
# color has a different color from the rest of the desktop": stock foot is #242424 on a #0a0a0f
# desktop (measured in a headless session). These are the client's `--bg`/`--text`/accent tokens,
# held to client.css by tests/test_native_windows_match_the_desktop.py. An `-o` beats foot.ini, so
# they are only passed when there is no foot.ini of the person's own -- a configured terminal is
# left exactly as configured.
config="${XDG_CONFIG_HOME:-$HOME/.config}/foot/foot.ini"
if [ ! -e "$config" ]; then
	set -- \
		-o colors.background=0a0a0f \
		-o colors.foreground=edeefa \
		-o colors.selection-background=1e525f \
		-o colors.selection-foreground=edeefa \
		-o colors.cursor="0a0a0f 3ce8ff" \
		"$@"
fi
exec /usr/bin/foot \
  -o tweak.delayed-render-lower=2000000 \
  -o tweak.delayed-render-upper=12000000 \
  "$@"
