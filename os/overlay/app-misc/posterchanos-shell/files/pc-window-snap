#!/usr/bin/python3
"""Act on the focused Sway window without wrapping it in an HTML frame.

Snapping, moving between outputs and CLOSING all need the same first question — is the focused
container a native application, a popped-out PosterChan window, or the shell surface that draws the
whole desktop? — and answering it wrongly costs the same thing every time. That question is answered
once, here, rather than copied into a second helper: this package has already shipped two copies of
one script that drifted apart.
"""
import json
import os
import socket
import struct
import subprocess
import sys


def sway(*args):
    return subprocess.check_output(["swaymsg", *args], text=True)


def wayfire(method, data=None):
    body = json.dumps({"method": method, "data": data or {}}).encode()
    with socket.socket(socket.AF_UNIX) as client:
        client.connect(os.environ["WAYFIRE_SOCKET"])
        client.sendall(struct.pack("<I", len(body)) + body)
        head = client.recv(4)
        if len(head) != 4:
            raise RuntimeError("Wayfire IPC closed")
        size = struct.unpack("<I", head)[0]; reply = b""
        while len(reply) < size:
            reply += client.recv(size - len(reply))
    result = json.loads(reply)
    if isinstance(result, dict) and result.get("error"):
        raise RuntimeError(result["error"])
    return result


def shell_action(payload):
    subprocess.check_call(["/usr/local/bin/pc-wayfire-action", payload],
                          stdout=subprocess.DEVNULL)


def wayfire_main(side):
    views = wayfire("window-rules/list-views")
    win = next((v for v in views if v.get("mapped", True) and v.get("activated")), None)
    if not win:
        return
    app = str(win.get("app-id") or "").lower()
    title = str(win.get("title") or "")
    shell = app in ("posterchan", "posterchan-desktop", "place.poster.desktop") and not title.startswith("PosterChan Window")
    if shell:
        actions = {"close": "pc:close", "minimise": "pc:minimise", "left": "pc:snap:left",
                   "right": "pc:snap:right", "max": "pc:snap:max"}
        if side in actions:
            shell_action(actions[side])
        elif side.startswith("move-"):
            shell_action("pc:move-output:" + side[5:])
        return
    view_id = int(win["id"])
    if side == "close":
        wayfire("window-rules/close-view", {"id": view_id}); return
    if side == "minimise":
        wayfire("wm-actions/set-minimized", {"view_id": view_id, "state": True}); return
    if side.startswith("move-") and not title.startswith("PosterChan Window"):
        shell_action(f"pc:move-native:{view_id}:{side[5:]}"); return
    if side.startswith("move-"):
        return
    outputs = wayfire("window-rules/list-outputs")
    out = next((o for o in outputs if int(o.get("id", -1)) == int(win.get("output-id", -2))), None)
    if not out:
        return
    box = out.get("workarea") or out.get("geometry") or {}
    width, height = int(box.get("width", 1)), max(1, int(box.get("height", 1)) - 72)
    current = win.get("geometry") or {}
    if side == "edge":
        x, y = int(current.get("x", 0)), int(current.get("y", 0))
        w, h = int(current.get("width", 0)), int(current.get("height", 0))
        top, bottom, left, right = y <= 60, y + h >= height - 28, x <= 28, x + w >= width - 28
        if top and left: side = "top-left"
        elif top and right: side = "top-right"
        elif bottom and left: side = "bottom-left"
        elif bottom and right: side = "bottom-right"
        elif top: side = "max"
        elif left: side = "left"
        elif right: side = "right"
        else: return
    x = y = 0
    if side == "max": w, h = width, height
    elif side in ("top-left", "top-right", "bottom-left", "bottom-right"):
        w, h = width // 2, height // 2
        if side.endswith("right"): x = width - w
        if side.startswith("bottom"): y = height - h
    elif side in ("left", "right"):
        w, h = width // 2, height
        if side == "right": x = width - w
    else: return
    wayfire("window-rules/configure-view", {"id": view_id, "output_id": int(out["id"]),
        "geometry": {"x": x, "y": y, "width": w, "height": h}})


def focused(node, output=None):
    if node.get("type") == "output":
        output = node
    if node.get("focused") and node.get("type") in ("con", "floating_con"):
        return node, output
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        hit = focused(child, output)
        if hit:
            return hit
    return None


def process_chain(pid):
    """Yield command lines for a process and its parents without trusting Wayland app_id.

    Electron surfaces have not kept one stable app_id across Wayland/XWayland and package
    upgrades.  The compositor must never resize PosterChan's per-output shell surface: doing so
    makes a laptop viewport narrow enough that the web desktop correctly falls back to Classic.
    The renderer's ancestry, unlike its optional surface metadata, always reaches the packaged
    posterchan-desktop main process.
    """
    seen = set()
    while pid and pid not in seen:
        seen.add(pid)
        try:
            raw = open(f"/proc/{pid}/cmdline", "rb").read().replace(b"\0", b" ")
            yield raw.decode("utf-8", "replace")
            with open(f"/proc/{pid}/stat", "r", encoding="utf-8") as handle:
                stat = handle.read()
            # comm is parenthesised but may itself contain spaces and `)`.  Only the final closing
            # parenthesis is structural; after it the first field is state and the second is ppid.
            end = stat.rfind(")")
            if end < 0:
                return
            fields = stat[end + 1:].split()
            pid = int(fields[1])
        except (OSError, ValueError, IndexError):
            return


def is_popped_out_window(win):
    """A PosterChan window that is its OWN Sway toplevel, not the per-output desktop surface.

    Popped-out windows became real compositor toplevels, and they carry the SAME app_id as the
    desktop that opened them — so `is_posterchan_shell` claimed them and this helper forwarded the
    keypress back to the renderer, which then looked for an in-page window to snap and found none.
    Reported as "posterchan windows are not moveable on sway now with keyboard": the window was a
    perfectly ordinary floating container Sway could have moved all along.

    The discriminator is the TITLE, and deliberately the same one sway.config's own float rule uses
    (`title="^PosterChan Window"`) — two rules disagreeing about what a window is would be the same
    bug again, one layer down."""
    if not str(win.get("app_id") or "").lower() in (
            "posterchan", "posterchan-desktop", "place.poster.desktop"):
        if not any("posterchan-desktop" in cmd.lower() for cmd in process_chain(win.get("pid"))):
            return False
    return str(win.get("name") or "").startswith("PosterChan Window")


def is_posterchan_shell(win):
    # A popped-out window is Sway's to move, exactly like any other floating container.
    if is_popped_out_window(win):
        return False
    app = str(win.get("app_id") or "").lower()
    # Electron 44's registered Wayland identity is the reverse-DNS package name. During startup or
    # compositor recovery pid metadata can still be absent, so ancestry is not a usable fallback.
    # Treat every identity accepted by the renderer/main shell lookup as the same protected surface;
    # resizing one here halves an entire monitor instead of the focused PosterChan window inside it.
    if app in ("posterchan", "posterchan-desktop", "place.poster.desktop"):
        return True
    return any("posterchan-desktop" in cmd.lower() for cmd in process_chain(win.get("pid")))


def main():
    side = sys.argv[1] if len(sys.argv) > 1 else ""
    moves = {"move-left": "left", "move-right": "right",
             "move-up": "up", "move-down": "down"}
    if side not in ("left", "right", "max", "edge", "close", "minimise", *moves):
        raise SystemExit(
            "usage: pc-window-snap left|right|max|edge|close|minimise"
            "|move-left|move-right|move-up|move-down")
    if os.environ.get("WAYFIRE_SOCKET"):
        wayfire_main(side)
        return
    hit = focused(json.loads(sway("-t", "get_tree", "-r")))
    if not hit:
        return
    win, out = hit
    if not out:
        return
    # Sway owns Super+Arrow before Chromium can see it.  Native applications can be resized here,
    # but PosterChan windows live inside the one shell surface; resizing that surface both misses
    # the focused in-app window and can force the whole UI into its narrow/classic layout.  Route
    # the same physical key back to the shell so its ordinary snapTo() path handles the focused
    # PosterChan window.
    if is_posterchan_shell(win):
        if side == "minimise":
            sway("-t", "send_tick", "pc:minimise")
            return
        if side == "close":
            # NEVER `kill` HERE. This container is the desktop: one surface hosting every PosterChan
            # window, so killing it takes the lot. sway execs pc-shell-start once and does not
            # respawn it, which leaves a black screen recoverable only by Ctrl+Alt+Backspace — from
            # a keypress that meant "close this window". The renderer closes its own focused window
            # and does nothing when it has none, which is the correct answer for Alt+F4 pressed on
            # an empty desktop.
            sway("-t", "send_tick", "pc:close")
            return
        if side in moves:
            # Each output has its own shell surface. Moving that Sway container itself leaves the
            # source output black and bypasses the selected app's identity/state handoff. Ask the
            # renderer to transfer its focused PosterChan window through the ordinary two-phase
            # monitor protocol instead.
            sway("-t", "send_tick", "pc:move-output:" + moves[side])
        elif side != "edge":
            sway("-t", "send_tick", "pc:snap:" + side)
        return
    if side == "minimise":
        # THE COMPOSITOR HAS NO MINIMISE. What it has is the scratchpad, and a window put there is
        # only recoverable through the frame that remembers it — which is why this is routed by
        # con_id to the renderer that OWNS the frame (`minimise` keeps the taskbar button), and why
        # a popped-out window is deliberately left alone: it has no frame and no taskbar entry, so
        # stashing it would be losing it. Every renderer sees the tick; only the owner acts.
        if not is_popped_out_window(win):
            sway("-t", "send_tick", "pc:minimise-native:%d" % int(win["id"]))
        return
    if side == "close":
        # A popped-out PosterChan window and a native application are both real toplevels, and
        # closing one is the compositor's job. The desktop learns a native window is gone from
        # sway's own `window::close`, which is the same path as quitting the app from its own menu,
        # so its paired HTML frame is reaped without being told separately.
        sway("[con_id=%d]" % int(win["id"]), "kill")
        return
    if side in moves and not is_popped_out_window(win):
        # Native Firefox/Telegram surfaces are paired with an HTML frame in exactly one output
        # renderer. A raw compositor move strands that frame/owner behind as a black window. Every
        # renderer sees the tick, so include con_id; only the renderer that owns it may hand it off.
        #
        # A POPPED-OUT POSTERCHAN WINDOW IS NOT THAT, and sending it here was the second half of
        # "not moveable with keyboard". It has no paired HTML frame and no owning renderer, so the
        # tick reached nobody and the window sat exactly where it was. Excluding it from the shell
        # branch alone was not enough — it simply fell into the next wrong branch. It is a plain
        # floating container; the geometry path below moves it the way it moves anything else.
        sway("-t", "send_tick", "pc:move-native:%d:%s" % (int(win["id"]), moves[side]))
        return
    if side in moves:
        # Straight compositor move for a window nothing else owns.
        sway("[con_id=%d]" % int(win["id"]), "move", moves[side])
        return
    box = out.get("rect") or {}
    x, y = int(box.get("x", 0)), int(box.get("y", 0))
    width, height = int(box.get("width", 1)), max(1, int(box.get("height", 1)) - 72)
    if side == "edge":
        r = win.get("rect") or {}
        # This mode runs on a title-bar button release. A release away from an edge is deliberately
        # a no-op; it must never turn an ordinary click or small move into a resize.
        near_top = int(r.get("y", y + 1000)) <= y + 60
        near_bottom = int(r.get("y", y)) + int(r.get("height", 0)) >= y + height - 28
        near_left = int(r.get("x", x + 1000)) <= x + 28
        near_right = int(r.get("x", x)) + int(r.get("width", 0)) >= x + width - 28
        # Corners are checked before the top edge. The previous top-first order maximised every
        # top-corner drop, making the four quarter-screen layouts impossible for native apps.
        if near_top and near_left:
            side = "top-left"
        elif near_top and near_right:
            side = "top-right"
        elif near_bottom and near_left:
            side = "bottom-left"
        elif near_bottom and near_right:
            side = "bottom-right"
        elif near_top:
            side = "max"
        elif near_left:
            side = "left"
        elif near_right:
            side = "right"
        else:
            return
    if side == "max":
        nx, ny, nw, nh = x, y, width, height
    elif side in ("top-left", "top-right", "bottom-left", "bottom-right"):
        nw, nh = width // 2, height // 2
        nx = x if side.endswith("left") else x + width - nw
        ny = y if side.startswith("top") else y + height - nh
    else:
        nw, nh, ny = width // 2, height, y
        nx = x if side == "left" else x + width - nw
    criteria = "[con_id=%d]" % int(win["id"])
    # One Sway transaction keeps Firefox/Telegram focused and never exposes a half-resized surface
    # between commands.  It also makes mouse-edge and Super+Arrow use the identical final geometry.
    subprocess.check_call([
        "swaymsg", criteria, "floating", "enable", ",",
        "resize", "set", "width", str(nw), "px", "height", str(nh), "px", ",",
        "move", "absolute", "position", str(nx), str(ny),
    ], stdout=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
