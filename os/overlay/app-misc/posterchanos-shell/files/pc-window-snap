#!/usr/bin/python3
"""Act on the focused window without wrapping it in an HTML frame.

Snapping, moving between outputs and CLOSING all need the same first question — is the focused
container a native application, a popped-out PosterChan window, or the shell surface that draws the
whole desktop? — and answering it wrongly costs the same thing every time. That question is answered
once, here, rather than copied into a second helper: this package has already shipped two copies of
one script that drifted apart.
"""
import json
import os
import socket
import struct
import glob
import subprocess
import sys


def _wayfire_socket():
    """The compositor's IPC socket.

    `WAYFIRE_SOCKET` is set for anything Wayfire launches, which is the normal case: these snaps are
    fired from key bindings. Anything else -- a helper, an update script, somebody testing the
    binding over ssh -- has no such variable, and `os.environ["WAYFIRE_SOCKET"]` answered that with a
    KeyError traceback into a stderr nobody reads. From the person's side the key simply does
    nothing. The socket is discoverable, so discover it.
    """
    live = os.environ.get("WAYFIRE_SOCKET")
    if live:
        return live
    run = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    found = sorted(glob.glob(os.path.join(run, "wayfire-wayland-*.socket")))
    if not found:
        raise RuntimeError("no Wayfire IPC socket (WAYFIRE_SOCKET unset and none found in %s)" % run)
    return found[0]


def wayfire(method, data=None):
    body = json.dumps({"method": method, "data": data or {}}).encode()
    with socket.socket(socket.AF_UNIX) as client:
        client.connect(_wayfire_socket())
        client.sendall(struct.pack("<I", len(body)) + body)
        head = client.recv(4)
        if len(head) != 4:
            raise RuntimeError("Wayfire IPC closed")
        size = struct.unpack("<I", head)[0]; reply = b""
        while len(reply) < size:
            reply += client.recv(size - len(reply))
    result = json.loads(reply)
    if isinstance(result, dict) and result.get("error"):
        raise RuntimeError(result["error"])
    return result


def shell_action(payload):
    subprocess.check_call(["/usr/local/bin/pc-wayfire-action", payload],
                          stdout=subprocess.DEVNULL)


def _neighbour(outputs, here, direction):
    """The output next to `here` in `direction`, by position rather than by index.

    Output ids are compositor bookkeeping and can come back in any order across a boot, so "the next
    one" has to be read off the geometry the person is actually looking at.
    """
    box = here.get("geometry") or {}
    x, y = int(box.get("x", 0)), int(box.get("y", 0))
    axis = "x" if direction in ("left", "right") else "y"
    forward = direction in ("right", "down")
    best = None
    for other in outputs:
        if int(other.get("id", -1)) == int(here.get("id", -2)):
            continue
        obox = other.get("geometry") or {}
        ox, oy = int(obox.get("x", 0)), int(obox.get("y", 0))
        delta = (ox - x) if axis == "x" else (oy - y)
        if (delta > 0) != forward or delta == 0:
            continue
        if best is None or abs(delta) < best[0]:
            best = (abs(delta), other)
    return best[1] if best else None


def taskbar_reserve(box):
    """How many pixels at the bottom of this output the taskbar owns.

    ONLY THE SHELL CAN MEASURE THIS. The taskbar is a flex child whose height moves with the UI
    scale, the font size and the safe-area inset, so the renderer measures it and the desktop
    process writes the result to $XDG_RUNTIME_DIR/posterchan-workarea.json. This script is fired by
    a compositor key binding with no way to be passed an argument, which is why it used to carry a
    hardcoded `72` -- a number that was never right: the bar is 48 css px, i.e. 48 device px at ui
    scale 1 and 60 at 1.25. Too small and a snapped window covers the taskbar (measured: 2503 on a
    2560 output); too large and it stops short of it with a gap.

    An unreadable or stale file falls back to the old constant rather than to zero: a wrong reserve
    misplaces one window, a zero reserve puts every snapped window over the bar. Stale is judged
    generously -- the shell republishes on every layout change, not on a timer, so an old file on a
    desktop nobody has touched is still describing the taskbar correctly.
    """
    try:
        run = os.environ.get("XDG_RUNTIME_DIR")
        if run:
            with open(os.path.join(run, "posterchan-workarea.json"), "r") as fh:
                area = json.load(fh)
            reserve = int(area.get("reserve") or 0)
            height = int(box.get("height", 0) or 0)
            # It must be a band at the bottom of THIS output, not a stray number from another.
            if 0 < reserve <= max(1, height) // 2:
                return reserve
    except Exception:
        pass
    return 72


def wayfire_main(side):
    views = wayfire("window-rules/list-views")
    win = next((v for v in views if v.get("mapped", True) and v.get("activated")), None)
    if not win:
        return
    title = str(win.get("title") or "")
    if is_posterchan_shell(win):
        actions = {"close": "pc:close", "minimise": "pc:minimise", "left": "pc:snap:left",
                   "right": "pc:snap:right", "max": "pc:snap:max"}
        if side in actions:
            shell_action(actions[side])
        elif side.startswith("move-"):
            shell_action("pc:move-output:" + side[5:])
        return
    view_id = int(win["id"])
    popped = is_popped_out_window(win)
    if side == "close":
        # A popped-out PosterChan window and a native application are both real toplevels, and
        # closing one is the compositor's job. The desktop learns a native window is gone from the
        # compositor's own unmap event -- the same path as quitting the app from its own menu -- so
        # its paired HTML frame is reaped without being told separately.
        wayfire("window-rules/close-view", {"id": view_id}); return
    if side == "minimise":
        # MINIMISE IS NOT THE COMPOSITOR'S TO DO, and this branch used to hand it all three cases.
        #
        # `wm-actions/set-minimized` hides the surface while the shell still believes the window is
        # open. For a NATIVE application that loses the taskbar button the window is recoverable
        # from, so it is routed by id to the renderer that owns its frame (`minimise` keeps the
        # button; every renderer sees the tick and only the owner acts). For a POPPED-OUT PosterChan
        # window there is no frame and no taskbar entry at all, so hiding it is simply losing it --
        # deliberately left alone, exactly as the Sway path did. Both rules were lost in the move
        # because the helper that carried them was only ever called from the Sway branch.
        if not popped:
            shell_action(f"pc:minimise-native:{view_id}")
        return
    if side.startswith("move-") and not popped:
        # Firefox and Telegram keep the native handoff: they have a paired HTML frame, and a raw
        # compositor move strands it behind as a black window.
        shell_action(f"pc:move-native:{view_id}:{side[5:]}"); return
    if side.startswith("move-"):
        # A POPPED-OUT WINDOW HAS NO PAIRED FRAME, so nothing has to be handed over -- but it still
        # has to MOVE. This branch used to `return` here, so Super+Shift+Arrow on a PosterChan window
        # did nothing at all on this compositor while the same key moved a native app. Place it on
        # the neighbouring output itself, in that output's local coordinates.
        outputs = wayfire("window-rules/list-outputs")
        here = next((o for o in outputs if int(o.get("id", -1)) == int(win.get("output-id", -2))), None)
        if not here:
            return
        target = _neighbour(outputs, here, side[5:])
        if not target:
            return
        rect = win.get("geometry") or {}
        box = target.get("geometry") or {}
        width = max(1, int(box.get("width", 1)))
        height = max(1, int(box.get("height", 1)))
        # configure-view geometry is OUTPUT-LOCAL, so this is a size and an inset rather than a
        # position on the desktop; clamp it so a window from a larger monitor still lands whole.
        w = min(int(rect.get("width", width // 2) or width // 2), width)
        h = min(int(rect.get("height", height // 2) or height // 2), height)
        wayfire("window-rules/configure-view", {
            "id": view_id, "output_id": int(target["id"]),
            "geometry": {"x": max(0, (width - w) // 2), "y": max(0, (height - h) // 2),
                         "width": w, "height": h}})
        return
    outputs = wayfire("window-rules/list-outputs")
    out = next((o for o in outputs if int(o.get("id", -1)) == int(win.get("output-id", -2))), None)
    if not out:
        return
    box = out.get("workarea") or out.get("geometry") or {}
    width, height = int(box.get("width", 1)), max(1, int(box.get("height", 1)) - taskbar_reserve(box))
    current = win.get("geometry") or {}
    if side == "edge":
        x, y = int(current.get("x", 0)), int(current.get("y", 0))
        w, h = int(current.get("width", 0)), int(current.get("height", 0))
        top, bottom, left, right = y <= 60, y + h >= height - 28, x <= 28, x + w >= width - 28
        if top and left: side = "top-left"
        elif top and right: side = "top-right"
        elif bottom and left: side = "bottom-left"
        elif bottom and right: side = "bottom-right"
        elif top: side = "max"
        elif left: side = "left"
        elif right: side = "right"
        else: return
    x = y = 0
    if side == "max": w, h = width, height
    elif side in ("top-left", "top-right", "bottom-left", "bottom-right"):
        w, h = width // 2, height // 2
        if side.endswith("right"): x = width - w
        if side.startswith("bottom"): y = height - h
    elif side in ("left", "right"):
        w, h = width // 2, height
        if side == "right": x = width - w
    else: return
    wayfire("window-rules/configure-view", {"id": view_id, "output_id": int(out["id"]),
        "geometry": {"x": x, "y": y, "width": w, "height": h}})


# WHICH WINDOW IS THIS: asked once, here, and never inline.
#
# `focused()` and `process_chain()` are gone with the Sway path that needed them -- they walked
# `swaymsg -t get_tree` for the focused container and then read /proc, because an XWayland window
# could map with no app_id at all. Wayfire answers both directly: `activated` on the view, and an
# `app-id` that is populated for XWayland surfaces too (it reports the X11 class).
#
# The CLASSIFICATION stays a pair of named predicates rather than a condition written into
# wayfire_main, for the reason in this module's docstring: three actions ask the same question and
# answering it differently in any one of them costs the same thing every time.
APP_IDS = ("posterchan", "posterchan-desktop", "place.poster.desktop")
#: The title main.js gives every popped-out PosterChan window at CREATION -- before its page can
#: rename it, because a window rule is evaluated when the surface maps.
WINDOW_TITLE = "PosterChan Window"


def process_chain(pid):
    """Yield command lines for a process and its parents without trusting the surface's app-id.

    A Wayland surface can be mapped before it has set one, and the compositor must never resize
    PosterChan's per-output shell: doing so makes the viewport narrow enough that the web desktop
    correctly falls back to its Classic layout, which reads as the desktop breaking. The renderer's
    ancestry, unlike its optional surface metadata, always reaches the packaged main process.
    """
    seen = set()
    while pid and pid not in seen:
        seen.add(pid)
        try:
            raw = open(f"/proc/{pid}/cmdline", "rb").read().replace(b"\0", b" ")
            yield raw.decode("utf-8", "replace")
            with open(f"/proc/{pid}/stat", "r", encoding="utf-8") as handle:
                stat = handle.read()
            # comm is parenthesised but may itself contain spaces and `)`. Only the final closing
            # parenthesis is structural; after it the first field is state and the second is ppid.
            end = stat.rfind(")")
            if end < 0:
                return
            fields = stat[end + 1:].split()
            pid = int(fields[1])
        except (OSError, ValueError, IndexError):
            return


def is_ours(win):
    """Ours by app-id, or -- when the surface has not set one yet -- by process ancestry.

    The ancestry read is the FALLBACK and not the first question: it is a /proc walk per call, and a
    stable app-id is both cheaper and exact. It exists because the one case it covers is the
    expensive one -- an unidentified shell surface treated as an ordinary application and snapped to
    half a monitor.
    """
    app = str(win.get("app-id") or win.get("app_id") or "").lower()
    if app:
        return app in APP_IDS
    pid = win.get("pid")
    if not pid:
        return False
    return any("posterchan-desktop" in line.lower() for line in process_chain(int(pid)))


def is_popped_out_window(win):
    """A real toplevel the SHELL owns the chrome and taskbar button for."""
    return is_ours(win) and str(win.get("title") or "").startswith(WINDOW_TITLE)


def is_posterchan_shell(win):
    """The desktop surface itself. A window of ours with no title yet is this, not a popped-out one:
    the shell surface is the first thing to map and the discriminator is a title it does not set."""
    return is_ours(win) and not str(win.get("title") or "").startswith(WINDOW_TITLE)




def main():
    side = sys.argv[1] if len(sys.argv) > 1 else ""
    moves = {"move-left": "left", "move-right": "right",
             "move-up": "up", "move-down": "down"}
    if side not in ("left", "right", "max", "edge", "close", "minimise", *moves):
        raise SystemExit(
            "usage: pc-window-snap left|right|max|edge|close|minimise"
            "|move-left|move-right|move-up|move-down")
    # ONE COMPOSITOR, so no branch. This used to fall through to a ~110-line Sway path that walked
    # `swaymsg -t get_tree` for the focused container and drove `swaymsg` criteria; it followed the
    # compositor out.
    wayfire_main(side)


if __name__ == "__main__":
    main()
