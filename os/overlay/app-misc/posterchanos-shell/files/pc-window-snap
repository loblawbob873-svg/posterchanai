#!/usr/bin/python3
"""Snap the focused native Sway window without wrapping it in an HTML frame."""
import json
import subprocess
import sys


def sway(*args):
    return subprocess.check_output(["swaymsg", *args], text=True)


def focused(node, output=None):
    if node.get("type") == "output":
        output = node
    if node.get("focused") and node.get("type") in ("con", "floating_con"):
        return node, output
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        hit = focused(child, output)
        if hit:
            return hit
    return None


def process_chain(pid):
    """Yield command lines for a process and its parents without trusting Wayland app_id.

    Electron surfaces have not kept one stable app_id across Wayland/XWayland and package
    upgrades.  The compositor must never resize PosterChan's per-output shell surface: doing so
    makes a laptop viewport narrow enough that the web desktop correctly falls back to Classic.
    The renderer's ancestry, unlike its optional surface metadata, always reaches the packaged
    posterchan-desktop main process.
    """
    seen = set()
    while pid and pid not in seen:
        seen.add(pid)
        try:
            raw = open(f"/proc/{pid}/cmdline", "rb").read().replace(b"\0", b" ")
            yield raw.decode("utf-8", "replace")
            with open(f"/proc/{pid}/stat", "r", encoding="utf-8") as handle:
                fields = handle.read().split()
            pid = int(fields[3])
        except (OSError, ValueError, IndexError):
            return


def is_posterchan_shell(win):
    app = str(win.get("app_id") or "").lower()
    if app in ("posterchan", "posterchan-desktop"):
        return True
    return any("posterchan-desktop" in cmd.lower() for cmd in process_chain(win.get("pid")))


def main():
    side = sys.argv[1] if len(sys.argv) > 1 else ""
    if side not in ("left", "right", "max", "edge"):
        raise SystemExit("usage: pc-window-snap left|right|max|edge")
    hit = focused(json.loads(sway("-t", "get_tree", "-r")))
    if not hit:
        return
    win, out = hit
    if not out or is_posterchan_shell(win):
        return
    box = out.get("rect") or {}
    x, y = int(box.get("x", 0)), int(box.get("y", 0))
    width, height = int(box.get("width", 1)), max(1, int(box.get("height", 1)) - 72)
    if side == "edge":
        r = win.get("rect") or {}
        # This mode runs on a title-bar button release. A release away from an edge is deliberately
        # a no-op; it must never turn an ordinary click or small move into a resize.
        if int(r.get("y", y + 1000)) <= y + 60:
            side = "max"
        elif int(r.get("x", x + 1000)) <= x + 28:
            side = "left"
        elif int(r.get("x", x)) + int(r.get("width", 0)) >= x + width - 28:
            side = "right"
        else:
            return
    if side == "max":
        nx, nw = x, width
    else:
        nw = width // 2
        nx = x if side == "left" else x + width - nw
    criteria = "[con_id=%d]" % int(win["id"])
    subprocess.check_call(["swaymsg", criteria, "floating", "enable"], stdout=subprocess.DEVNULL)
    subprocess.check_call(["swaymsg", criteria, "resize", "set", "width", str(nw), "px", "height", str(height), "px"], stdout=subprocess.DEVNULL)
    subprocess.check_call(["swaymsg", criteria, "move", "absolute", "position", str(nx), str(y)], stdout=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
