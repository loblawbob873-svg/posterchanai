#!/bin/sh
# PosterChanOS session: Wayfire, and only Wayfire.
#
# This was a SELECTOR while the desktop's native-window bridge only spoke Sway IPC, and it fell back
# to Sway whenever Wayfire looked unwell. Both halves are gone. The bridge speaks Wayfire, and the
# fallback was doing far more harm than good: three separate bugs (a health probe that guessed which
# monitor held the primary shell marker, a restart that killed the shell but not its launcher, and a
# 3-second replacement window against a 40-second launcher startup) made it fire on a desktop that
# was drawing perfectly, so the machine kept silently coming up on the OTHER compositor.
#
# THE RECOVERY IS A TEXT CONSOLE, NOT A SECOND COMPOSITOR. If Wayfire genuinely cannot run there is
# nothing a second wlroots compositor would do differently, and a login that quietly changes what
# desktop you are using is worse than one that says what went wrong. After a bounded retry this
# leaves an interactive shell on the VT with the reason and the log path on screen.
set -u

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/posterchanos"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/posterchanos"
selection_file="$config_dir/compositor"
mkdir -p "$state_dir"

# The selector file is still READ so an existing machine that has one is not surprised, but the
# only value that means anything now is `wayfire`; anything else (including a stale `sway`) is that
# file being out of date rather than a request this session can honour.
selected="${PC_COMPOSITOR:-}"
if [ -z "$selected" ] && [ -r "$selection_file" ]; then
	IFS= read -r selected <"$selection_file"
fi
case "$selected" in
	sway) note_stale=1 ;;
	*) note_stale='' ;;
esac

# EVERY LINE IN THIS LOG SAID THE SAME THING AND NONE OF THEM SAID WHEN.
#
# "Wayfire exited with status 0; falling back to Sway for this login." twenty-six times over, with
# no timestamp and no reason -- so it cannot answer the only two questions ever asked of it: is this
# happening now, and what happened. A fallback is the loudest event on this machine (the whole
# desktop changes compositor) and it was the quietest line in the logs.
note() {
	printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo '?')" "$*" >>"$state_dir/compositor-fallback.log"
}

# NO DESKTOP IS A STATE THE MACHINE HAS TO BE USABLE IN. `exec`ing bash here rather than exiting is
# deliberate: this script was itself exec'd from ~/.bash_profile, so exiting ends the login, agetty
# respawns it, and a Wayfire that fails every time becomes a login loop nobody can type into. A
# NON-login shell does not re-read .bash_profile, so it cannot recurse.
# WHAT A STATUS NUMBER MEANS, since the screen is the only place anybody will read it. A child that
# died from a signal is reported by the shell as 128+N, and "status 139" tells a person nothing while
# "killed by signal 11 (SIGSEGV)" tells them the compositor CRASHED rather than refused to start.
describe_status() {
	case "${1:-}" in
		''|*[!0-9]*) printf 'status unknown' ;;
		0) printf 'exited cleanly (status 0)' ;;
		*) if [ "$1" -gt 128 ] 2>/dev/null; then
			   sig=$(($1 - 128))
			   name=$(kill -l "$sig" 2>/dev/null || true)
			   printf 'killed by signal %s%s' "$sig" "${name:+ (SIG$name)}"
		   else
			   printf 'exited with status %s' "$1"
		   fi ;;
	esac
}

# ---- WHICH DRIVER HAS THE GPU -----------------------------------------------------------------
#
# "WAYFIRE EXITED WITH STATUS 1" ON AN NVIDIA MACHINE WAS NOT A NUMBER PROBLEM, IT WAS A DRIVER
# FIGHT, AND THE ANSWER WAS ALREADY ON THE SCREEN FOUR LINES ABOVE THE RESCUE TEXT.
#
# Photographed off a real NVIDIA laptop booting the 2026-09-13 ISO (the same image that reaches the
# desktop on an AMD machine):
#
#   NVRM: GPU 0000:01:00.0 is already bound to nouveau.
#   NVRM: The NVIDIA probe routine was not called for 1 device(s).
#   NVRM: No NVIDIA devices probed.
#   PosterChanOS: the Wayfire session could not start.
#     reason: Wayfire exited with status 1 after Wayfire exiting on its own
#
# nouveau took the card, the proprietary module was refused it, and the screen reported an exit
# status. Every fact needed to say that in one sentence is in `/sys` and in `dmesg`, and none of it
# was read. These helpers read it; `pc_gpu_diagnosis` turns it into the sentence, and the rescue
# screen prints both the sentence and the facts it came from.
#
# Roots are overridable so the decision can be driven over a fabricated /sys in a test -- the
# failure this exists for happens on hardware nothing here can emulate, so the only way to check the
# wording is to hand it the shapes.
drm_root=${PC_DRM_ROOT:-/sys/class/drm}
pci_root=${PC_PCI_ROOT:-/sys/bus/pci/devices}
proc_modules=${PC_PROC_MODULES:-/proc/modules}

# Every DRM device the kernel is actually driving, as "cardN driver". `card0-DP-1` is a CONNECTOR
# and sits in the same directory under the same glob -- counted as a device it turns a machine with
# one blank output into a machine with three GPUs.
pc_drm_cards() {
	for pc_card in "$drm_root"/card[0-9]*; do
		[ -e "$pc_card" ] || continue
		case "${pc_card##*/}" in *-*) continue ;; esac
		# `readlink -f` on a link that is not there answers with the PATH, so an unbound device
		# would report its driver as "driver". Ask whether it exists first.
		pc_drv=''
		[ ! -e "$pc_card/device/driver" ] || pc_drv=$(readlink -f "$pc_card/device/driver" 2>/dev/null)
		printf '%s %s\n' "${pc_card##*/}" "${pc_drv##*/}"
	done
}

# NVIDIA display devices, as "slot deviceid driver" -- vendor 0x10de and PCI class 0x03 (display).
# Without the class filter this also matches the audio function every modern NVIDIA card carries,
# which has no driver and would read as an unclaimed GPU on a perfectly healthy machine.
pc_nvidia_pci() {
	for pc_dev in "$pci_root"/*; do
		[ -r "$pc_dev/vendor" ] || continue
		IFS= read -r pc_v <"$pc_dev/vendor" 2>/dev/null || continue
		[ "$pc_v" = 0x10de ] || continue
		pc_c=''
		[ ! -r "$pc_dev/class" ] || IFS= read -r pc_c <"$pc_dev/class" 2>/dev/null || pc_c=''
		case "$pc_c" in 0x03*) ;; *) continue ;; esac
		pc_id=''
		[ ! -r "$pc_dev/device" ] || IFS= read -r pc_id <"$pc_dev/device" 2>/dev/null || pc_id=''
		pc_drv=''
		[ ! -e "$pc_dev/driver" ] || pc_drv=$(readlink -f "$pc_dev/driver" 2>/dev/null)
		pc_drv=${pc_drv##*/}
		printf '%s %s %s\n' "${pc_dev##*/}" "$pc_id" "${pc_drv:-none}"
	done
}

pc_module_loaded() { grep -qs "^$1 " "$proc_modules"; }

# THE ONE SENTENCE THE SCREEN OWES THE PERSON IN FRONT OF IT. Empty when nothing here is wrong --
# an ordinary crash on a healthy GPU must not be dressed up as a driver problem.
pc_gpu_diagnosis() {
	pc_cards=$(pc_drm_cards)
	pc_nv=$(pc_nvidia_pci)
	pc_stolen='' pc_unclaimed=''
	if [ -n "$pc_nv" ]; then
		while read -r pc_slot pc_id pc_drv; do
			[ -n "$pc_slot" ] || continue
			case "$pc_drv" in
				nvidia) ;;
				nouveau) pc_stolen="${pc_stolen:+$pc_stolen }$pc_slot" ;;
				*) pc_unclaimed="${pc_unclaimed:+$pc_unclaimed }$pc_slot" ;;
			esac
		done <<-PC_NV_EOF
		$pc_nv
		PC_NV_EOF
	fi
	if [ -n "$pc_stolen" ]; then
		printf '%s' "the NVIDIA card at $pc_stolen was claimed by nouveau, so the proprietary NVIDIA driver was refused it (\"already bound to nouveau\" in dmesg). Reboot and pick \"PosterChan Live\" from the boot menu, which keeps nouveau off the card"
		return 0
	fi
	if [ -z "$pc_cards" ]; then
		if [ -n "$pc_unclaimed" ]; then
			printf '%s' "no display driver claimed the GPU: the NVIDIA card at $pc_unclaimed has no kernel driver bound and this machine has no DRM device at all, so there is nothing for the compositor to open. The proprietary driver did not load for this kernel; reboot and pick \"PosterChan Live (open-source NVIDIA driver)\" from the boot menu"
		else
			printf '%s' "no display driver claimed the GPU — this machine has no DRM device at all, so there is nothing for the compositor to open"
		fi
		return 0
	fi
	return 0
}

# The measurements the sentence was made from, printed underneath it so a photograph of the screen
# is a complete report and the next question is not "what does dmesg say".
pc_gpu_facts() {
	pc_cards=$(pc_drm_cards)
	printf '%s\n' "  --- graphics ---"
	if [ -n "$pc_cards" ]; then
		printf '%s\n' "$pc_cards" | sed 's/^/  drm: /'
	else
		printf '%s\n' "  drm: (no DRM device — nothing for a compositor to open)"
	fi
	pc_nv=$(pc_nvidia_pci)
	[ -z "$pc_nv" ] || printf '%s\n' "$pc_nv" | sed 's/^/  nvidia card: /'
	pc_mods=''
	for pc_m in nvidia nvidia_drm nouveau amdgpu i915 xe radeon; do
		! pc_module_loaded "$pc_m" || pc_mods="${pc_mods:+$pc_mods }$pc_m"
	done
	printf '%s\n' "  modules: ${pc_mods:-(none of nvidia/nouveau/amdgpu/i915 loaded)}"
	pc_nvrm=$(dmesg 2>/dev/null | grep -E 'NVRM|nouveau' | tail -n 5)
	[ -z "$pc_nvrm" ] || printf '%s\n' "$pc_nvrm" | sed 's/^/  kernel: /'
	printf '%s\n' "  ----------------"
}

# A seam for tests and for anybody asking this machine what it sees, like PC_UI_SCALE_PROBE below.
if [ -n "${PC_GPU_PROBE:-}" ]; then
	printf 'diagnosis: %s\n' "$(pc_gpu_diagnosis)"
	pc_gpu_facts
	exit 0
fi

rescue() {
	printf '\n%s\n' "PosterChanOS: the Wayfire session could not start."
	printf '%s\n' "  reason: $*"
	printf '%s\n' "  log:    $state_dir/wayfire.log"
	printf '%s\n' "  shell:  $HOME/.config/posterchan-desktop/shell.log"
	# THE LOG IS PRINTED, NOT MERELY NAMED. A live USB on somebody else's PC fails for reasons this
	# script cannot guess -- a GPU with no driver in the image, a seat it cannot take, a plugin that
	# crashed -- and every one of them is already written in wayfire's own last lines. Naming a path
	# asks a person in front of a broken machine to know to `cat` it; a report that came back as
	# "wayfire exited with status 11" and nothing else is what this exists to stop.
	# AND AN EMPTY LOG IS TWO DIFFERENT FACTS. "Wayfire died before it wrote anything" is a real
	# diagnosis and a wrong one to offer about a launch that never happened: the root refusal below
	# stops before the compositor is started, and printing "the compositor could not open a GPU"
	# there sends somebody hunting a graphics driver over a login-account problem. `wayfire_started`
	# is set immediately before the launch, so this says only what it knows.
	if [ -s "$state_dir/wayfire.log" ]; then
		printf '\n%s\n' "  --- last lines of wayfire.log ---"
		tail -n 15 "$state_dir/wayfire.log" 2>/dev/null | sed 's/^/  /'
		printf '%s\n' "  ---------------------------------"
	elif [ -n "${wayfire_started:-}" ]; then
		printf '%s\n' "  (wayfire.log is empty — Wayfire died before it wrote anything, which usually"
		printf '%s\n' "   means the compositor could not open a GPU or take the seat on this machine.)"
	else
		printf '%s\n' "  (Wayfire was never started — the reason above was known before the attempt,"
		printf '%s\n' "   so there is nothing in its log and nothing about this machine's graphics.)"
	fi
	# THE GRAPHICS FACTS, BUT ONLY WHERE THEY ARE FACTS ABOUT THIS FAILURE. The root refusal above
	# stops before anything touches a GPU and must keep claiming nothing about one; `wayfire_started`
	# and `pc_gpu_reason` are the two states in which the card is part of the story.
	if [ -n "${wayfire_started:-}" ] || [ -n "${pc_gpu_reason:-}" ]; then
		printf '\n'
		pc_gpu_facts
	fi
	# AND THE RETRY LINE MUST NOT INVITE `sudo`, because sudo is the one way to make this fail
	# again -- see the root check below. "The desktop will not start" and "try it with sudo" is a
	# reflex, and this screen was handing a person a command that, run that way, produces the same
	# screen for ever with a number on it instead of a reason.
	# ...and it must not tell ROOT to run it as root, which is the shape the first draft had: the
	# account to name is the one that can actually succeed, and for root there isn't one.
	if [ "$(id -u 2>/dev/null || echo 0)" = 0 ]; then
		printf '\n%s\n' "This shell is root, and Wayfire will not start for root."
		printf '%s\n\n' "Log in as an ordinary user (the live image's account is 'live') and let the login start the desktop."
	else
		printf '\n%s\n' "Fix it here, then run: exec /usr/local/bin/pc-compositor-session"
		printf '%s\n\n' "(run it as $(id -un 2>/dev/null || echo 'this user') — NOT with sudo: Wayfire refuses to run as root.)"
	fi
	note "no desktop: $*"
	# Absolute by default -- a rescue must not depend on PATH being sane -- but overridable so a
	# test can run this path without handing itself an interactive shell.
	exec "${PC_RESCUE_SHELL:-/bin/bash}" -i
}

[ -z "${note_stale:-}" ] || note "compositor selector still says 'sway'; Wayfire is the only session now."

# "WAYFIRE EXITED WITH STATUS 1" MEANS EXACTLY ONE THING, AND THE SCREEN PRINTED THE NUMBER.
#
# Reported from a LiveUSB as "wayfire exited with status 1" and nothing else. Measured against the
# shipped wayfire 0.10.1 / wlroots 0.19.2 by booting the release ISO in a VM and provoking every
# failure this session can cause, status 1 is reachable by ONE path in wayfire's main.cpp:
#
#   EE [wayfire-0.10.1/src/main.cpp:67] Unable to drop root (we shouldn't be able to restore it
#                                       after setuid), refusing to start
#
# `drop_permissions()` refuses to start when root can be regained after the drop, which is exactly
# what running as uid 0 means. The other four EXIT_FAILURE paths cannot be hit here and each was
# checked rather than assumed: an unrecognised argument (this passes a valid `-c <file>`); "Failed
# to open DRM render device" (compiled OUT — the shipped binary carries the udmabuf LOGW string,
# `Trying SW rendering instead.`, and not the LOGE one, so a machine with no render node warns and
# carries on); "Failed to create renderer" (wlroots falls back to pixman — measured, a bochs-drm
# guest with no render node reached the desktop that way); and "Failed to load configuration
# backend!" (the .so is in the image). Everything ELSE measured exits 255 — no GPU at all, a
# missing XDG_RUNTIME_DIR and an unreadable config file all take wayfire's fatal handler — and a
# compositor this script stops itself exits 0.
#
# So a number was printed where a sentence was known. Worse, the rescue screen's own instruction is
# `exec /usr/local/bin/pc-compositor-session`, and the natural way to answer "the desktop will not
# start" is to try that with sudo — which cannot ever work and says the same unreadable thing again.
#
# This is checked HERE rather than by reading the status afterwards: nothing below should take the
# DRM device, rewrite a session config or spawn a launcher on behalf of root, and a reason known
# before the attempt should never be reported as the attempt's exit code.
if [ "$(id -u 2>/dev/null || echo 0)" = 0 ] || [ "$(id -ru 2>/dev/null || echo 0)" = 0 ]; then
	rescue "this session is running as root, and Wayfire refuses to run as root — it will not start unless it can drop privileges it cannot regain. Log in as an ordinary user (on the live image that account is 'live') and start the session without sudo."
fi

# ---- READ THE SCREEN WITHOUT BLURRING THE GAMES -----------------------------------------------
#
# THE OUTPUTS STAY AT SCALE 1. A 3840x2560 panel was being run at compositor scale 1.25 for
# readability, and that was measured to cost every game dearly: Xwayland is given no `-scale`, so a
# fullscreen game is told to render 3072x2048 and Wayfire upscales it to the panel -- blurry, and
# because the buffer never matches the output mode DIRECT SCANOUT is impossible and every single
# frame pays a full composite+scale pass. Output scale is the compositor's lever, and it is the one
# lever a game cannot opt out of.
#
# So the UI is scaled instead, per toolkit, from here -- the session's own environment, inherited by
# Wayfire and by everything Wayfire and the shell go on to start. A game reads none of these.
#
#   GDK_DPI_SCALE   GTK *3* only: multiplies the font dpi. Deliberately not GDK_SCALE, which is the
#                   whole-surface knob and is INTEGER-only -- its smallest step past 1 is 2 (200%),
#                   far past what this panel wants, and on Wayland it makes every GTK client submit
#                   a 2x buffer for the compositor to scale back down, which is the composite pass
#                   this whole change exists to avoid. Scaling TEXT carries GTK's chrome with it
#                   (most of it is sized from font metrics) and leaves icons crisp at 1:1.
#   text-scaling-   ...AND GTK 4 IGNORES GDK_DPI_SCALE ENTIRELY. Measured on the machine, GTK 4.20
#   factor          against the live Wayland display: with GDK_DPI_SCALE=1.25 (and with =2)
#                   gtk-xft-dpi stayed 98304 (96dpi) and "The quick brown fox" at Adwaita Sans 11
#                   measured 132x17px -- identical to no variable at all. `gtk-xft-dpi` in
#                   gtk-4.0/settings.ini did nothing either, with or without GTK_USE_PORTAL. What
#                   moved it was the SETTINGS PORTAL's org.gnome.desktop.interface
#                   text-scaling-factor: at 1.25, gtk-xft-dpi 122880 (120dpi) and the same string
#                   165x21px. So that key is set as well, below -- an env-only fix would have left
#                   every GTK4 app on this desktop (which is all of them but Firefox) at 96dpi while
#                   looking exactly like it had worked.
#   QT_FONT_DPI     Qt 5/6: the same idea, and the Qt equivalent of Xft.dpi. Deliberately not
#                   QT_SCALE_FACTOR, which resamples the entire UI including pixmaps (soft icons)
#                   and, again, hands the compositor an oversized surface.
#   Xft.dpi         X11/Xwayland clients that read neither of the above (xterm, the older Java
#                   toolkits, Steam's own chrome). It lives in the X resource database, not the
#                   environment, so it cannot simply be exported -- see the merge below.
#   XCURSOR_SIZE    24px is the toolkit default and is a DOT on a 165ppi panel. Snapped to a size
#                   cursor themes actually ship (24/32/48/64) rather than scaled continuously: an
#                   off-size cursor is resampled and looks soft, which is exactly the blur being
#                   avoided everywhere else here.
#   XCURSOR_THEME   wlroots' default theme name is "default", which on a machine with no `default`
#                   symlink falls back to the X11 core cursor -- a bitmap that HAS no large size. A
#                   named scalable theme is what makes XCURSOR_SIZE mean anything.
#
# Every one of these is honoured only if the session did not already carry it, so a user who exports
# their own in .bash_profile still wins.
#
# THE FACTOR IS NOT HARDCODED, because this same script runs on 1080p laptops. It is asked of the
# PANELS through DRM (no compositor is running yet, so wlr-randr cannot answer), using the same
# threshold the client stylesheet uses for its own zoom tier: a 4K-CLASS panel is one whose native
# mode is at least 3500x1800. Width alone cannot tell a 4K panel from a 5120x1440 ultrawide, which is
# ~110ppi and must not be scaled. `$config_dir/uiscale` (or PC_UI_SCALE) overrides the probe.
pc_scale_probe() {
	drm=${PC_DRM_ROOT:-/sys/class/drm}
	found=1
	for modes in "$drm"/*/modes; do
		[ -r "$modes" ] || continue
		status=${modes%/modes}/status
		[ -r "$status" ] || continue
		IFS= read -r st <"$status" 2>/dev/null || continue
		[ "$st" = connected ] || continue
		IFS= read -r mode <"$modes" 2>/dev/null || continue
		w=${mode%%x*}
		h=${mode#*x}
		h=${h%%[!0-9]*}
		case "$w" in ''|*[!0-9]*) continue ;; esac
		case "$h" in ''|*[!0-9]*) continue ;; esac
		if [ "$w" -ge 3500 ] && [ "$h" -ge 1800 ]; then found=1.25; fi
	done
	printf '%s' "$found"
}
pc_scale=${PC_UI_SCALE:-}
if [ -z "$pc_scale" ] && [ -r "$config_dir/uiscale" ]; then
	IFS= read -r pc_scale <"$config_dir/uiscale" 2>/dev/null || pc_scale=''
fi
case "$pc_scale" in ''|*[!0-9.]*) pc_scale=$(pc_scale_probe) ;; esac
# One awk for all the derived numbers: the shell has no floating point, and every one of these is a
# rounding of the same factor.
set -- $(awk -v s="$pc_scale" 'BEGIN{
	if (!(s + 0 > 0)) s = 1;
	if (s < 0.5) s = 0.5;
	if (s > 3) s = 3;
	c = (s < 1.15) ? 24 : ((s < 1.6) ? 32 : ((s < 2.2) ? 48 : 64));
	printf "%.4g %d %d\n", s, int(96 * s + 0.5), c;
}')
pc_scale=${1:-1} pc_dpi=${2:-96} pc_cursor=${3:-24}
set --   # the awk results are read; leave no positional arguments behind
# A seam for tests, and for anybody asking this machine what it decided. It prints and exits BEFORE
# the session does anything, so it can never be the reason a login goes wrong.
if [ -n "${PC_UI_SCALE_PROBE:-}" ]; then
	printf 'scale=%s dpi=%s cursor=%s\n' "$pc_scale" "$pc_dpi" "$pc_cursor"
	exit 0
fi
if [ "$pc_dpi" -ne 96 ]; then
	[ -n "${GDK_DPI_SCALE:-}" ] || export GDK_DPI_SCALE="$pc_scale"
	[ -n "${QT_FONT_DPI:-}" ] || export QT_FONT_DPI="$pc_dpi"
	[ -n "${XCURSOR_SIZE:-}" ] || export XCURSOR_SIZE="$pc_cursor"
	if [ -z "${XCURSOR_THEME:-}" ] && [ -d "${PC_ICON_ROOT:-/usr/share/icons}/Adwaita/cursors" ]; then
		export XCURSOR_THEME=Adwaita
	fi
fi
note "ui scale $pc_scale (font dpi $pc_dpi, cursor ${pc_cursor}px); outputs left at their own scale."

# THE GTK4 HALF IS A SETTING, NOT A VARIABLE, so it is written rather than exported -- and written
# in BOTH directions, or a machine that goes back to an ordinary monitor keeps 125% text for ever
# with nothing to say why. A value this script did not write is somebody's own choice and is left
# alone; the marker file is what tells the two apart.
pc_gtk_text_scale() {
	command -v gsettings >/dev/null 2>&1 || return 0
	if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
		bus=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus
		[ -S "$bus" ] || return 0
		DBUS_SESSION_BUS_ADDRESS="unix:path=$bus"
		export DBUS_SESSION_BUS_ADDRESS
	fi
	cur=$(gsettings get org.gnome.desktop.interface text-scaling-factor 2>/dev/null) || return 0
	[ -n "$cur" ] || return 0
	cur=$(awk -v v="$cur" 'BEGIN{ printf "%.4g", v + 0 }')
	[ "$cur" != "$pc_scale" ] || return 0
	mark=''
	[ ! -r "$state_dir/uiscale-gtk" ] || IFS= read -r mark <"$state_dir/uiscale-gtk"
	if [ "$cur" = "1" ] || [ "$cur" = "$mark" ]; then
		gsettings set org.gnome.desktop.interface text-scaling-factor "$pc_scale" 2>/dev/null || return 0
		printf '%s\n' "$pc_scale" >"$state_dir/uiscale-gtk"
		note "gtk text-scaling-factor $cur -> $pc_scale"
	else
		note "gtk text-scaling-factor left at $cur (not ours); this session's ui scale is $pc_scale"
	fi
}

# Xft.dpi HAS NO ENVIRONMENT VARIABLE, and the X server it belongs to does not exist yet: Wayfire
# starts Xwayland itself, after this point. Merging it now would silently do nothing, and merging it
# from the shell launcher would tie it to a restart of the shell. Wait for the socket in the
# BACKGROUND instead -- the session must not be delayed by an X server that, on a machine with no X
# clients, may legitimately never appear -- and give up quietly if it does not.
(
	pc_gtk_text_scale
	[ "$pc_dpi" -ne 96 ] || exit 0
	xsock=${PC_XWAYLAND_SOCKET:-/tmp/.X11-unix/X0}
	n=0
	while [ ! -S "$xsock" ] && [ "$n" -lt 300 ]; do sleep 0.2; n=$((n + 1)); done
	[ -S "$xsock" ] || exit 0
	command -v xrdb >/dev/null 2>&1 || exit 0
	printf 'Xft.dpi: %s\n' "$pc_dpi" | DISPLAY=${DISPLAY:-:0} xrdb -merge -
) >/dev/null 2>&1 &

# ---- A DESKTOP ON THE DRIVER THAT ACTUALLY HAS THE CARD ---------------------------------------
#
# A RESCUE CONSOLE IS WORSE THAN A SLOWER DESKTOP, and on the machine this was written for the
# difference was one `modprobe`. The default boot entry keeps nouveau off the card so the
# proprietary driver can have it; `pc.gpu=nouveau` is the boot-menu entry that asks for the
# opposite, and it needs an EXPLICIT modprobe because the nvidia-drivers package ships
# `blacklist nouveau` in /etc/modprobe.d -- which stops udev loading it by ALIAS and does not stop
# `modprobe nouveau` by name. That asymmetry is what makes the fallback possible at all.
#
# `pc.gpu=software` is the other entry: the card is there and its driver will not render.
pc_cmdline=''
[ ! -r "${PC_PROC_CMDLINE:-/proc/cmdline}" ] || IFS= read -r pc_cmdline <"${PC_PROC_CMDLINE:-/proc/cmdline}" 2>/dev/null || pc_cmdline=''
pc_gpu_request=''
for pc_arg in $pc_cmdline; do
	case "$pc_arg" in pc.gpu=*) pc_gpu_request=${pc_arg#pc.gpu=} ;; esac
done

# modprobe needs root. The live account has passwordless sudo; an installed machine's user does not,
# and a fallback that cannot run must fail quietly rather than stop the login.
pc_try_modprobe() {
	command -v modprobe >/dev/null 2>&1 || return 1
	modprobe "$1" >/dev/null 2>&1 && return 0
	command -v sudo >/dev/null 2>&1 || return 1
	sudo -n modprobe "$1" >/dev/null 2>&1
}

# udev creates the DRM device a moment after the module lands, so "did that work" is a short wait,
# not an immediate read.
pc_wait_for_drm() {
	pc_n=0
	while [ "$pc_n" -lt "${1:-30}" ]; do
		[ -z "$(pc_drm_cards)" ] || return 0
		sleep 0.1
		pc_n=$((pc_n + 1))
	done
	[ -n "$(pc_drm_cards)" ]
}

pc_gpu_reason=''
case "$pc_gpu_request" in
	nouveau)
		if pc_module_loaded nouveau; then
			note "boot menu asked for nouveau; it is already loaded."
		elif pc_try_modprobe nouveau && pc_wait_for_drm 50; then
			note "boot menu asked for nouveau; loaded it and a DRM device appeared."
		else
			note "boot menu asked for nouveau, but it could not be loaded on this machine."
		fi
		;;
	software) PC_SOFTWARE_RENDER=1 ;;
esac

# NO DRM DEVICE IS THE ONE STATE NOTHING CAN COMPOSITE ON -- this kernel is built with
# CONFIG_DRM_SIMPLEDRM unset, so there is no EFI-framebuffer device standing in for a GPU that did
# not come up. Before giving up, try the open driver by name: on a machine whose proprietary module
# was refused the card this is the whole difference between a desktop and a text console, and on the
# boot entry that blacklists nouveau in the KERNEL it simply fails and costs a tenth of a second.
if [ -z "$(pc_drm_cards)" ]; then
	# Asked ONLY where it can help: a machine with an NVIDIA display device and nothing driving it.
	# Reaching for nouveau on a box that has no NVIDIA card cannot produce a screen and would be a
	# privileged action taken on a guess.
	if [ -n "$(pc_nvidia_pci)" ] && pc_try_modprobe nouveau && pc_wait_for_drm 50; then
		note "no DRM device at login; loading nouveau by name produced one."
	else
		pc_gpu_reason=$(pc_gpu_diagnosis)
		rescue "${pc_gpu_reason:-no display driver claimed the GPU — this machine has no DRM device at all}"
	fi
fi

if true; then
	# The retry below re-execs this script with PC_SOFTWARE_RENDER set after a first attempt that
	# died on a card its driver could not render with. Same three variables as the virtio path, whose
	# llvmpipe route is the measured-good one; deliberately NOT WLR_RENDERER=pixman, which is slower
	# than llvmpipe and is not what that path proved.
	if [ -n "${PC_SOFTWARE_RENDER:-}" ]; then
		export LIBGL_ALWAYS_SOFTWARE=1
		export WLR_RENDERER_ALLOW_SOFTWARE=1
		PC_SHELL_EXTRA_ARGS="${PC_SHELL_EXTRA_ARGS:+$PC_SHELL_EXTRA_ARGS }--use-angle=swiftshader --enable-unsafe-swiftshader"
		export PC_SHELL_EXTRA_ARGS
		note "software rendering for this attempt."
	fi
	# QEMU's non-GL virtio-vga exposes a DRM card but no accelerated VirGL context. Chromium's
	# compositor aborts (SIGTRAP) when it tries that unusable render node. Keep physical GPUs and
	# VirGL-capable guests accelerated; only the virtio device with no render-node capability uses
	# Mesa's supported llvmpipe path. This is deliberately not Electron --disable-gpu.
	if grep -qs '^0x1af4$' /sys/class/drm/card*/device/vendor 2>/dev/null; then
		export LIBGL_ALWAYS_SOFTWARE=1
		export WLR_RENDERER_ALLOW_SOFTWARE=1
		# On software virtio scanout, atomic modesetting can leave the displayed frame at its
		# initial size even though compositor screenshots show the complete current desktop.
		# Use legacy DRM updates only in this existing virtual GPU software fallback.
		export WLR_DRM_NO_ATOMIC=1
		PC_SHELL_EXTRA_ARGS="${PC_SHELL_EXTRA_ARGS:+$PC_SHELL_EXTRA_ARGS }--use-angle=swiftshader --enable-unsafe-swiftshader"
		export PC_SHELL_EXTRA_ARGS
	fi
	health=${PC_WAYFIRE_HEALTH:-/usr/local/bin/pc-wayfire-health}
	# Refuse to take the DRM device unless the installed Electron package actually carries a Wayfire
	# backend.  This runs BEFORE DRM ownership changes, so an overlay/Desktop publication race ends
	# at a console that says why rather than at a black screen nothing can recover from.
	if ! command -v wayfire >/dev/null 2>&1 || ! wayfire --version >/dev/null 2>&1; then
		rescue "the wayfire executable is missing or will not run (wayfire --version failed)"
	elif [ ! -x "$health" ] || ! "$health" bundle >>"$state_dir/compositor-fallback.log" 2>&1; then
		rescue "the installed PosterChan desktop package has no Wayfire backend"
	else
		export XDG_CURRENT_DESKTOP=wayfire
		export XDG_SESSION_DESKTOP=wayfire
		: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
		export XDG_RUNTIME_DIR
		PC_WAYFIRE_READY_FILE="$XDG_RUNTIME_DIR/posterchan-wayfire-ready"
		PC_WAYFIRE_SHELL_PID_FILE="$XDG_RUNTIME_DIR/posterchan-wayfire-shell.pid"
		export PC_WAYFIRE_READY_FILE PC_WAYFIRE_SHELL_PID_FILE
		rm -f "$PC_WAYFIRE_READY_FILE" "$PC_WAYFIRE_SHELL_PID_FILE"
		# Keep package updates away from the live compositor and preserve custom settings.
		# Portage's pending config belongs to root: this user cannot move it into /etc.
		# Only the two required shell plugins are merged into this session's private copy.
		session_cfg="$XDG_RUNTIME_DIR/posterchan-wayfire.ini"
		if ! python3 - "${PC_WAYFIRE_CONFIG:-/etc/wayfire.ini}" "$session_cfg" "${PC_WAYFIRE_CONFIG:+explicit}" <<'PC_SESSION_CONFIG_PY'
import os
import pathlib
import re
import stat
import sys

source, destination = map(pathlib.Path, sys.argv[1:3])
explicit = sys.argv[3] == "explicit"
text = source.read_text()
required = ("posterchan-shell", "view-shot")

def trusted(path):
    try:
        info = path.lstat()
        return not stat.S_ISLNK(info.st_mode) and info.st_uid == 0 and not info.st_mode & 0o022
    except OSError:
        return False

def plugin_line(lines):
    core = False
    for index, line in enumerate(lines):
        section = re.match(r"^\s*\[([^]]+)\]", line)
        if section:
            core = section[1].strip() == "core"
        elif core and re.match(r"^\s*plugins\s*=", line):
            return index, line.split("=", 1)[1].split("#", 1)[0].split()
    return None, []

if not explicit and trusted(source.parent) and trusted(source):
    supplied = set()
    for pending in sorted(source.parent.glob("._cfg[0-9][0-9][0-9][0-9]_" + source.name)):
        if trusted(pending) and pending.is_file():
            _, plugins = plugin_line(pending.read_text().splitlines())
            supplied.update(plugins)
    lines = text.splitlines(keepends=True)
    index, plugins = plugin_line(lines)
    additions = [name for name in required if name in supplied and name not in plugins
                 and any(trusted(pathlib.Path(base) / ("lib" + name + ".so"))
                         and stat.S_ISREG((pathlib.Path(base) / ("lib" + name + ".so")).lstat().st_mode)
                         for base in ("/usr/lib64/wayfire", "/usr/lib/wayfire"))]
    if additions and index is not None:
        original = lines[index].rstrip("\r\n")
        value, comment, suffix = original.partition("#")
        lines[index] = value.rstrip() + " " + " ".join(additions) + (" #" + suffix if comment else "") + "\n"
        text = "".join(lines)
        print("Session required plugins added: " + " ".join(additions), file=sys.stderr)
# The destination is session-private; replace atomically without following an old symlink.
temporary = destination.with_name(destination.name + ".tmp." + str(os.getpid()))
fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
try:
    with os.fdopen(fd, "w") as stream:
        stream.write(text)
    os.replace(temporary, destination)
finally:
    temporary.unlink(missing_ok=True)
PC_SESSION_CONFIG_PY
		then
			# Keep a usable desktop if the optional private-copy preparation fails.
			session_cfg="${PC_WAYFIRE_CONFIG:-/etc/wayfire.ini}"
		fi
		# Read by rescue(): an empty log means something different before this line and after it.
		wayfire_started=1
		wayfire -c "$session_cfg" >"$state_dir/wayfire.log" 2>&1 &
		wayfire_pid=$!
		# WAIT ON THE LAUNCHER, NOT ON A CLOCK.
		#
		# This was a flat 60 seconds from WAYFIRE's start, and the launcher's own budget does not fit
		# inside it on slow hardware: it waits up to 10s for the Xwayland socket and then up to 30s
		# on the surface/GPU health gate, and all of that begins only once Electron has started --
		# which under llvmpipe is itself tens of seconds. Measured booting the release ISO in a VM:
		# Wayfire up at 16:25:21, the shell's first log at 16:26:05, the window killed at 16:26:21.
		# Forty-four seconds of honest work, then sixteen seconds of grace, then "the shell never
		# signalled ready" and a text console -- on an image that was starting perfectly.
		#
		# A LIVE LAUNCHER IS THE PROGRESS SIGNAL. While one exists the session is still starting, so
		# wait; when it is gone without a ready file the start has FAILED and there is nothing to
		# wait for, which is also faster than the old timer. The cap is the backstop for a launcher
		# that hangs rather than exits.
		n=0
		while kill -0 "$wayfire_pid" 2>/dev/null && [ ! -e "$PC_WAYFIRE_READY_FILE" ] && [ "$n" -lt 3000 ]; do
			sleep 0.1; n=$((n + 1))
			# Only after the compositor has had a moment to run its autostart: asking before that
			# would call every session a failure before the launcher had been spawned at all.
			if [ "$n" -gt 100 ] && ! pgrep -f '[p]c-shell-start-wayfire' >/dev/null 2>&1; then
				break
			fi
		done
		reason="Wayfire exiting on its own"
		if [ ! -e "$PC_WAYFIRE_READY_FILE" ] && kill -0 "$wayfire_pid" 2>/dev/null; then
			reason="the shell never signalled ready"
			note "no ready signal and no launcher after ${n}00ms; stopping Wayfire."
			kill "$wayfire_pid" 2>/dev/null || true
		elif [ -e "$PC_WAYFIRE_READY_FILE" ] && kill -0 "$wayfire_pid" 2>/dev/null; then
			# A shell restart deliberately creates a short gap between the old Electron process and
			# its replacement.  Treating that gap as a compositor failure killed Wayfire, raced the
			# replacement onto the dying socket, then fell the whole login back to Sway.  Supervise
			# the PID file as a replaceable generation: allow the launcher a bounded interval to
			# publish a different live PID while Wayfire itself remains healthy.
			shell_pid=''
			while kill -0 "$wayfire_pid" 2>/dev/null; do
				[ ! -r "$PC_WAYFIRE_SHELL_PID_FILE" ] || IFS= read -r shell_pid <"$PC_WAYFIRE_SHELL_PID_FILE"
				case "$shell_pid" in ''|*[!0-9]*) shell_pid='' ;; esac
				if [ -n "$shell_pid" ] && kill -0 "$shell_pid" 2>/dev/null; then
					while kill -0 "$wayfire_pid" 2>/dev/null && kill -0 "$shell_pid" 2>/dev/null; do sleep 1; done
				fi
				# HOW LONG TO WAIT FOR A REPLACEMENT IS TWO DIFFERENT QUESTIONS.
				#
				# A crash should be answered fast; the desktop is gone and a console is the way
				# back. A DELIBERATE restart must not be answered at all -- and it cannot answer
				# inside 3
				# seconds, because the launcher waits up to 10s for the Xwayland socket and then up
				# to 30s on its surface/GPU health gate before the replacement is even judged. Those
				# two numbers were set independently and never compared, so Ctrl+Alt+Backspace and
				# the automatic post-update restart reliably killed Wayfire and ended the login at a
				# rescue console, with only a line in compositor-fallback.log to say so.
				# pc-shell-restart leaves a marker; while it is
				# FRESH this waits for the launcher's own worst case, and a restart that dies
				# without clearing it ages out into the ordinary crash behaviour.
				old_pid=$shell_pid n=0 shell_pid=''
				restart_mark="$XDG_RUNTIME_DIR/posterchan-shell-restarting"
				limit=30
				if [ -f "$restart_mark" ]; then
					mark_age=$(( $(date +%s 2>/dev/null || echo 0) - $(stat -c %Y "$restart_mark" 2>/dev/null || echo 0) ))
					if [ "$mark_age" -ge 0 ] 2>/dev/null && [ "$mark_age" -lt 120 ] 2>/dev/null; then
						limit=600
					fi
				fi
				while kill -0 "$wayfire_pid" 2>/dev/null && [ "$n" -lt "$limit" ]; do
					[ ! -r "$PC_WAYFIRE_SHELL_PID_FILE" ] || IFS= read -r shell_pid <"$PC_WAYFIRE_SHELL_PID_FILE"
					case "$shell_pid" in ''|*[!0-9]*) shell_pid='' ;; esac
					[ -n "$shell_pid" ] && [ "$shell_pid" != "$old_pid" ] && kill -0 "$shell_pid" 2>/dev/null && break
					shell_pid=''; sleep 0.1; n=$((n + 1))
				done
				if [ -z "$shell_pid" ]; then
					reason="no replacement shell within ${limit}00ms of the last one exiting (restart marker $([ "$limit" -gt 30 ] && echo seen || echo absent))"
					note "$reason; stopping Wayfire."
					break
				fi
				note "shell replaced by pid $shell_pid; Wayfire kept."
			done
			kill -0 "$wayfire_pid" 2>/dev/null && kill "$wayfire_pid" 2>/dev/null || true
		fi
		wait "$wayfire_pid"
		status=$?
		# Re-read unconditionally: pc-shell-start-wayfire may replace a failed first GPU/surface attempt,
		# so the PID remembered when ready was first observed is not necessarily the final live child.
		if [ -r "$PC_WAYFIRE_SHELL_PID_FILE" ]; then
			IFS= read -r shell_pid <"$PC_WAYFIRE_SHELL_PID_FILE"
			case "$shell_pid" in ''|*[!0-9]*) shell_pid='' ;; esac
		fi
		# Wayfire may exit before Electron notices its display socket disappeared. A next login that
		# starts while that recorded shell is still alive makes the launcher reject itself as a
		# duplicate; the stale process then exits and leaves the new session with no desktop. Reap
		# this session's exact PID first.
		if [ -n "${shell_pid:-}" ] && kill -0 "$shell_pid" 2>/dev/null; then
			kill -TERM "$shell_pid" 2>/dev/null || true
			n=0
			while kill -0 "$shell_pid" 2>/dev/null && [ "$n" -lt 30 ]; do sleep 0.1; n=$((n + 1)); done
			kill -0 "$shell_pid" 2>/dev/null && kill -KILL "$shell_pid" 2>/dev/null || true
		fi
		rm -f "$PC_WAYFIRE_READY_FILE" "$PC_WAYFIRE_SHELL_PID_FILE"
		note "Wayfire $(describe_status "$status") after $reason."
	fi
fi

# ---- ONE RETRY, IN SOFTWARE, BEFORE A CONSOLE -------------------------------------------------
#
# A CARD WHOSE DRIVER WILL NOT RENDER IS NOT A MACHINE WITHOUT A DESKTOP. The measured NVIDIA
# failure was nouveau holding the card; the family it belongs to is wider than that one cause --
# any KMS device whose GL stack cannot come up gives wayfire a live DRM node and no renderer, and
# the session's only answer was a text console. llvmpipe over the same DRM device is slow and it
# draws, which is what the virtio path above has always relied on.
#
# ONCE, and only with a DRM device to draw on: retrying software rendering on a machine with no
# card at all would just fail again, more slowly, and bury the reason. The re-exec is what makes it
# one code path rather than a second copy of the launch -- and PC_SOFTWARE_RENDER is what stops it
# recurring, since ~/.bash_profile's own boot-attempt guard never sees this.
if [ -z "${PC_SOFTWARE_RENDER:-}" ] && [ "${status:-1}" -ne 0 ] && [ -n "$(pc_drm_cards)" ]; then
	note "Wayfire $(describe_status "${status:-}") on this machine's graphics; retrying once with software rendering."
	PC_SOFTWARE_RENDER=1
	export PC_SOFTWARE_RENDER
	if [ -x "$0" ]; then exec "$0"; else exec /bin/sh "$0"; fi
fi

pc_gpu_reason=$(pc_gpu_diagnosis)
pc_final="Wayfire $(describe_status "${status:-}") after ${reason:-startup}"
[ -z "${PC_SOFTWARE_RENDER:-}" ] || pc_final="$pc_final, and again with software rendering"
[ -z "$pc_gpu_reason" ] || pc_final="$pc_final — $pc_gpu_reason"
rescue "$pc_final"
