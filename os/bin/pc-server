#!/bin/bash
# pc-server — PosterChanOS's one privileged door to the bundled PosterChan server.
#
# app-misc/posterchan-server puts the server's CODE on every PosterChanOS machine (/opt/posterchan-server)
# and nothing else: no Python environment, no unit, nothing listening. There is no database server to set up
# at all (#161): the relay stores into PosterChanDB under /var/lib/posterchandb, and the app's tables are
# documents on that relay. tests/test_fresh_install_has_no_postgres.py runs `enable` and checks nothing
# here installs, initialises, starts or configures PostgreSQL. It is OFF until
# somebody presses Enable in System Settings → PosterChan Server, and then THIS script does the work —
# by running the project's own ./install.sh (`--nostr-only`, `--ai`, `--music`, …) rather than a second
# copy of what it does. The desktop reaches it through sudo, and the sudoers rule names every verb
# below with its exact arguments, so the grant is "these few things", never "any command as root".
#
#   status                 JSON: what is installed, enabled and running (no root needed)
#   enable                 set up on first use (the Nostr-only install), then start + enable
#   disable                stop + disable
#   restart                restart the server
#   logs                   the server's recent journal
#   install-ai FEATURE     ai | music | video | voice | searxng — the installer's own add-on paths
#   job                    JSON: the background job's state        job-log    its output
#
# Anything slow runs as a TRANSIENT UNIT (systemd-run), not as a child of the desktop: an install takes
# minutes to an hour, and the shell restarting underneath it (an update, Ctrl+Alt+Backspace) must not
# kill it half way through pip. systemd also refuses a second unit of the same name, which is the
# whole of the "one job at a time" rule — there is no lock file to go stale.
set -u

SELF="$(readlink -f "$0")"
APP="${PC_SERVER_APP:-/opt/posterchan-server}"
STATE="${PC_SERVER_STATE:-/var/lib/posterchan-server}"
SVC_USER="${PC_SERVER_USER:-posterchan-server}"
UNIT_DIR="${PC_SERVER_UNIT_DIR:-/etc/systemd/system}"
PIP_CACHE="${PC_SERVER_PIP_CACHE:-/var/cache/posterchan-server/pip}"
UNIT="posterchanai.service"
SEARX_UNIT="posterchanai-searxng.service"
JOB_UNIT="posterchan-server-job"
JOB_LOG="$STATE/job.log"
JOB_STATE="$STATE/job.state"
FEATURES="ai music video voice searxng"

die(){ echo "pc-server: $*" >&2; exit 1; }
usage(){ echo "usage: pc-server status|enable|disable|restart|logs|job|job-log|install-ai <${FEATURES// /|}>" >&2; exit 2; }
need_root(){ [ "$(id -u)" = "0" ] || die "this needs root (the desktop runs it through sudo)"; }

# ----------------------------------------------------------------------------------------------- facts
# Answered from FILES wherever a file answers it. `systemctl is-active` says "inactive" both for a
# stopped unit and for one that was never installed, which reads exactly like "stopped and should be
# running" — so "configured" is whether the installer has written the unit, and asked separately.
configured(){ [ -f "$UNIT_DIR/$UNIT" ]; }
venv_dir(){ local v; for v in "$APP/venv-unified" "$APP/venv"; do [ -x "$v/bin/python" ] && { echo "$v"; return 0; }; done; return 1; }
# Installed-package metadata, not an import: `import torch` takes seconds and a status poll must not.
has_dist(){ local v pat="$1"; v="$(venv_dir)" || return 1
  compgen -G "$v/lib/python3*/site-packages/$pat" >/dev/null; }
feature_installed(){
  case "$1" in
    ai)      has_dist 'torch-*.dist-info' && has_dist 'llama_cpp_python-*.dist-info' ;;
    music)   has_dist '*acestep*' || has_dist '*ace_step*' ;;
    video)   has_dist 'sentencepiece-*.dist-info' && has_dist 'diffusers-*.dist-info' ;;
    voice)   has_dist 'chatterbox_tts-*.dist-info' ;;
    searxng) has_dist '*searx*' ;;
    *) return 1 ;;
  esac
}
secret(){ # the value of `export KEY=...` in data/secrets.env, quotes stripped
  sed -n "s/^export $1=//p" "$APP/data/secrets.env" 2>/dev/null | tail -n1 | tr -d "\"'"
}
unit_state(){ systemctl "$1" "$2" 2>/dev/null | head -n1; }
job_running(){ case "$(unit_state is-active "$JOB_UNIT")" in active|activating|reloading) return 0;; esac; return 1; }
jstr(){ local s="${1//\\/\\\\}"; s="${s//\"/\\\"}"; printf '"%s"' "$s"; }
jbool(){ if "$@" >/dev/null 2>&1; then printf true; else printf false; fi; }
job_field(){ sed -n "s/^$1=//p" "$JOB_STATE" 2>/dev/null | tail -n1; }

status(){
  local port feats="" f sep=""
  port="$(secret POSTERCHANAI_PORT)"; case "$port" in ''|*[!0-9]*) port=3051;; esac
  for f in $FEATURES; do feats="$feats$sep$(jstr "$f"):$(jbool feature_installed "$f")"; sep=","; done
  printf '{"code":%s,"configured":%s,"venv":%s,"enabled":%s,"active":%s,"port":%s,"relayPort":3052,' \
    "$(jbool test -f "$APP/install.sh")" "$(jbool configured)" "$(jbool venv_dir)" \
    "$(jstr "$(unit_state is-enabled "$UNIT")")" "$(jstr "$(unit_state is-active "$UNIT")")" "$port"
  printf '"nostrOnly":%s,"database":"posterchandb","features":{%s},' \
    "$(jbool test "$(secret POSTERCHANAI_NOSTR_ONLY)" = 1)" "$feats"
  printf '"job":{"running":%s,"verb":%s,"rc":%s,"started":%s,"finished":%s}}\n' \
    "$(jbool job_running)" "$(jstr "$(job_field verb)")" "$(jstr "$(job_field rc)")" \
    "$(jstr "$(job_field started)")" "$(jstr "$(job_field finished)")"
}

# ------------------------------------------------------------------------------------------- the job
launch(){ # launch <verb...> — runs `pc-server __run <verb...>` as a transient unit and returns at once
  need_root
  job_running && die "another server job is still running — wait for it to finish"
  mkdir -p "$STATE"
  : >"$JOB_LOG"; chmod 0600 "$JOB_LOG"
  printf 'verb=%s\nstarted=%s\n' "$*" "$(date +%s)" >"$JOB_STATE"
  systemd-run --quiet --collect --unit="$JOB_UNIT" --setenv=PC_SERVER_IN_JOB=1 \
    --property=KillMode=mixed "$SELF" __run "$@" \
    || { grep -q '^rc=' "$JOB_STATE" || printf 'rc=125\nfinished=%s\n' "$(date +%s)" >>"$JOB_STATE"
         die "could not start the job"; }
  echo "started: $*"
}

run_job(){ # inside the transient unit only; its output IS the job log the settings page shows
  [ "${PC_SERVER_IN_JOB:-}" = "1" ] || die "__run is internal"
  exec >>"$JOB_LOG" 2>&1
  local rc=0
  echo "== $(date '+%F %T') pc-server $*"
  case "$1" in
    enable)     do_enable || rc=$? ;;
    install-ai) do_install_ai "$2" || rc=$? ;;
    *) echo "unknown job $1"; rc=2 ;;
  esac
  echo "== finished rc=$rc"
  printf 'rc=%s\nfinished=%s\n' "$rc" "$(date +%s)" >>"$JOB_STATE"
  return "$rc"
}

ensure_account(){
  id -u "$SVC_USER" >/dev/null 2>&1 && return 0
  # acct-user/posterchan-server normally made it at emerge time; this is the repair for a machine
  # that has the code without it (a hand install, a partly-merged update).
  echo "creating the $SVC_USER system account"
  useradd --system --user-group --home-dir "$STATE" --shell /sbin/nologin "$SVC_USER"
}

# TOR IS PART OF THE SERVER. The app starts its own Tor daemons when a `tor` binary exists and says
# nothing when it does not — measured on the build VM: every upstream relay "connected DIRECT (Tor
# proxy unavailable)", i.e. the node fetched Nostr from its real IP. net-vpn/tor is in the profile's
# package list but was absent from machines installed off the image, so it is ensured here. A
# failure is reported, not fatal: the server still works, just not over Tor.
ensure_tor(){
  command -v tor >/dev/null 2>&1 && return 0
  echo "installing Tor (net-vpn/tor)"
  emerge -1 --usepkg --getbinpkg net-vpn/tor || { echo "note: Tor did not install — relays will be reached directly"; return 0; }
}

set_secret(){ # set_secret KEY VALUE — only when the key is absent (never overwrite an operator's value)
  local f="$APP/data/secrets.env"
  mkdir -p "$APP/data"; touch "$f"; chmod 0600 "$f"
  grep -q "^export $1=" "$f" || echo "export $1=$2" >>"$f"
}

installer(){ # installer <args…> — the project's own install.sh, as root, told who the service runs as
  # pip runs as root here; its cache must be somewhere root owns or pip disables it (and a retried
  # multi-GB AI install would download everything again).
  mkdir -p "$PIP_CACHE"
  ( cd "$APP" && env HOME="$STATE" U2NET_HOME="$STATE/.u2net" PIP_CACHE_DIR="$PIP_CACHE" PC_SERVICE_USER="$SVC_USER" \
      ACESTEP_DIR="$APP/ACE-Step-1.5" SEARXNG_SRC_DIR="$APP/searxng-src" \
      VIDEO_PREFETCH=n VOICE_PREFETCH=n ./install.sh "$@" )
}

own_tree(){ # the service writes into its own tree (data/, state files); the installer ran as root
  chown -R "$SVC_USER:$SVC_USER" "$APP"
  [ -d /var/lib/posterchanai ] && chown -R "$SVC_USER:$SVC_USER" /var/lib/posterchanai
  [ -d "$PCDB" ] && chown -R "$SVC_USER:$SVC_USER" "$PCDB"
  return 0
}

# PosterChanDB's directory is made NOCOW HERE, on every enable, not only by install.sh: an enable on a box that
# is "already set up" never runs the installer, and the relay would then create the directory itself with
# copy-on-write on (btrfs fragments an append-only log). `chattr +C` only reaches files created after it, so
# it is set recursively while the directory is empty and, once it holds data, on the directory so every new
# segment inherits it. Btrfs only; anything else is left alone.
PCDB="${PC_PCDB_DIR:-/var/lib/posterchandb}"
prepare_pcdb(){
  mkdir -p -m 700 "$PCDB" 2>/dev/null || return 0
  [ "$(stat -f -c %T "$PCDB" 2>/dev/null)" = "btrfs" ] || return 0
  if [ -z "$(ls -A "$PCDB" 2>/dev/null)" ]; then
    chattr -R +C "$PCDB" 2>/dev/null || echo "could not set NOCOW on $PCDB (btrfs will copy-on-write its log)"
  else
    chattr +C "$PCDB" 2>/dev/null || true
  fi
  return 0
}

do_enable(){
  [ -f "$APP/install.sh" ] || { echo "the server code is not installed (app-misc/posterchan-server)"; return 1; }
  prepare_pcdb
  ensure_account || return 1
  ensure_tor
  # PosterChanDB (the relay's RAM-first store) lives beside the other system state, where
  # gentoo.sh's btrfs tweaks already made it NOCOW; install.sh creates it and re-checks +C.
  set_secret POSTERCHANDB_DIR "$PCDB"
  if configured && venv_dir >/dev/null; then
    echo "already set up — starting it"
  else
    installer --nostr-only --service-user "$SVC_USER" --no-start || { echo "the installer failed"; return 1; }
  fi
  configured || { echo "the installer did not write $UNIT"; return 1; }
  # SearXNG comes with the server (install.sh installs it on the nostr-only path too). A server set up
  # before that gets it here, once; a failure only means the node searches elsewhere.
  feature_installed searxng || installer --searxng || echo "note: SearXNG did not install — web search will use Admin → Tools"
  own_tree
  systemctl daemon-reload
  systemctl enable --now "$UNIT" || { echo "$UNIT did not start"; return 1; }
  if [ -f "$UNIT_DIR/$SEARX_UNIT" ]; then systemctl enable --now "$SEARX_UNIT" 2>&1 || echo "note: $SEARX_UNIT did not start"; fi
  echo "PosterChan server enabled"
}

do_install_ai(){
  local f="$1"
  case "$f" in
    ai)      installer --ai --service-user "$SVC_USER" --no-start ;;
    music)   installer --music ;;
    video)   installer --video ;;
    voice)   installer --voice ;;
    searxng) installer --searxng ;;
    *) echo "unknown feature $f"; return 2 ;;
  esac || { echo "the installer failed"; return 1; }
  own_tree
  systemctl daemon-reload
  # Only a RUNNING server is restarted to pick the feature up; installing never switches one on.
  if [ "$(unit_state is-active "$UNIT")" = "active" ]; then systemctl restart "$UNIT"; fi
  echo "installed: $f"
}

do_disable(){
  need_root
  systemctl disable --now "$UNIT" 2>&1 || true
  if [ -f "$UNIT_DIR/$SEARX_UNIT" ]; then systemctl disable --now "$SEARX_UNIT" 2>&1 || true; fi
  # No database to stop. A PostgreSQL an older version of this script set up is left exactly as it is: a
  # server enabled before #161 may still have its relay DSN in data/secrets.env, and another program may use it.
  echo "PosterChan server disabled"
}

case "${1:-}" in
  status)  [ $# -eq 1 ] || usage; status ;;
  enable)  [ $# -eq 1 ] || usage; [ -f "$APP/install.sh" ] || die "the server code is not installed"; launch enable ;;
  disable) [ $# -eq 1 ] || usage; do_disable ;;
  restart) [ $# -eq 1 ] || usage; need_root; configured || die "the server is not set up yet"; systemctl restart "$UNIT" && echo restarted ;;
  logs)    [ $# -eq 1 ] || usage; need_root; journalctl -u "$UNIT" -n 300 --no-pager -o short-iso 2>&1 ;;
  job)     [ $# -eq 1 ] || usage; printf '{"running":%s,"verb":%s,"rc":%s}\n' "$(jbool job_running)" \
             "$(jstr "$(job_field verb)")" "$(jstr "$(job_field rc)")" ;;
  job-log) [ $# -eq 1 ] || usage; tail -c 24000 "$JOB_LOG" 2>/dev/null; true ;;
  install-ai)
    [ $# -eq 2 ] || usage
    case " $FEATURES " in *" $2 "*) ;; *) usage ;; esac
    venv_dir >/dev/null || die "enable the server first — the AI installs go into its Python environment"
    case "$2" in music|video|voice)
      feature_installed ai || die "install \"AI chat + images\" first — $2 runs on its torch stack" ;; esac
    launch install-ai "$2" ;;
  __run) shift; run_job "$@" ;;
  *) usage ;;
esac
