#!/bin/bash
# Switch PosterChanOS' tty1 graphical session to a Nostr identity's Unix account.
set -eu

die(){ echo "pc-session-switch: $*" >&2; exit 1; }
STATE_ROOT=/var/lib/posterchanos
GETTY=/etc/systemd/system/getty@tty1.service.d/override.conf
LOCK="$STATE_ROOT/session.lock"
mkdir -p "$STATE_ROOT" "$(dirname "$GETTY")"
exec 9>"$LOCK"
flock -x 9

write_getty(){
  local user="$1"
  local tmp
  tmp=$(mktemp "$(dirname "$GETTY")/.override.XXXXXX")
  printf '[Unit]\nWants=NetworkManager.service\nAfter=NetworkManager.service\n[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin %s --noclear %%I $TERM\n' "$user" >"$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$GETTY"
}

# Restart out of band: restarting getty kills this caller's entire graphical session. A transient
# unit owns the timer and survives that teardown, while the IPC call has time to return success.
restart_later(){
  # A changed drop-in is only a file until PID 1 reloads it. Restarting getty without this reuses
  # the cached ExecStart and logs straight back into the account we were trying to leave.
  systemctl daemon-reload
  systemd-run --quiet --unit="posterchan-session-switch-$(date +%s%N)" \
    --on-active=1s /usr/bin/systemctl restart getty@tty1.service >/dev/null
}

if [ "${1:-}" = "--greeter" ]; then
  write_getty posterchan
  restart_later
  echo 'user=posterchan'
  exit 0
fi

if [ "${1:-}" = "--challenge" ]; then
  exec /usr/local/bin/pc-session-auth challenge "${2:-}" "${3:-}"
fi

NPUB="${1:-}"
echo "$NPUB" | grep -qE '^npub1[023456789acdefghjklmnpqrstuvwxyz]{58}$' || die 'malformed npub'
BOOTDATA=$(/usr/local/bin/pc-session-auth verify "$NPUB" switch) || exit $?
# The root verifier above is the authority; the provisioner is now an internal root call.
OUT=$(env -u SUDO_UID -u SUDO_USER /usr/local/bin/pc-provision-user "$NPUB") || exit $?
USER_NAME=$(printf '%s\n' "$OUT" | sed -n 's/^user=//p' | head -1)
HOME_DIR=$(printf '%s\n' "$OUT" | sed -n 's/^home=//p' | head -1)
[ -n "$USER_NAME" ] && [ -d "$HOME_DIR" ] || die 'provisioner returned no account'
echo "$USER_NAME" | grep -qE '^pc-[0-9a-f]{16}$' || die 'provisioner returned an unsafe user'
[ "$HOME_DIR" = "/home/$USER_NAME" ] || die 'provisioner returned an unsafe home'
[ ! -L "$HOME_DIR" ] && [ "$(stat -c %U "$HOME_DIR")" = "$USER_NAME" ] || die 'unsafe home ownership'

# EVERY IDENTITY GETS THE SAME ENTRY POINT, AND IT IS THE SESSION SCRIPT -- NOT A COMPOSITOR.
#
# This used to write `exec sway` straight into each provisioned account, which meant that signing in
# with a Nostr identity -- the ordinary way anybody uses this machine -- silently produced a SWAY
# desktop no matter what the rest of the OS was doing. It also copied a per-user sway config and an
# outputs.conf, so a person's saved monitor layout was written somewhere the Wayfire session never
# reads. pc-compositor-session owns the compositor, its environment and its recovery; this only has
# to hand the account to it.
[ ! -L "$HOME_DIR/.bash_profile" ] || die 'unsafe profile link'
runuser -u "$USER_NAME" -- tee "$HOME_DIR/.bash_profile" >/dev/null <<'PROFILE'
[[ -f ~/.bashrc ]] && . ~/.bashrc
if [ -z "$WAYLAND_DISPLAY" ] && [ "$XDG_VTNR" = 1 ]; then
  export XDG_SESSION_TYPE=wayland MOZ_ENABLE_WAYLAND=1
  exec /usr/local/bin/pc-compositor-session
fi
PROFILE
# The display layout the Wayfire session actually reads. Created empty and owned by the identity so
# System Settings -> Displays has somewhere to write on the first save.
runuser -u "$USER_NAME" -- mkdir -p "$HOME_DIR/.config/posterchanos"
[ "$(realpath -m "$HOME_DIR/.config/posterchanos")" = "$HOME_DIR/.config/posterchanos" ] || die 'unsafe config path'
[ ! -L "$HOME_DIR/.config/posterchanos/displays.json" ] || die 'unsafe displays link'

# Optional one-shot browser session for a newly-added identity. It is opaque data, never evaluated
# by this root helper, bounded to keep stdin from becoming a disk-fill interface, and readable only
# by the destination identity. The destination Electron main process consumes and unlinks it.
BOOT="$HOME_DIR/.posterchan-session-bootstrap"
umask 077
[ ! -L "$BOOT" ] || die 'unsafe session handoff link'
printf '%s' "$BOOTDATA" | runuser -u "$USER_NAME" -- sh -c 'umask 077; cat > "$1"' sh "$BOOT" || die 'could not save session handoff'
[ "$(stat -c %s "$BOOT")" -le 65536 ] || { rm -f "$BOOT"; die 'session handoff too large'; }
runuser -u "$USER_NAME" -- chmod 0700 "$HOME_DIR" "$HOME_DIR/.config" "$HOME_DIR/.config/posterchanos"
runuser -u "$USER_NAME" -- chmod 0600 "$HOME_DIR/.bash_profile" "$BOOT"

write_getty "$USER_NAME"
printf '%s\n' "$NPUB" >"$STATE_ROOT/current-npub"
chmod 0600 "$STATE_ROOT/current-npub"
restart_later
printf '%s\n' "$OUT"
