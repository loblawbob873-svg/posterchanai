#!/bin/sh
# Start the PosterChan shell and make it the desktop, once its window really exists.
#
# `for_window` cannot be relied on for this window. An X11 client sets WM_CLASS AFTER it maps, so
# sway evaluates criteria against a window that has no class yet: every rule looks right in the file
# and none of them match, and the shell ends up floating at 1280x860 in the middle of the screen.
# Electron picks X11 unless it is told otherwise, and whether it is told depends on flags surviving
# a wrapper and an AppRun.
#
# So the window is found FIRST and pinned second — the same order wm.js uses for anything it
# launches, and for the same reason: an app that has not appeared cannot be placed.

# Some minimal autologin/getty paths start the session without HOME even though the account has a
# valid home directory. Resolve it before any config, log, or Electron profile path is touched.
# Falling back to /tmp keeps the failure diagnosable for a malformed account instead of writing
# into / and dying with an unrelated permission error.
if [ -z "${HOME:-}" ]; then
  HOME=$(getent passwd "$(id -un)" | cut -d: -f6)
  HOME=${HOME:-/tmp/posterchan-$(id -u)}
  export HOME
fi

[ -n "$SWAYSOCK" ] || {
  # Old compositor sockets survive an unclean Sway restart. Filename order is not liveness: taking
  # the first one attached Electron's window manager bridge to a dead socket, so Super, placement
  # and monitor handoff failed intermittently until the next reboot. Ask each candidate and keep
  # only the compositor that answers.
  for candidate in /run/user/$(id -u)/sway-ipc.*.sock; do
    [ -S "$candidate" ] || continue
    if swaymsg -s "$candidate" -t get_version >/dev/null 2>&1; then
      SWAYSOCK=$candidate
      break
    fi
  done
}
export SWAYSOCK

# Sway may execute a recovery binding more than once when keys bounce or are held. Electron's own
# profile lock is created too late to close that race, so serialize the launcher itself.
exec 9>"/run/user/$(id -u)/posterchan-shell-start.lock"
flock -n 9 || exit 0

# Native GTK chrome follows the session preference. Firefox can have dark web content selected and
# still draw a bright toolbar when a minimal Sway session provides no desktop theme setting at all.
# Children launched by PosterChan inherit this too, giving one dark desktop instead of mixed chrome.
export GTK_THEME="${GTK_THEME:-Adwaita:dark}"
export GTK_APPLICATION_PREFER_DARK_THEME=1
# GTK is used for Electron theme integration even when Chromium renders through Ozone. Bind it to
# the compositor that is already verified above; otherwise it guesses unavailable X11 on a clean
# boot and aborts before the first shell window maps.
export GDK_BACKEND="${GDK_BACKEND:-wayland}"
# The shell is the desktop; a startup failure otherwise leaves only a black screen. Electron's
# diagnostics go to Sway's per-session log (the profile redirects stderr), never to the UI.
export ELECTRON_ENABLE_LOGGING=1
# This launcher only runs inside Sway. `auto` can select X11 before Sway's lazy Xwayland server has
# exported a usable DISPLAY on first boot; Chromium aborts with SIGTRAP before mapping any window.
# Native Wayland is already the compositor contract here and avoids that startup race entirely.
export ELECTRON_OZONE_PLATFORM_HINT=wayland
# Libvirt defaults QEMU's core limit to "unlimited". A desktop upgraded from the old launcher may
# already have a hard limit of zero; no descendant can raise it again, so virtqemud aborts before
# exec with "cannot limit core file size ... Operation not permitted". Requesting zero explicitly
# is compatible with both old and new sessions and agrees with the desktop's no-coredump policy.
mkdir -p "$HOME/.config/libvirt"
if ! grep -qE '^[[:space:]]*max_core[[:space:]]*=' "$HOME/.config/libvirt/qemu.conf" 2>/dev/null; then
  printf '\n# PosterChanOS: keep VM launch valid even when the session inherited a zero hard limit.\nmax_core = 0\n' \
    >>"$HOME/.config/libvirt/qemu.conf"
fi
chmod 0700 "$HOME/.config/libvirt" 2>/dev/null || true
chmod 0600 "$HOME/.config/libvirt/qemu.conf" 2>/dev/null || true
# Chromium reserves an enormous virtual address space. A fatal startup assertion must not pipe that
# mapping into systemd-coredump and leave the desktop process stuck forever in CoreDumping.
# Set only the SOFT limit. `ulimit -c 0` also lowered the inherited hard limit in this shell;
# libvirt's per-user daemon then could not raise QEMU's core limit and every VM failed before exec.
# Electron still writes no core, while independently launched children retain the right to choose.
ulimit -S -c 0

# Recovery launches (most notably over SSH) do not inherit Sway's display environment.  There is
# only one compositor socket in a PosterChanOS session, so recover it instead of letting Electron's
# `auto` backend fall through to X11 and leave the user looking at a black desktop.
if [ -z "$XDG_RUNTIME_DIR" ]; then
  XDG_RUNTIME_DIR=/run/user/$(id -u)
  export XDG_RUNTIME_DIR
fi
# Sway runs config `exec` commands while its startup is still in progress. On a fast fresh boot the
# IPC socket already exists but the client Wayland socket does not. Starting Electron in that tiny
# gap makes Chromium abort with SIGTRAP and leaves a permanently black desktop. Wait for the actual
# display endpoint rather than treating an empty lookup as a usable display name.
wayland_socket=''
display_tries=0
while [ "$display_tries" -lt 100 ]; do
  if [ -n "$WAYLAND_DISPLAY" ] && [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
    wayland_socket="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
    break
  fi
  wayland_socket=$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -type s -name 'wayland-*' 2>/dev/null | head -1)
  [ -z "$wayland_socket" ] || break
  display_tries=$((display_tries + 1))
  sleep 0.1
done
if [ -z "$wayland_socket" ]; then
  echo "PosterChan shell could not find Sway's Wayland display socket" >&2
  exit 1
fi
WAYLAND_DISPLAY=${wayland_socket##*/}
export WAYLAND_DISPLAY
# SSH/recovery launches also lack the desktop identity which Chromium and xdg-desktop-portal use to
# choose the wlroots screencast backend. A Wayland socket owned by this Sway session is conclusive;
# restore the same values the session exports during a normal boot.
# A recovery launched through SSH commonly has XDG_SESSION_TYPE=tty.  Keeping that non-empty but
# wrong value makes WebRTC's IsRunningUnderWayland() return false even though Electron is visibly
# connected to the verified Wayland socket above; desktop capture then takes its X11 fallback and
# reports zero sources.  At this point the socket has been validated as Sway's, so these are facts,
# not user preferences to preserve.
XDG_SESSION_TYPE=wayland
XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_TYPE XDG_CURRENT_DESKTOP

# Recovery launches commonly come from SSH and therefore do not inherit the user's D-Bus session.
# The original Sway boot does, which made a fresh boot and a remote shell restart behave
# differently even with the same binary and Wayland socket. Reattach only to this user's standard
# bus socket; never invent an address when it does not exist.
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
  DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
  export DBUS_SESSION_BUS_ADDRESS
fi

# Exporting these variables fixes Electron itself, but xdg-desktop-portal is a systemd user service
# and inherits the USER MANAGER'S environment instead.  When that environment is empty, grim still
# works while WebRTC/OBS lists no screens: the portal cannot select its wlroots backend.  Import the
# verified Sway values before launching PosterChan. Restart the portal only when its old environment
# was stale, so restarting the shell does not interrupt an already healthy recording session.
portal_env=$(systemctl --user show-environment 2>/dev/null || true)
portal_stale=0
printf '%s\n' "$portal_env" | grep -qx "WAYLAND_DISPLAY=$WAYLAND_DISPLAY" || portal_stale=1
printf '%s\n' "$portal_env" | grep -qx 'XDG_CURRENT_DESKTOP=sway' || portal_stale=1
printf '%s\n' "$portal_env" | grep -qx 'XDG_SESSION_TYPE=wayland' || portal_stale=1
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE SWAYSOCK >/dev/null 2>&1 || true
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE SWAYSOCK >/dev/null 2>&1 || true
fi
if [ "$portal_stale" -eq 1 ]; then
  systemctl --user try-restart xdg-desktop-portal-wlr.service xdg-desktop-portal.service >/dev/null 2>&1 || true
fi

# Portage owns /usr/bin/posterchan. Older LiveOS images and the standalone updater installed the
# wrapper in /usr/local/bin instead; keep that as a fallback, but never let a stale local copy
# shadow the package that was just upgraded. That stale wrapper reset Wayland to `auto`, which is
# why a direct launch fixed the laptop Super key and the normal launcher broke it again.
if [ -x /usr/bin/posterchan ]; then
  PC_DESKTOP_LAUNCHER=/usr/bin/posterchan
else
  PC_DESKTOP_LAUNCHER=/usr/local/bin/posterchan
fi

# In a SPICE guest the viewer and guest must agree on one framebuffer size. Without the guest agent
# virt-viewer scales the picture locally while the emulated USB tablet still reports coordinates in
# the guest's old geometry: the cursor is visibly over one button and clicks another place. The
# system daemon owns the virtio channel; this session half supplies resize, pointer and clipboard.
# Physical machines have no channel and do no work here.
if [ -e /dev/virtio-ports/com.redhat.spice.0 ] && command -v spice-vdagent >/dev/null 2>&1; then
  if ! pgrep -u "$(id -u)" -x spice-vdagent >/dev/null 2>&1; then
    spice-vdagent >/tmp/posterchan-spice-vdagent.log 2>&1 &
  fi
fi

# A STALE SINGLE-INSTANCE LOCK IS A BLACK SCREEN FOREVER, and this is the bug that proves the
# shell needs a launcher at all rather than a bare exec line.
#
# Electron writes ~/.config/posterchan-desktop/SingletonLock as a symlink naming `host-pid`. If the
# app dies without removing it — killed, OOM, power cut, which on the machine that IS the desktop is
# every crash — the next launch finds the lock, tries to hand off to an instance that is not there,
# and EXITS SILENTLY. The compositor comes up, execs the shell, the shell quits, and the person is
# looking at an empty black screen with no error anywhere. It cannot recover by itself, which for a
# desktop is the difference between a crash and a brick.
#
# Removed only when the pid it names is genuinely gone: a live lock belongs to a running instance,
# and deleting that would let two copies fight over one profile directory.
USER_HOME="${HOME:-/home/$(id -un)}"
# Current Electron uses the first path. Some packaged/first-run builds placed Chromium's singleton
# files directly in app.getPath('home'); that is the second path and was the installed-VM black
# screen: the old pid was dead, but every restart tried its dead socket and no window ever mapped.
LOCKS="$USER_HOME/.config/posterchan-desktop/SingletonLock $USER_HOME/SingletonLock"
clear_dead_locks() {
  # Chromium's singleton state is not guaranteed to keep its usual symlink shape after an
  # interrupted package replacement. If no shell process exists, the launcher mutex above is the
  # authority: nothing live can own any of these files, so remove the complete stale set. The old
  # symlink/PID path remains for the case where another shell really is running.
  if ! pgrep -u "$(id -u)" -f '^/opt/posterchan/posterchan-desktop .*--shell' >/dev/null 2>&1; then
    for LOCK in $LOCKS; do
      singleton_dir=${LOCK%/SingletonLock}
      rm -f "$singleton_dir"/SingletonLock "$singleton_dir"/SingletonSocket \
            "$singleton_dir"/SingletonCookie
    done
    return
  fi
  for LOCK in $LOCKS; do
    [ -L "$LOCK" ] || continue
    target=$(readlink "$LOCK" 2>/dev/null || echo '')
    pid=${target##*-}
    singleton_dir=${LOCK%/SingletonLock}
    case "$pid" in
      ''|*[!0-9]*) rm -f "$singleton_dir"/SingletonLock "$singleton_dir"/SingletonSocket \
                          "$singleton_dir"/SingletonCookie ;; # unparseable: no live owner
      *) kill -0 "$pid" 2>/dev/null || rm -f "$singleton_dir"/SingletonLock \
          "$singleton_dir"/SingletonSocket "$singleton_dir"/SingletonCookie ;;
    esac
  done
}
clear_dead_locks

# Proven on the booted reference LiveOS: let the packaged wrapper's `auto` Ozone choice select the
# backend. Forcing this build through X11 produced a healthy Sway session with no mapped shell — the
# repeated black-screen ISO. The placement loop below handles either app_id or late WM_CLASS, so it
# does not need to dictate the rendering backend.
# FD 9 is the launcher mutex, not part of the desktop environment. Close it in Electron: otherwise
# every app Electron launches (Firefox, Steam, terminals) inherits the lock and a shell restart can
# never acquire it again until all of those unrelated apps exit.
SHELL_LOG="$USER_HOME/.config/posterchan-desktop/shell.log"
mkdir -p "${SHELL_LOG%/*}"
[ ! -f "$SHELL_LOG" ] || [ "$(wc -c < "$SHELL_LOG" 2>/dev/null || echo 0)" -lt 1048576 ] || mv -f "$SHELL_LOG" "$SHELL_LOG.old"
"$PC_DESKTOP_LAUNCHER" --shell --ozone-platform=wayland 9>&- >>"$SHELL_LOG" 2>&1 &
shell_pid=$!
retries=0

# Up to 60s: an Electron cold start on a slow disk is not a failure. Polling rather than
# subscribing, because this must work before anything else in the session is up.
i=0
while [ $i -lt 120 ]; do
  if swaymsg -t get_tree 2>/dev/null | grep -Eq '"app_id": "(posterchan-desktop|PosterChan|place\.poster\.desktop)"|"class": "posterchan-desktop"'; then
    # TILED, NOT FULLSCREEN — and the difference is whether anything else can be seen.
    #
    # A fullscreen window in sway covers the whole workspace INCLUDING floating windows, so with the
    # shell fullscreen a terminal opens, exists, reports its geometry, and is `visible: false`.
    # Nothing on screen, no error, and no way to get a terminal on the machine. Being the only TILED
    # window fills the screen just the same and lets everything float above it, which is what the
    # desktop is for.
    for sel in '[app_id="posterchan-desktop"]' '[app_id="PosterChan"]' '[app_id="place.poster.desktop"]' '[class="posterchan-desktop"]'; do
      swaymsg "$sel fullscreen disable" >/dev/null 2>&1
      swaymsg "$sel floating disable" >/dev/null 2>&1
      swaymsg "$sel border none" >/dev/null 2>&1
    done
    echo "PosterChan shell window mapped"
    # The login profile uses this boot-scoped counter to stop agetty turning a fatal Sway exit into
    # an endless black-frame loop. A mapped shell proves this session is healthy, so a later genuine
    # restart gets its normal recovery attempt again.
    rm -f "$USER_HOME/.local/state/posterchanos/sway-boot-attempt"
    exit 0
  fi
  # Electron can exit before mapping when its SingletonSocket/Lock outlives the process that was
  # just killed. A one-shot launcher then leaves a permanent black screen. Clean only a dead lock
  # (the guarded logic above) and retry; a healthy cold start is left its full 60 seconds.
  if ! kill -0 "$shell_pid" 2>/dev/null && [ "$retries" -lt 3 ]; then
    clear_dead_locks
    retries=$((retries + 1))
    sleep 1
    "$PC_DESKTOP_LAUNCHER" --shell --ozone-platform=wayland 9>&- >>"$SHELL_LOG" 2>&1 &
    shell_pid=$!
  fi
  i=$((i + 1))
  sleep 0.5
done
echo "PosterChan shell window did not map after retries" >&2
exit 1
