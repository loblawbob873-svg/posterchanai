#!/bin/sh
# Start the PosterChan shell and make it the desktop, once its window really exists.
#
# `for_window` cannot be relied on for this window. An X11 client sets WM_CLASS AFTER it maps, so
# sway evaluates criteria against a window that has no class yet: every rule looks right in the file
# and none of them match, and the shell ends up floating at 1280x860 in the middle of the screen.
# Electron picks X11 unless it is told otherwise, and whether it is told depends on flags surviving
# a wrapper and an AppRun.
#
# So the window is found FIRST and pinned second — the same order wm.js uses for anything it
# launches, and for the same reason: an app that has not appeared cannot be placed.
[ -n "$SWAYSOCK" ] || SWAYSOCK=$(ls /run/user/$(id -u)/sway-ipc.*.sock 2>/dev/null | head -1)
export SWAYSOCK

# Sway may execute a recovery binding more than once when keys bounce or are held. Electron's own
# profile lock is created too late to close that race, so serialize the launcher itself.
exec 9>"/run/user/$(id -u)/posterchan-shell-start.lock"
flock -n 9 || exit 0

# Native GTK chrome follows the session preference. Firefox can have dark web content selected and
# still draw a bright toolbar when a minimal Sway session provides no desktop theme setting at all.
# Children launched by PosterChan inherit this too, giving one dark desktop instead of mixed chrome.
export GTK_THEME="${GTK_THEME:-Adwaita:dark}"
export GTK_APPLICATION_PREFER_DARK_THEME=1
# The shell is the desktop; a startup failure otherwise leaves only a black screen. Electron's
# diagnostics go to Sway's per-session log (the profile redirects stderr), never to the UI.
export ELECTRON_ENABLE_LOGGING=1
# This launcher only runs inside Sway. `auto` can select X11 before Sway's lazy Xwayland server has
# exported a usable DISPLAY on first boot; Chromium aborts with SIGTRAP before mapping any window.
# Native Wayland is already the compositor contract here and avoids that startup race entirely.
export ELECTRON_OZONE_PLATFORM_HINT=wayland
# Chromium reserves an enormous virtual address space. A fatal startup assertion must not pipe that
# mapping into systemd-coredump and leave the desktop process stuck forever in CoreDumping.
ulimit -c 0

# Recovery launches (most notably over SSH) do not inherit Sway's display environment.  There is
# only one compositor socket in a PosterChanOS session, so recover it instead of letting Electron's
# `auto` backend fall through to X11 and leave the user looking at a black desktop.
if [ -z "$XDG_RUNTIME_DIR" ]; then
  XDG_RUNTIME_DIR=/run/user/$(id -u)
  export XDG_RUNTIME_DIR
fi
# Sway runs config `exec` commands while its startup is still in progress. On a fast fresh boot the
# IPC socket already exists but the client Wayland socket does not. Starting Electron in that tiny
# gap makes Chromium abort with SIGTRAP and leaves a permanently black desktop. Wait for the actual
# display endpoint rather than treating an empty lookup as a usable display name.
wayland_socket=''
display_tries=0
while [ "$display_tries" -lt 100 ]; do
  if [ -n "$WAYLAND_DISPLAY" ] && [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
    wayland_socket="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
    break
  fi
  wayland_socket=$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -type s -name 'wayland-*' 2>/dev/null | head -1)
  [ -z "$wayland_socket" ] || break
  display_tries=$((display_tries + 1))
  sleep 0.1
done
if [ -z "$wayland_socket" ]; then
  echo "PosterChan shell could not find Sway's Wayland display socket" >&2
  exit 1
fi
WAYLAND_DISPLAY=${wayland_socket##*/}
export WAYLAND_DISPLAY

# A STALE SINGLE-INSTANCE LOCK IS A BLACK SCREEN FOREVER, and this is the bug that proves the
# shell needs a launcher at all rather than a bare exec line.
#
# Electron writes ~/.config/posterchan-desktop/SingletonLock as a symlink naming `host-pid`. If the
# app dies without removing it — killed, OOM, power cut, which on the machine that IS the desktop is
# every crash — the next launch finds the lock, tries to hand off to an instance that is not there,
# and EXITS SILENTLY. The compositor comes up, execs the shell, the shell quits, and the person is
# looking at an empty black screen with no error anywhere. It cannot recover by itself, which for a
# desktop is the difference between a crash and a brick.
#
# Removed only when the pid it names is genuinely gone: a live lock belongs to a running instance,
# and deleting that would let two copies fight over one profile directory.
USER_HOME="${HOME:-/home/$(id -un)}"
# Current Electron uses the first path. Some packaged/first-run builds placed Chromium's singleton
# files directly in app.getPath('home'); that is the second path and was the installed-VM black
# screen: the old pid was dead, but every restart tried its dead socket and no window ever mapped.
LOCKS="$USER_HOME/.config/posterchan-desktop/SingletonLock $USER_HOME/SingletonLock"
clear_dead_locks() {
  for LOCK in $LOCKS; do
    [ -L "$LOCK" ] || continue
    target=$(readlink "$LOCK" 2>/dev/null || echo '')
    pid=${target##*-}
    singleton_dir=${LOCK%/SingletonLock}
    case "$pid" in
      ''|*[!0-9]*) rm -f "$singleton_dir"/SingletonLock "$singleton_dir"/SingletonSocket \
                          "$singleton_dir"/SingletonCookie ;; # unparseable: no live owner
      *) kill -0 "$pid" 2>/dev/null || rm -f "$singleton_dir"/SingletonLock \
          "$singleton_dir"/SingletonSocket "$singleton_dir"/SingletonCookie ;;
    esac
  done
}
clear_dead_locks

# Proven on the booted reference LiveOS: let the packaged wrapper's `auto` Ozone choice select the
# backend. Forcing this build through X11 produced a healthy Sway session with no mapped shell — the
# repeated black-screen ISO. The placement loop below handles either app_id or late WM_CLASS, so it
# does not need to dictate the rendering backend.
# FD 9 is the launcher mutex, not part of the desktop environment. Close it in Electron: otherwise
# every app Electron launches (Firefox, Steam, terminals) inherits the lock and a shell restart can
# never acquire it again until all of those unrelated apps exit.
/usr/local/bin/posterchan --shell --ozone-platform=wayland 9>&- &
shell_pid=$!
retries=0

# Up to 60s: an Electron cold start on a slow disk is not a failure. Polling rather than
# subscribing, because this must work before anything else in the session is up.
i=0
while [ $i -lt 120 ]; do
  if swaymsg -t get_tree 2>/dev/null | grep -q 'posterchan-desktop'; then
    # TILED, NOT FULLSCREEN — and the difference is whether anything else can be seen.
    #
    # A fullscreen window in sway covers the whole workspace INCLUDING floating windows, so with the
    # shell fullscreen a terminal opens, exists, reports its geometry, and is `visible: false`.
    # Nothing on screen, no error, and no way to get a terminal on the machine. Being the only TILED
    # window fills the screen just the same and lets everything float above it, which is what the
    # desktop is for.
    for sel in '[app_id="posterchan-desktop"]' '[class="posterchan-desktop"]'; do
      swaymsg "$sel fullscreen disable" >/dev/null 2>&1
      swaymsg "$sel floating disable" >/dev/null 2>&1
      swaymsg "$sel border none" >/dev/null 2>&1
    done
    echo "PosterChan shell window mapped"
    exit 0
  fi
  # Electron can exit before mapping when its SingletonSocket/Lock outlives the process that was
  # just killed. A one-shot launcher then leaves a permanent black screen. Clean only a dead lock
  # (the guarded logic above) and retry; a healthy cold start is left its full 60 seconds.
  if ! kill -0 "$shell_pid" 2>/dev/null && [ "$retries" -lt 3 ]; then
    clear_dead_locks
    retries=$((retries + 1))
    sleep 1
    /usr/local/bin/posterchan --shell --ozone-platform=wayland 9>&- &
    shell_pid=$!
  fi
  i=$((i + 1))
  sleep 0.5
done
echo "PosterChan shell window did not map after retries" >&2
exit 1
