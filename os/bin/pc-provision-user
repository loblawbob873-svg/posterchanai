#!/bin/bash
# Give a Nostr identity a Unix account and a home directory of its own.
#
# PosterChanOS logs in with a KEY, and home directories and permissions are a Unix idea — so
# somebody signing in for the first time needs an account created for them before they have anywhere
# to put anything. This is that step, and it is the only privileged thing the shell asks for.
#
# THE NAME MAPPING IS THE WHOLE PROBLEM. An npub is 63 characters of bech32; a Linux user name is at
# most 32 and may not start with a digit. Truncating is not enough on its own — two different keys
# can share a prefix, and handing one person another person's account is the exact failure this
# exists to prevent. So the name carries a HASH of the full key, not a slice of it: `pc-` plus 16 hex
# characters of sha256(npub). Collisions are then a cryptographic question rather than a naming one,
# and the same key always resolves to the same account on every machine.
#
# Everything here is IDEMPOTENT. It is run on every login, not only the first, because "was this
# account already made" is a question the caller should not have to remember the answer to — and a
# half-made account (user exists, home does not, after a full disk or a pulled plug) is repaired
# rather than treated as done.
set -u

die() { echo "pc-provision-user: $*" >&2; exit 1; }

NPUB="${1:-}"
[ -n "$NPUB" ] || die "usage: pc-provision-user <npub>"

# A public key names an account; it never proves permission to create or claim it.
if [ -n "${SUDO_UID:-}" ]; then
  /usr/local/bin/pc-session-auth verify "$NPUB" provision >/dev/null || exit $?
  unset PC_HOME_ROOT PC_STATE_ROOT PC_SUDOERS_ROOT
fi

# Refuse anything that is not a bech32 npub. This runs as root and its argument comes from a login
# screen; a name built from unvalidated input is how a shell metacharacter becomes a root command.
case "$NPUB" in
  npub1*) ;;
  *) die "not an npub: refusing" ;;
esac
echo "$NPUB" | grep -qE '^npub1[023456789acdefghjklmnpqrstuvwxyz]{58}$' || die "malformed npub: refusing"

HASH=$(printf '%s' "$NPUB" | sha256sum | cut -c1-16)
USERNAME="pc-${HASH}"
# /home in production. Overridable ONLY so the tests can exercise the real script without writing
# into the machine they run on — a script that can only be tested by creating actual users on the
# developer's box is a script that does not get tested.
HOME_ROOT="${PC_HOME_ROOT:-/home}"
HOME_DIR="${HOME_ROOT}/${USERNAME}"

# A name we generated must never land on an account somebody else already has — a system account, or
# one made by hand. `pc-` plus 16 hex is ours by construction, but checking costs nothing and the
# failure it prevents is handing one person another person's files.
if id -u "$USERNAME" >/dev/null 2>&1; then
  EXISTING_HOME=$(getent passwd "$USERNAME" | cut -d: -f6)
  [ "$EXISTING_HOME" = "$HOME_DIR" ] || die "$USERNAME exists with home $EXISTING_HOME — refusing"
else
  useradd --create-home --home-dir "$HOME_DIR" --shell /bin/bash \
          --comment "PosterChan ${NPUB}" "$USERNAME" \
    || die "could not create $USERNAME"
fi

# THE HOME IS 0700, and it is set every time rather than only at creation. `useradd` honours
# /etc/login.defs, which on most systems is 0755 — so every user's files would be readable by every
# other user on the machine, which is precisely what having separate accounts was for.
mkdir -p "$HOME_DIR"
chown "$USERNAME:$USERNAME" "$HOME_DIR"
chmod 0700 "$HOME_DIR"

# The groups a desktop session needs to be usable at all: audio and video for playback and the GPU,
# input for the compositor's devices, netdev for NetworkManager, and kvm for that identity's private
# qemu:///session virtual machines. NOT wheel —
# signing in with a key is not the same as being trusted with root, and a machine anyone may log
# into must not hand every visitor sudo.
# `lp` and `lpadmin` are what make a PRINTER installable. CUPS is installed and running on every
# PosterChanOS machine, its admin pages live on 127.0.0.1:631, and they ask for a system account in
# the CUPS administrative group. Nobody was in it — `lpadmin` existed and was EMPTY — so the only
# account on the machine was refused by the only printer UI there is. Reported as "how are users
# supposed to install a printer".
for g in audio video input netdev render kvm i2c posterchan lp lpadmin; do
  getent group "$g" >/dev/null 2>&1 && gpasswd -a "$USERNAME" "$g" >/dev/null 2>&1
done

# THE FIRST PERSON OWNS THE MACHINE. Claiming is serialized with flock, so two simultaneous first
# logins cannot both become administrators. Unlike a mkdir lock, the kernel releases this lock if
# provisioning is interrupted; one killed login must never prevent every later login from starting.
# The marker records the npub, not merely the generated user name, and later logins remain ordinary.
STATE_ROOT="${PC_STATE_ROOT:-/var/lib/posterchanos}"
SUDOERS_ROOT="${PC_SUDOERS_ROOT:-/etc/sudoers.d}"
mkdir -p "$STATE_ROOT"
command -v flock >/dev/null 2>&1 || die "flock is required to assign the first administrator safely"
exec 9>"$STATE_ROOT/admin.lock" || die "could not open the administrator lock"
flock -x 9 || die "could not lock the administrator claim"
ADMIN=false
if [ ! -s "$STATE_ROOT/admin-npub" ]; then
  printf '%s\n' "$NPUB" >"$STATE_ROOT/admin-npub"
  chmod 0600 "$STATE_ROOT/admin-npub"
  ADMIN=true
elif [ "$(cat "$STATE_ROOT/admin-npub")" = "$NPUB" ]; then
  ADMIN=true
fi
if [ "$ADMIN" = true ]; then
  getent group wheel >/dev/null 2>&1 && gpasswd -a "$USERNAME" wheel >/dev/null 2>&1
  mkdir -p "$SUDOERS_ROOT"
  # Identity accounts deliberately have no Unix password: authentication happened at the Nostr
  # sign-in screen. Requiring PAM here creates an administrator who can never authenticate to sudo.
  # This grant belongs only to the atomically claimed first owner; later identities get no rule.
  printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$USERNAME" >"$SUDOERS_ROOT/posterchan-admin"
  chmod 0440 "$SUDOERS_ROOT/posterchan-admin"
fi

# ── NODATACOW ON THE PROFILE, WHILE IT IS STILL EMPTY ───────────────────────────────────────────
#
# ~/.config/posterchan-desktop is the busiest path on this machine: it is Chromium's profile, and
# the client's LOCAL RELAY lives in the IndexedDB inside it — every event the client stores is a
# small write into a LevelDB file, forever. Measured on the test laptop: 453 MB, and no `C`
# attribute at all, so every one of those writes was copy-on-write and the store was fragmenting
# into tens of thousands of extents.
#
# THIS IS THE ONE MOMENT IT IS FREE. `chattr +C` only takes on a ZERO-LENGTH file; on a file that
# already has extents it is refused or silently does nothing, and `chattr -R +C` over a populated
# tree reports success having converted nothing. What works is +C on the DIRECTORY, which every
# file created inside it inherits — so it has to be set BEFORE the profile exists, which is here,
# as the home is created. Afterwards the only fix is rewriting every file
# (`gentoo.sh btrfs-tweaks-rewrite`), with the app stopped.
#
# btrfs-only, and a failure is not worth a word: on ext4/xfs this tuning does not exist, and the
# account is perfectly fine without it. Nodatacow also disables checksums for these files and opts
# them out of compression — for a browser profile that is the right trade (it is a cache and a
# database, both of which check themselves), and it is why this is one named directory rather than
# the whole home.
PROFILE_DIR="$HOME_DIR/.config/posterchan-desktop"
if [ "$(stat -f -c %T "$HOME_DIR" 2>/dev/null)" = "btrfs" ]; then
  runuser -u "$USERNAME" -- mkdir -p "$PROFILE_DIR"
  runuser -u "$USERNAME" -- chattr +C "$PROFILE_DIR" 2>/dev/null || true
fi

# The identity, recorded where the session can read it back without asking the user again.
# Drop privileges before touching user-controlled descendants (including symlinks).
runuser -u "$USERNAME" -- sh -c 'umask 077; printf "%s\n" "$2" > "$1/.posterchan-npub" && chmod 0600 "$1/.posterchan-npub"' sh "$HOME_DIR" "$NPUB" \
  || die "could not save identity"

# What the caller needs, on stdout, in a form a shell can read without parsing prose.
echo "user=$USERNAME"
echo "home=$HOME_DIR"
echo "uid=$(id -u "$USERNAME")"
echo "admin=$ADMIN"
