#!/bin/sh
# Turn the display off after a while, and let somebody change how long.
#
# WHY A SCRIPT AND NOT A LINE IN THE SWAY CONFIG. `swayidle -w timeout 120 …` in sway's config is
# one number compiled into a file that portage owns: changing it means editing a config that
# etc-update replaces on the next upgrade, and there is nowhere for a person to set it from. This
# reads the number from a file anybody can write and restarts the daemon when it changes, so the
# desktop can offer it as a control later without touching the session config again.
#
# NO DIM STAGE, and that is deliberate rather than an omission. Every laptop dims before it blanks,
# and it is the right behaviour -- but dimming needs a backlight control, and the profile
# deliberately does not carry one: app-misc/brightnessctl is not in the Gentoo tree, and the slider
# in the tray works through a udev rule handing the backlight to the `video` group. Wiring a "dim"
# stage that calls something absent would be a stage that silently does nothing, which is worse than
# not claiming it.
#
# `-w` (wait) matters on the resume side: without it swayidle races the compositor and the screen
# can come back before it has been told to, leaving a display that is on and reported off.
set -eu

# Per identity, writable without sudo, and protected by that identity's 0700 home. A setting under
# /etc looked persistent but `pc-idle set` ran as the desktop user and could never create it.
CONF="${PC_IDLE_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/posterchanos/idle}"
DEFAULT=120                       # two minutes, which is what was asked for
HOLD="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/posterchan-keep-awake"

read_secs() {
    s=""
    [ -r "$CONF" ] && s="$(cat "$CONF" 2>/dev/null | tr -dc '0-9')"
    [ -n "$s" ] || s="$DEFAULT"
    # 0 means never, and is a real answer -- somebody watching a film should be able to say it.
    [ "$s" -ge 0 ] 2>/dev/null || s="$DEFAULT"
    echo "$s"
}

# WHO ACTUALLY TURNS THE SCREEN OFF, AND WHY THIS FUNCTION HAS TO EXIST.
#
# This script used to BE the mechanism, when the session was Sway: the watcher counted and then
# ran the compositor's power command itself. Under Wayfire the power action belongs to the
# compositor's own `idle` plugin, so the watcher below runs `true` on both edges -- it is only the
# protocol watcher, and the number has to reach the plugin instead.  That left the plugin's
# `dpms_timeout` as the ONLY number that mattered, and it comes from /etc/wayfire.ini, which no
# user setting writes.  So on Wayfire every control here was decoration: Settings -> Power ->
# "Turn display off when idle" wrote a file nothing read, "Never" left a compositor still blanking
# at two minutes, and Keep awake killed a watcher that was not doing anything anyway -- so a film
# went black mid-scene with the switch showing On.  Each failure is silent, and `pc-idle status`
# agreed with the setting rather than with the screen.
#
# `wayfire/set-config-options` changes it live, so the number lands where the decision is made.
# NEVER is -1, not 0: -1 is the plugin's own documented "disabled" default, and 0 is a timeout of
# zero seconds -- the opposite of what the person asked for, and it would blank the screen instantly.
wf_dpms() {
    command -v python3 >/dev/null 2>&1 || return 0
    python3 - "${1:--1}" <<'PY' >/dev/null 2>&1 || true
import glob, json, os, socket, struct, sys

secs = int(sys.argv[1])
path = os.environ.get("WAYFIRE_SOCKET") or ""
if not path:
    # A control pressed in the shell inherits the session environment, but a helper re-run by hand
    # or from a cron-like context does not. Discover it the way the desktop's own backend does.
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    found = sorted(glob.glob(os.path.join(runtime, "wayfire-wayland-*.socket")),
                   key=lambda p: os.stat(p).st_mtime, reverse=True)
    path = found[0] if found else ""
if not path:
    raise SystemExit(0)
s = socket.socket(socket.AF_UNIX)
s.settimeout(2.0)
s.connect(path)
# BOTH TIMERS, or "never" is not never. Wayfire's idle plugin also carries a
# `screensaver_timeout` (3600s by default) that blanks the screen to black without powering the
# outputs down -- so setting only the DPMS timeout left Keep Awake and "Never" still going black
# after an hour, with the monitors on and nothing in any log to say why.
body = json.dumps({"method": "wayfire/set-config-options",
                   "data": {"idle/dpms_timeout": secs,
                            "idle/screensaver_timeout": -1}}).encode()
s.sendall(struct.pack("<I", len(body)) + body)
s.recv(4096)
PY
}

# The number the compositor is really counting to, which is the only one worth reporting on Wayfire.
wf_dpms_get() {
    command -v python3 >/dev/null 2>&1 || return 1
    python3 - <<'PY' 2>/dev/null
import glob, json, os, socket, struct

path = os.environ.get("WAYFIRE_SOCKET") or ""
if not path:
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    found = sorted(glob.glob(os.path.join(runtime, "wayfire-wayland-*.socket")),
                   key=lambda p: os.stat(p).st_mtime, reverse=True)
    path = found[0] if found else ""
if not path:
    raise SystemExit(1)
s = socket.socket(socket.AF_UNIX)
s.settimeout(2.0)
s.connect(path)
body = json.dumps({"method": "wayfire/get-config-option",
                   "data": {"option": "idle/dpms_timeout"}}).encode()
s.sendall(struct.pack("<I", len(body)) + body)
head = s.recv(4)
n = struct.unpack("<I", head)[0]
buf = b""
while len(buf) < n:
    buf += s.recv(n - len(buf))
print(json.loads(buf).get("value", ""))
PY
}

# Seconds as the compositor wants them: 0 ("never", as a person says it) is -1 to the idle plugin.
wf_apply() {
    [ -n "${WAYFIRE_SOCKET:-}" ] || [ -n "$(ls "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/wayfire-wayland-*.socket 2>/dev/null)" ] || return 0
    if [ -e "$HOLD" ] || [ "${1:-0}" -le 0 ] 2>/dev/null; then wf_dpms -1; else wf_dpms "$1"; fi
}

case "${1:-run}" in
  hold)
      case "${2:-status}" in
        on)  : >"$HOLD"; wf_dpms -1; pkill -x swayidle 2>/dev/null || true; echo on ;;
        off) rm -f "$HOLD"; wf_apply "$(read_secs)"; pkill -x swayidle 2>/dev/null || true
             setsid "$0" run >/dev/null 2>&1 & echo off ;;
        status) [ -e "$HOLD" ] && echo on || echo off ;;
        *) echo "usage: pc-idle hold on|off|status" >&2; exit 2 ;;
      esac
      ;;
  set)
      # `pc-idle set 300`, or `pc-idle set 0` for never.
      n="$(echo "${2:-}" | tr -dc '0-9')"
      [ -n "$n" ] || { echo "usage: pc-idle set <seconds>   (0 = never)" >&2; exit 2; }
      mkdir -p "$(dirname "$CONF")"
      echo "$n" >"$CONF"
      # Restart the watcher so the new number takes effect now rather than at the next login.
      wf_apply "$n"
      pkill -x swayidle 2>/dev/null || true
      [ "$n" -gt 0 ] && setsid "$0" run >/dev/null 2>&1 &
      echo "display turns off after ${n}s"
      ;;
  get)
      read_secs
      ;;
  status)
      # WHY IS THE SCREEN STILL ON? Four different causes, three of which leave every other
      # symptom looking perfectly healthy, so guessing between them from the outside does not
      # work -- reported as "my desktop monitor has been on a long time" with a timeout that was
      # set correctly the whole time.
      secs="$(read_secs)"
      # Asked ONCE, up front: two branches below read it, and under `set -u` a value computed
      # after the first of them is an unbound variable that takes the whole report down.
      live="$(wf_dpms_get 2>/dev/null || true)"
      if [ "$secs" -eq 0 ] 2>/dev/null; then
          echo "timeout:    never (0) -- pc-idle set 120 to turn the display off again"
      else
          echo "timeout:    ${secs}s"
      fi
      if [ -e "$HOLD" ]; then
          echo "keep-awake: ON -- something asked to hold the screen awake; pc-idle hold off"
      else
          echo "keep-awake: off"
      fi
      if pgrep -x swayidle >/dev/null 2>&1; then
          echo "swayidle:   running (pid $(pgrep -x swayidle | tr '\n' ' ' | sed 's/ $//'))"
      elif [ "$secs" -eq 0 ] 2>/dev/null; then
          echo "swayidle:   not running, which is correct while the timeout is never"
      elif [ -n "$live" ] && [ "$live" != "-1" ] && [ "$live" != "0" ]; then
          # On Wayfire swayidle is only the protocol watcher; the compositor's own idle plugin
          # performs the blanking. Saying "the display never turns off" here would contradict the
          # compositor line directly below, which is measured.
          echo "swayidle:   not running -- on Wayfire the compositor performs the blanking itself"
      else
          echo "swayidle:   NOT RUNNING -- nothing is watching, so the display never turns off"
      fi
      # THE CAUSE THAT HIDES FROM EVERY CHECK ABOVE. An idle inhibitor stops the seat being reported
      # idle at all, so the timer does not fire LATE -- it never fires, while everything above reads
      # healthy and the configured timeout looks right. Chromium takes one for any page holding a
      # screen wake lock or playing video, and the shell IS Chromium.
      if [ -n "$live" ]; then
          # The compositor's own number, so a setting that never reached it is visible here rather
          # than only on the screen. -1/0 is the plugin's "disabled".
          case "$live" in
            -1|0) echo "compositor: Wayfire idle DPMS disabled" ;;
            *)    echo "compositor: Wayfire blanks after ${live}s" ;;
          esac
          if [ "$secs" -gt 0 ] 2>/dev/null && [ ! -e "$HOLD" ] && [ "$live" != "$secs" ]; then
              echo "            MISMATCH -- the compositor is not counting to the configured ${secs}s"
          fi
      fi
      # Wayfire 0.10 exposes no idle-inhibitor listing, so this cannot be answered here rather than
      # answered wrongly. (Sway could be asked, and this walked its tree for the app holding one;
      # there is no Sway now, and no equivalent to walk.)
      echo "inhibitors: not enumerable on Wayfire (its IPC does not expose idle inhibitors)"
      ;;
  run|*)
      # Applied BEFORE the keep-awake and never checks below, because both of those exit: a
      # compositor that starts from /etc/wayfire.ini would otherwise keep blanking at the packaged
      # default while the saved setting said never.
      wf_apply "$(read_secs)"
      [ ! -e "$HOLD" ] || exit 0
      SECS="$(read_secs)"
      [ "$SECS" -gt 0 ] || exit 0        # never: nothing to run, and no daemon left behind
      # One instance. This is re-run whenever the session restarts, and two swayidles fight over the
      # same screen -- one turning it off while the other turns it on.
      pkill -x swayidle 2>/dev/null || true
      # Wayfire's idle plugin owns DPMS (and fullscreen inhibit); wf_apply above has already given it
      # the number. swayidle stays as the PROTOCOL watcher -- it is what holds the seat's idle
      # accounting and observes inhibitors -- so both edges are deliberately no-ops rather than a
      # second thing racing the compositor to turn the screen off.
      exec swayidle -w timeout "$SECS" true resume true
      ;;
esac
