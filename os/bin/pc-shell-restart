#!/bin/sh
# Replace the PosterChan desktop process and load one coherent installed build.
#
# Do not try to infer whether an update happened by comparing /proc/<pid>/exe with the executable
# on disk. Electron itself is commonly byte-identical between PosterChan releases while
# resources/app.asar changed. In that case the executable comparison says "current", a renderer
# reload mixes a new page with the OLD main/preload/protocol code, and only a reboot appears to pick
# up the update. Ctrl+Alt+Backspace is the explicit recovery/restart shortcut, so correctness wins:
# always replace the process. The launcher serializes startup, removes dead singleton locks, and
# proves that the replacement surfaces mapped.
set -u
pattern='[/]opt/posterchan/'
# The launcher's path, overridable so this script can be RUN by a test rather than read by one.
# The default is absolute on purpose: this is driven from a key binding and from sway, neither of
# which is guaranteed a useful PATH.
: "${PC_SHELL_START:=/usr/local/bin/pc-shell-start}"
pids=$(pgrep -f "$pattern" 2>/dev/null)

if [ -n "$pids" ]; then
	# Stop it and fall through to the full launcher, which owns stale-lock
	# cleanup, environment recovery, retries and the proof that a replacement surface mapped.
	# TERM first and a bounded wait: Electron writes its singleton lock on the way out, and killing
	# it outright leaves the lock for the launcher to clean up as a "dead" one it has to guess about.
	kill $pids 2>/dev/null
	n=0
	while [ "$n" -lt 50 ]; do
		alive=0
		for pid in $pids; do kill -0 "$pid" 2>/dev/null && alive=1; done
		[ "$alive" -eq 1 ] || break
		sleep 0.1
		n=$((n + 1))
	done
	# Only the exact shell processes measured above. A pattern kill can catch a newly launched
	# replacement (or an unrelated command line containing /opt/posterchan) during this window.
	for pid in $pids; do kill -KILL "$pid" 2>/dev/null; done
fi

# No shell exists to receive the recovery tick. The full launcher owns stale-lock cleanup,
# environment recovery, retries, serialization and proof that a replacement surface mapped.
exec "$PC_SHELL_START"
