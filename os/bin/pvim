WORDMARK = (
    '██████╗ ██╗   ██╗██╗███╗   ███╗',
    '██╔══██╗██║   ██║██║████╗ ████║',
    '██████╔╝██║   ██║██║██╔████╔██║',
    '██╔═══╝ ╚██╗ ██╔╝██║██║╚██╔╝██║',
    '██║      ╚████╔╝ ██║██║ ╚═╝ ██║',
    '╚═╝       ╚═══╝  ╚═╝╚═╝     ╚═╝',
)


def lerp(a, b, t):
    t = max(0.0, min(1.0, t))
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


def neon(t):
    """0 -> 1 along the theme's gradient (its stops evenly spaced): what everything flashy is drawn in."""
    stops = THEME['grad']
    t = max(0.0, min(1.0, t)) * (len(stops) - 1)
    i = min(int(t), len(stops) - 2)
    return lerp(stops[i], stops[i + 1], t - i)


def xterm256(r, g, b):
    """The nearest xterm-256 colour (the 6x6x6 cube or the grey ramp), as ptop computes it."""
    steps = (0, 95, 135, 175, 215, 255)
    ci = [min(range(6), key=lambda i: abs(steps[i] - v)) for v in (r, g, b)]
    cube = tuple(steps[i] for i in ci)

    def err(c):
        return sum((x - y) ** 2 for x, y in zip(c, (r, g, b)))
    gi = min(range(24), key=lambda i: err((8 + 10 * i,) * 3))
    if err((8 + 10 * gi,) * 3) < err(cube):
        return 232 + gi
    return 16 + 36 * ci[0] + 6 * ci[1] + ci[2]


def color_mode():
    """truecolor, or 256 where the terminal cannot take 24-bit colour (ptop's rule: GNU screen, the Linux console)."""
    term = os.environ.get('TERM', '')
    if (os.environ.get('STY') and not os.environ.get('TMUX')) or term.startswith('screen'):
        return '256'
    if os.environ.get('COLORTERM', '').lower() in ('truecolor', '24bit'):
        return 'truecolor'
    if term in ('linux', 'dumb') or term.startswith(('vt', 'ansi', 'cons')):
        return '256'
    return 'truecolor'


_OUTLINE = {
    'python': re.compile(r'^\s*(?:async\s+)?(?:def|class)\s+(\w+)'),
    'js': re.compile(r'^\s*(?:export\s+)?(?:async\s+)?(?:function\s*\*?\s*(\w+)|class\s+(\w+)|(?:const|let|var)\s+(\w+)\s*=\s*(?:async\s*)?(?:function|\())'),
    'sh': re.compile(r'^\s*(?:function\s+)?([A-Za-z_][\w-]*)\s*\(\)'),
    'c': re.compile(r'^[A-Za-z_][\w \t\*]*?\b(\w+)\s*\([^;]*$'),
    'rust': re.compile(r'^\s*(?:pub\s+)?(?:fn|struct|enum|impl|trait)\s+(\w+)'),
    'go': re.compile(r'^func\s+(?:\([^)]*\)\s*)?(\w+)'),
    'markdown': re.compile(r'^(#{1,6}\s+.+)'),
    'conf': re.compile(r'^\s*\[([^\]]+)\]'),
}


def outline(lines, ft):
    """[(line index, label)] -- functions, classes, headings or sections, for the OUTLINE panel."""
    rx = _OUTLINE.get(ft)
    if not rx:
        return []
    out = []
    for i, l in enumerate(lines[:20000]):
        m = rx.match(l)
        if m:
            name = next((x for x in m.groups() if x), '')
            if name:
                out.append((i, name.strip()[:60]))
    return out


def human(n):
    for unit in ('B', 'KB', 'MB', 'GB'):
        if n < 1024 or unit == 'GB':
            return ('%d %s' % (n, unit)) if unit == 'B' else ('%.1f %s' % (n, unit))
        n /= 1024.0


_BUILT_RIM = ((0, 240, 255), (57, 255, 20))      # what `make_ptop_logo.py 36 00f0ff,39ff14` drew the rim in


def logo_cells(logo=LOGO):
    """The half-block art: rows of (char, fg rgb or None, bg rgb or None), two pixel rows per terminal row, its neon
    rim recoloured to the theme's (a rim pixel is the one that equals the built rim's colour for its row)."""
    H = max(1, len(logo) - 1)

    def px(row, x, y=0):
        v = row[x:x + 6]
        if v == '......':
            return None
        c = tuple(int(v[i:i + 2], 16) for i in (0, 2, 4))
        built = lerp(_BUILT_RIM[0], _BUILT_RIM[1], y / H)
        if all(abs(a - b) <= 3 for a, b in zip(c, built)):
            return lerp(THEME['rim'][0], THEME['rim'][1], y / H)
        return c
    out = []
    for y in range(0, len(logo), 2):
        top, bot = logo[y], logo[y + 1] if y + 1 < len(logo) else '.' * len(logo[y])
        row = []
        for x in range(0, len(top), 6):
            t, b = px(top, x, y), px(bot, x, y + 1)
            row.append(('▀', t, b) if t and b else ('▀', t, None) if t else ('▄', b, None) if b else (' ', None, None))
        out.append(row)
    return out


# ── the screen ───────────────────────────────────────────────────────────────────────────────────────────────
class Screen:
    """Neon on black: cyan cursor line and line numbers, magenta mode badge, syntax in the PosterChan palette."""

    def __init__(self, scr, ed):
        self.scr, self.ed = scr, ed
        self.pending_input = []
        curses.curs_set(1)
        scr.keypad(True)
        curses.raw()
        curses.noecho()
        try:
            curses.set_escdelay(25)
        except AttributeError:
            pass
        self.colors = {}
        self.rich = False
        self.truecolor = color_mode() == 'truecolor'
        self._raw_art = None
        self._art_drawn = False
        self._size = None
        self._pairs = {}
        self._next_pair = 1
        self.t0 = time.monotonic()
        self._theme = None
        self.setup_colors()
        # bracketed paste: a pasted block arrives as one insert, not as typed keys (no autoindent staircase)
        sys.stdout.write('\x1b[?2004h')
        sys.stdout.flush()

    _FALLBACK8 = {
        'text': ('WHITE', None), 'num': ('BLUE', None), 'numcur': ('CYAN', None), 'comment': ('WHITE', None),
        'string': ('CYAN', None), 'number': ('BLUE', None), 'keyword': ('MAGENTA', None), 'func': ('CYAN', None),
        'add': ('GREEN', None), 'del': ('RED', None), 'tilde': ('BLUE', None), 'special': ('BLUE', None),
        'status': ('CYAN', 'BLACK'), 'statusdim': ('WHITE', 'BLACK'), 'visual': ('WHITE', 'BLUE'), 'search': ('BLACK', 'CYAN'),
        'err': ('RED', None), 'msg': ('CYAN', None), 'logo1': ('CYAN', None), 'logo2': ('BLUE', None),
        'mode_NORMAL': ('BLACK', 'CYAN'), 'mode_INSERT': ('BLACK', 'MAGENTA'), 'mode_REPLACE': ('WHITE', 'RED'),
        'mode_VISUAL': ('WHITE', 'BLUE'), 'mode_V-LINE': ('WHITE', 'BLUE'), 'mode_COMMAND': ('BLACK', 'WHITE'),
        'cursorline': ('WHITE', None),
    }

    def setup_colors(self):
        """(Re)build every colour pair from the current THEME -- at start, and on `:set theme=`."""
        self._theme = THEME
        self.colors, self._pairs = {}, {}
        if not curses.has_colors():
            return
        curses.start_color()
        try:
            curses.use_default_colors()
            bg = -1
        except curses.error:
            bg = curses.COLOR_BLACK
        rich = curses.COLORS >= 256
        n = 1
        for k, (fg, b) in THEME['p256'].items():
            f8, b8 = self._FALLBACK8[k]
            f = fg if rich else getattr(curses, 'COLOR_' + f8)
            bb = (b if b is not None else bg) if rich else (getattr(curses, 'COLOR_' + b8) if b8 else bg)
            try:
                curses.init_pair(n, f, bb)
                self.colors[k] = curses.color_pair(n)
            except curses.error:
                self.colors[k] = 0
            n += 1
        self.rich = rich and curses.COLOR_PAIRS > 512
        self._next_pair = n
        if self.rich:
            # the current line: every text colour again on a raised background
            for k in ('text', 'comment', 'string', 'number', 'keyword', 'func', 'add', 'del', 'special'):
                self.colors['cl:' + k] = self.rgb_attr(None, None, fg256=THEME['p256'][k][0], bg256=THEME['p256']['cursorline'][1])

    def close(self):
        sys.stdout.write('\x1b]112\x07' if self.rich else '')
        sys.stdout.write('\x1b[?2004l')
        sys.stdout.flush()

    def attr(self, k, extra=0):
        return self.colors.get(k, 0) | extra

    def rgb_attr(self, fg, bg=None, extra=0, fg256=None, bg256=None):
        """A colour pair for any foreground/background (rgb, or xterm-256 index), made once and kept."""
        if not self.rich and fg256 is None:
            return extra
        f = fg256 if fg256 is not None else (xterm256(*fg) if fg else -1)
        b = bg256 if bg256 is not None else (xterm256(*bg) if bg else -1)
        key = (f, b)
        if key not in self._pairs:
            if self._next_pair >= min(curses.COLOR_PAIRS, 256):   # curses attributes carry 8 bits of pair
                return extra
            try:
                curses.init_pair(self._next_pair, f, b)
                self._pairs[key] = curses.color_pair(self._next_pair)
                self._next_pair += 1
            except curses.error:
                self._pairs[key] = 0
        return self._pairs[key] | extra

    def _sgr(self, rgb, bg=False):
        if self.truecolor:
            return '\x1b[%d;2;%d;%d;%dm' % (48 if bg else 38, rgb[0], rgb[1], rgb[2])
        return '\x1b[%d;5;%dm' % (48 if bg else 38, xterm256(*rgb))

    def paint_art(self, cursor):
        """Write the start screen's portrait straight to the terminal, after curses drew the frame."""
        y0, x0, rows, scan, aw = self._raw_art
        out = []
        for yy, row in enumerate(rows):
            for xx, (ch, fg, bg) in enumerate(row):
                if ch == ' ':
                    continue
                out.append('\x1b[%d;%dH%s%s%s\x1b[0m' % (y0 + yy + 1, x0 + xx + 1, self._sgr(fg), self._sgr(bg, True) if bg else '', ch))
        if scan:
            # the scanline only where her NEXT row is drawn: those cells are painted over on the next frame, and a
            # line across her transparent cells stayed on screen for good (curses never knew it was there)
            for xx, (ch, _, _) in enumerate(scan):
                if ch != ' ':
                    out.append('\x1b[%d;%dH\x1b[1m%s▀\x1b[0m' % (y0 + len(rows) + 1, x0 + xx + 1, self._sgr(THEME['b'])))
        out.append('\x1b[%d;%dH' % (cursor[0] + 1, cursor[1] + 1))
        sys.stdout.write(''.join(out))
        sys.stdout.flush()

    def animating(self):
        """The start screen's reveal: under half a second, only on a bare `pvim`, and any key ends it."""
        return self.rich and self.ed.intro and time.monotonic() - self.t0 < 0.55

    def put(self, y, x, s, a=0):
        h, w = self.scr.getmaxyx()
        if y < 0 or y >= h or x >= w:
            return
        s = s[:max(0, w - x - (1 if y == h - 1 else 0))]
        try:
            self.scr.addstr(y, x, s, a)
        except curses.error:
            pass

    # ── the dashboard: ptop's look -- a pixel wordmark header and titled neon panels ────────────────────────────────
    def col(self, rgb, key='text', extra=0):
        """An rgb colour where the terminal has 256 colours, else the nearest named one from the palette."""
        return self.rgb_attr(rgb, None, extra) if self.rich else self.attr(key, extra)

    def box(self, y, x, hgt, wid, title, rgb, key):
        """A ptop panel: a frame in one neon colour with `─ TITLE ─` set into its top edge."""
        if hgt < 2 or wid < 4:
            return
        c = self.col(rgb, key)
        self.put(y, x, '┌' + '─' * (wid - 2) + '┐', c)
        for yy in range(y + 1, y + hgt - 1):
            self.put(yy, x, '│', c)
            self.put(yy, x + wid - 1, '│', c)
        self.put(y + hgt - 1, x, '└' + '─' * (wid - 2) + '┘', c)
        if title:
            t = title[:max(0, wid - 6)]
            self.put(y, x + 2, ' ' + t + ' ', self.col(rgb, key, curses.A_BOLD))

    def file_stats(self):
        """Words/bytes/outline, recomputed only when the text changed."""
        ed = self.ed
        key = (id(ed.lines), ed.tick, len(ed.lines), ed.path)
        if getattr(self, '_stats_key', None) != key:
            text_bytes = sum(len(l.encode('utf-8', 'surrogateescape')) + 1 for l in ed.lines[:200000])
            words = sum(len(l.split()) for l in ed.lines[:200000])
            self._stats = {'bytes': text_bytes, 'words': words, 'outline': outline(ed.lines, ed.ft)}
            self._stats_key = key
        return self._stats

    def draw_header(self, w):
        """Row 0-1: POSTERCHAN VIM in ptop's pixel font, cyan -> green, and the live file line beside it."""
        art = ('█▀█ █▀█ █▀ ▀█▀ █▀▀ █▀█ █▀▀ █ █ ▄▀█ █▄ █   █ █ █ █▀▄▀█',
               '█▀▀ █▄█ ▄█  █  ██▄ █▀▄ █▄▄ █▀█ █▀█ █ ▀█   ▀▄▀ █ █ ▀ █')
        n = len(art[0])
        if w >= n + 2:
            for i, row in enumerate(art):
                for j, ch in enumerate(row):
                    if ch != ' ':
                        self.put(i, j, ch, self.col(neon(j / (n - 1)), 'logo1' if j < n // 2 else 'logo2', curses.A_BOLD))
            x = n + 3
        else:
            self.put(0, 0, 'PVIM', self.col(CYAN, 'logo1', curses.A_BOLD))
            x = 6
        ed = self.ed
        st = self.file_stats()
        clock = time.strftime('%H:%M:%S')
        if x + 20 < w:
            name = ed.path or '[No Name]'
            self.put(0, x, '// ', self.col(TEAL, 'num'))
            self.put(0, x + 3, name[-max(1, w - x - 16):], self.col((235, 245, 255), 'text', curses.A_BOLD))
            if ed.modified:
                self.put(0, min(w - 12, x + 3 + len(name[-max(1, w - x - 16):]) + 1), '[+]', self.col(GREEN, 'add', curses.A_BOLD))
            self.put(0, w - len(clock) - 1, clock, self.col(CYAN, 'msg', curses.A_BOLD))
            ic = THEME['info']
            info = [(ed.ft or 'text', ic[0]), ('%d lines' % len(ed.lines), ic[1]), (human(st['bytes']), ic[2]),
                    ('dos' if ed.info.crlf else 'unix', ic[3]), ('utf-8', ic[4])]
            xx = x
            for i, (txt, c) in enumerate(info):
                if xx + len(txt) + 3 >= w:
                    break
                self.put(1, xx, txt, self.col(c, 'msg'))
                xx += len(txt)
                if i < len(info) - 1:
                    self.put(1, xx, '  ·  ', self.col(TEAL, 'num'))
                    xx += 5

    def draw(self):
        ed, scr = self.ed, self.scr
        if self._theme is not THEME:
            self.setup_colors()
            scr.clearok(True)
        h, w = scr.getmaxyx()
        ed.rows, ed.cols = h, w
        # curses does not know about the raw portrait: when it goes away (or the window resizes) repaint everything
        if (self._art_drawn and not (ed.intro and ed.lines == [''] and not ed.modified)) or self._size != (h, w):
            self.scr.clearok(True)
            self._art_drawn = False
        self._size = (h, w)
        self._raw_art = None
        intro = ed.intro and ed.lines == [''] and not ed.modified
        # THE LAYOUT. A dashboard needs room: below 60x16 (or on the start screen) the text gets the whole terminal.
        dash = not intro and w >= 60 and h >= 16
        side = dash and w >= 104 and h >= 22
        if dash:
            ey, ex = 2, 0                                   # the EDITOR panel's frame
            eh, ew = h - 4, w - (32 if side else 0)
            Y0, X0, VR, VC = ey + 1, ex + 1, eh - 2, ew - 3  # its text area (one column kept for the minimap)
        else:
            Y0, X0, VR, VC = 0, 0, h - 2, w
        ed.view_rows, ed.view_cols = VR, VC
        if not getattr(ed, '_keep_top', False):
            ed.scroll_into_view()
        ed._keep_top = False
        scr.erase()
        if getattr(ed, 'help_text', None):
            for i, l in enumerate(ed.help_text[:h - 1]):
                self.put(i, 0, l, self.attr('logo1' if i == 0 else 'text', curses.A_BOLD if i == 0 else 0))
            self.put(h - 1, 0, ' press q / Esc to close help ', self.attr('mode_COMMAND', curses.A_BOLD))
            scr.move(h - 1, 0)
            scr.refresh()
            return
        if dash:
            self.draw_header(w)
            name = os.path.basename(ed.path) if ed.path else '[No Name]'
            self.box(ey, ex, eh, ew, 'EDITOR // ' + name + (' [+]' if ed.modified else ''), THEME['editor'], 'logo1')
            if side:
                self.draw_side(2, ew, h - 4, w - ew)
        g = ed.gutter()
        tw = VC - g
        ts = ed.opts['tabstop']
        vis = None
        if ed.mode in (ed.VISUAL, ed.VLINE):
            vis = ed.vrange()
        hl_rx = None
        if ed.opts['hlsearch'] and ed.search and not ed.hl_off:
            try:
                hl_rx = vim_regex(ed.search[0], ed.opts['ignorecase'], ed.opts['smartcase'])
            except re.error:
                hl_rx = None
        if ed.mode == ed.CMDLINE and ed.cmd_kind in '/?' and ed.cmdline:
            try:
                hl_rx = vim_regex(ed.cmdline, ed.opts['ignorecase'], ed.opts['smartcase'])
            except re.error:
                pass
        rows = VR
        if intro:
            self.draw_intro(h, w)
        for sy in range(rows):
            r = ed.top + sy
            Y = Y0 + sy
            if r >= len(ed.lines):
                self.put(Y, X0, '~', self.rgb_attr(lerp(THEME['tilde'][0], THEME['tilde'][1], sy / max(1, rows - 1))) or self.attr('tilde'))
                continue
            line = ed.lines[r]
            if g:
                if ed.opts['relativenumber'] and r != ed.row:
                    label = str(abs(r - ed.row))
                else:
                    label = str(r + 1)
                if self.rich:
                    # the numbers GLOW around the cursor: bright cyan on its line, fading through blue to deep teal
                    d = min(1.0, abs(r - ed.row) / 12)
                    na = self.rgb_attr(lerp(THEME['num_near'], THEME['num_far'], d), None, curses.A_BOLD if r == ed.row else 0)
                    if r == ed.row:
                        na = self.rgb_attr(THEME['num_near'], None, curses.A_BOLD)
                else:
                    na = self.attr('numcur' if r == ed.row else 'num', curses.A_BOLD if r == ed.row else 0)
                self.put(Y, X0, label.rjust(g - 1) + ' ', na)
                if r == ed.row and self.rich:
                    self.put(Y, X0, '▌', self.rgb_attr(THEME['a'], None, curses.A_BOLD))
            # per-char attributes; the current line is drawn on a raised background (not while selecting)
            n = len(line)
            cl = self.rich and r == ed.row and not vis and ed.mode != ed.CMDLINE
            A = (lambda k: self.colors.get('cl:' + k, self.attr(k))) if cl else self.attr
            if cl:
                self.put(Y, X0 + g, ' ' * max(0, tw), A('text'))
            attrs = [A('text')] * n
            if ed.opts['syntax'] and ed.ft and n < 4000:
                for s_, e, grp in highlight(line, ed.ft):
                    a_ = A(grp)
                    for j in range(s_, min(e, n)):
                        attrs[j] = a_
            if self.rich and ed.opts['syntax'] and n < 4000:
                # rainbow brackets: cyan, green, blue by depth (counted from this line's start)
                depth, cols3 = 0, (CYAN, GREEN, BLUE)
                for j, ch in enumerate(line):
                    if ch in '([{':
                        attrs[j] = self.rgb_attr(cols3[depth % 3], None, curses.A_BOLD)
                        depth += 1
                    elif ch in ')]}':
                        depth = max(0, depth - 1)
                        attrs[j] = self.rgb_attr(cols3[depth % 3], None, curses.A_BOLD)
            if hl_rx is not None and n < 4000:
                try:
                    for m in hl_rx.finditer(line):
                        for j in range(m.start(), max(m.end(), m.start() + 1)):
                            if j < n:
                                attrs[j] = self.attr('search')
                except re.error:
                    pass
            if vis:
                (a1, b1), (a2, b2) = vis
                if a1 <= r <= a2:
                    if ed.mode == ed.VLINE:
                        lo, hi = 0, n
                    else:
                        lo = b1 if r == a1 else 0
                        hi = (b2 + 1) if r == a2 else n
                    for j in range(lo, min(hi, n)):
                        attrs[j] = self.attr('visual')
            # indent guides: a dim ┊ at each shiftwidth inside the leading whitespace
            if self.rich and line[:1] in (' ', '\t') and ed.left == 0:
                ind = display_cols(leading_ws(line), ts)[-1]
                sw = max(1, ed.opts['shiftwidth'])
                for gx in range(sw, ind, sw):
                    self.put(Y, X0 + g + gx, '┊', A('special') if cl else self.rgb_attr(lerp(THEME['dim'], (0, 0, 0), .5)))
            x = 0
            left = ed.left
            for j, c in enumerate(line):
                if c == '\t':
                    width = ts - x % ts
                    glyph = ('›' + ' ' * (width - 1)) if ed.opts['list'] else None
                    a = self.attr('special') if ed.opts['list'] else attrs[j]
                else:
                    o = ord(c)
                    if o < 32 or o == 127:
                        glyph, a = '^' + chr((o + 64) % 128), self.attr('special')
                    elif 0xDC80 <= o <= 0xDCFF:
                        glyph, a = '<%02x>' % (o - 0xDC00), self.attr('special')
                    elif c == ' ':
                        glyph, a = None, attrs[j]              # a space draws nothing: the indent guide shows through
                    else:
                        glyph, a = c, attrs[j]
                    width = char_width(c) if c != ' ' else 1
                if x + width > left and x - left < tw:
                    sx = g + x - left
                    if sx >= g and glyph is not None:
                        self.put(Y, X0 + sx, glyph, a)
                x += width
                if x - left >= tw:
                    break
            if ed.opts['list'] and x - left < tw:
                self.put(Y, X0 + g + max(0, x - left), '¬', self.attr('special'))
            if left > 0 and line:
                self.put(Y, X0 + g, '«', self.attr('special'))
        if dash:
            self.draw_minimap(Y0, X0 + VC, VR)
        self.draw_status(h, w)
        # cursor
        if ed.mode == ed.CMDLINE:
            pre = ed.cmd_kind + ed.cmdline[:ed.cmd_cur]
            cx = sum(char_width(c) for c in pre)
            try:
                scr.move(h - 1, min(w - 1, cx))
            except curses.error:
                pass
        else:
            cy = Y0 + ed.row - ed.top
            cx = X0 + g + ed.disp_col() - ed.left
            try:
                scr.move(max(Y0, min(Y0 + rows - 1, cy)), max(0, min(w - 1, cx)))
            except curses.error:
                pass
        try:
            curses.curs_set(1)
        except curses.error:
            pass
        out = '\x1b[%d q' % (5 if ed.mode in (ed.INSERT,) else 3 if ed.mode == ed.REPLACE else 2)
        if self.rich:   # the terminal cursor itself in neon: cyan, green while typing (OSC 12; reset on exit)
            out += '\x1b]12;%s\x07' % THEME['cursor'][1 if ed.mode in (ed.INSERT, ed.REPLACE) else 0]
        sys.stdout.write(out)
        sys.stdout.flush()
        scr.refresh()
        if self._raw_art:
            self.paint_art(scr.getyx())

    def draw_minimap(self, y0, x, rows):
        """The panel's right edge: the whole file's shape, one cell per slice, the visible part lit cyan."""
        ed = self.ed
        n = len(ed.lines)
        per = max(1.0, n / max(1, rows))
        for i in range(rows):
            a, b = int(i * per), int((i + 1) * per)
            if a >= n:
                break
            sl = ed.lines[a:max(b, a + 1)]
            dens = sum(len(l.strip()) for l in sl) / (max(1, len(sl)) * 40)
            ch = ' ' if dens == 0 else '░' if dens < .25 else '▒' if dens < .6 else '▓'
            seen = not (b <= ed.top or a >= ed.top + rows)
            if seen:
                self.put(y0 + i, x, ch if ch != ' ' else '▏', self.col(THEME['here'], 'logo1', curses.A_BOLD))
            elif ch != ' ':
                self.put(y0 + i, x, ch, self.col(THEME['mm_off'], 'num'))

    def draw_side(self, y, x, hgt, wid):
        """FILE (yellow) above OUTLINE (violet), ptop-style."""
        ed = self.ed
        st = self.file_stats()
        fh = min(10, hgt // 2)
        Y = THEME['file']
        self.box(y, x, fh, wid, 'FILE', Y, 'string')
        rows = [('path', os.path.dirname(os.path.abspath(ed.path)) if ed.path else '-'),
                ('type', ed.ft or 'text'), ('lines', str(len(ed.lines))), ('words', str(st['words'])),
                ('size', human(st['bytes'])), ('ending', 'dos' if ed.info.crlf else 'unix'),
                ('state', ('modified' if ed.modified else 'saved') + (' · read-only' if ed.info.readonly else ''))]
        for i, (k, v) in enumerate(rows[:fh - 2]):
            self.put(y + 1 + i, x + 2, k.ljust(7), self.col(lerp(Y, (60, 60, 70), .45), 'num'))
            vv = v if len(v) <= wid - 12 else '…' + v[-(wid - 13):]
            self.put(y + 1 + i, x + 9, vv, self.col(lerp(Y, (255, 255, 255), .7), 'text', curses.A_BOLD if k == 'state' and ed.modified else 0))
        oy, oh = y + fh, hgt - fh
        V = THEME['outline']
        self.box(oy, x, oh, wid, 'OUTLINE', V, 'special')
        items = st['outline']
        if not items:
            self.put(oy + 1, x + 2, '(nothing to list)', self.col(lerp(V, (40, 40, 50), .5), 'num'))
            return
        cur = max([i for i, (ln, _) in enumerate(items) if ln <= ed.row] or [0])
        first = max(0, min(cur - (oh - 2) // 2, len(items) - (oh - 2)))
        for k, (ln, label) in enumerate(items[first:first + oh - 2]):
            here = first + k == cur
            txt = ('» ' if here else '  ') + label
            self.put(oy + 1 + k, x + 1, txt[:wid - 8].ljust(wid - 8),
                     self.col(THEME['here'] if here else THEME['out_text'], 'add' if here else 'text', curses.A_BOLD if here else 0))
            self.put(oy + 1 + k, x + wid - 7, str(ln + 1).rjust(5), self.col(lerp(V, (40, 40, 50), .5), 'num'))

    def draw_intro(self, h, w):
        hints = [(':help', 'every key on one page'), (':e file', 'open a file'), ('i', 'start typing'),
                 (':wq', 'save and quit'), (':q', 'quit')]
        if not self.rich:                     # the Linux console / 8 colours: the plain look, which it can draw
            lines = list(WORDMARK) + ['', 'PosterChanOS editor  ·  v' + VERSION, ''] + ['%-10s %s' % kv for kv in hints]
            y0 = max(1, (h - 2 - len(lines)) // 2)
            for i, l in enumerate(lines):
                x = max(0, (w - len(l)) // 2) if i >= len(WORDMARK) else max(0, (w - len(WORDMARK[0])) // 2)
                key = 'logo1' if i < 3 else 'logo2' if i < len(WORDMARK) else ('msg' if i == len(WORDMARK) + 1 else 'num')
                self.put(y0 + i, x, l, self.attr(key, curses.A_BOLD if i < len(WORDMARK) + 2 else 0))
            return
        t = min(1.0, (time.monotonic() - self.t0) / 0.55)        # the reveal: 0 -> 1 over the first half second
        self._art_drawn = True
        art = logo_cells()
        aw, ah = max(len(r) for r in art), len(art)
        ww = len(WORDMARK[0])
        tag = '// JACKED IN · NEON EDITOR'
        block_h = len(WORDMARK) + 1 + 1 + 1 + 2 + len(hints)
        tw_ = max(ww, len(tag), 34)                                # the key panel is 34 wide
        side = w >= aw + 4 + tw_ + 2 and h - 2 >= ah
        stacked = not side and h - 2 >= ah + block_h + 1 and w >= max(aw, ww)
        if side:
            x_art, y_art = max(0, (w - (aw + 4 + tw_)) // 2), max(0, (h - 2 - ah) // 2)
            x_txt, y_txt = x_art + aw + 4, max(0, (h - 2 - block_h) // 2)
        elif stacked:
            y_art = max(0, (h - 2 - ah - block_h - 1) // 2)
            x_art, x_txt, y_txt = max(0, (w - aw) // 2), max(0, (w - ww) // 2), y_art + ah + 1
        else:
            x_art = None
            x_txt, y_txt = max(0, (w - ww) // 2), max(0, (h - 2 - block_h) // 2)
        if x_art is not None:
            # SHE IS DRAWN AFTER curses, as ptop draws her: her few hundred colour pairs do not fit the 255 a curses
            # attribute can name (the 256th wraps into the attribute bits -- measured: the hint text went purple).
            shown = int(ah * min(1.0, t * 1.4) + 0.999)            # she arrives top-down, behind a scanline
            self._raw_art = (y_art, x_art, art[:shown], art[shown] if shown < ah else None, aw)
        # the wordmark, column by column in the gradient, with a one-frame glitch while it lands
        cols = int(ww * t + 0.999)
        for i, l in enumerate(WORDMARK):
            jit = (1 if (i + int(t * 10)) % 3 == 0 else -1) if t < 1.0 else 0
            for j, ch in enumerate(l[:cols]):
                if ch != ' ':
                    self.put(y_txt + i, x_txt + j + jit, ch, self.rgb_attr(neon(j / max(1, ww - 1)), None, curses.A_BOLD))
        y = y_txt + len(WORDMARK)
        rule = ('░▒▓█' + '█' * (ww - 8) + '█▓▒░')[:ww]          # a data stream under the name
        for j, ch in enumerate(rule[:cols]):
            self.put(y, x_txt + j, ch, self.rgb_attr(neon(j / max(1, ww - 1))))
        y += 1
        for j, ch in enumerate(tag[:int(len(tag) * t + 0.999)]):
            self.put(y, x_txt + j, ch, self.rgb_attr(neon(j / max(1, len(tag) - 1)), None, curses.A_BOLD))
        y += 1
        self.put(y, x_txt, 'PosterChanOS · v' + VERSION, self.rgb_attr(TEAL))
        y += 1
        if t >= 1.0:
            bw = max(ww, 34)
            edge = self.rgb_attr(TEAL)
            self.put(y, x_txt, '┌─[ JACK IN ]' + '─' * (bw - 14) + '┐', edge)
            self.put(y, x_txt + 4, 'JACK IN', self.rgb_attr(GREEN, None, curses.A_BOLD))
            y += 1
            for k, d in hints:
                self.put(y, x_txt, '│', edge)
                self.put(y, x_txt + 2, k.ljust(9), self.rgb_attr(CYAN, None, curses.A_BOLD))
                self.put(y, x_txt + 11, d.ljust(bw - 13), self.rgb_attr((170, 200, 205)))
                self.put(y, x_txt + bw - 1, '│', edge)
                y += 1
            self.put(y, x_txt, '└' + '─' * (bw - 2) + '┘', edge)

    def draw_status(self, h, w):
        ed = self.ed
        y = h - 2
        mode = ed.prev_mode if ed.mode == ed.CMDLINE and getattr(ed, 'prev_mode', None) else ed.mode
        if ed.mode == ed.CMDLINE:
            mode = ed.CMDLINE
        badge = '  %s  ' % mode          # plain text: the Linux console's own font has no ◢◣ glyphs
        self.put(y, 0, ' ' * (w - 1), self.attr('status'))
        self.put(y, 0, badge, self.attr('mode_' + mode, curses.A_BOLD))
        if self.rich:
            # the badge bleeds out into the bar, HUD-style: ▓▒░ in the badge's own colour
            fg = THEME['modes'].get(mode, THEME['a'])
            self.put(y, len(badge), '▓▒░', self.rgb_attr(fg, None, 0, bg256=233))
            badge += '   '
        name = ed.path or '[No Name]'
        home = os.path.expanduser('~')
        if ed.path and home not in ('/', '') and os.path.abspath(name).startswith(home + os.sep):
            name = '~' + os.path.abspath(name)[len(home):]
        flags = (' [+]' if ed.modified else '') + (' [RO]' if ed.info.readonly else '')
        right = '%s%s  %d:%d  %s ' % ((ed.ft + '  ') if ed.ft else '', 'dos  ' if ed.info.crlf else '',
                                      ed.row + 1, ed.disp_col() + 1,
                                      'Top' if ed.top == 0 and len(ed.lines) <= ed.text_rows() else
                                      '%d%%' % ((ed.row + 1) * 100 // max(1, len(ed.lines))))
        room = max(0, w - len(badge) - len(right) - (16 if w > 60 else 3))
        if len(name) + len(flags) + 1 > room:          # keep the END of a long path: the file name is what matters
            name = '…' + name[-max(1, room - len(flags) - 2):]
        left = (' // %s%s' if self.rich else ' %s%s') % (name, flags)
        self.put(y, len(badge), left[:room], self.attr('status', curses.A_BOLD))
        if w > 60:
            bx = max(len(badge), w - len(right) - 13)
            if self.rich:
                for j, ch in enumerate(' PosterChan '):
                    self.put(y, bx + j, ch, self.rgb_attr(neon(j / 11), None, curses.A_BOLD, bg256=234))
            else:
                self.put(y, bx, ' PosterChan ', self.attr('logo2', curses.A_BOLD))
        self.put(y, max(0, w - len(right) - 1), right, self.attr('statusdim'))
        if self.rich and w > 70:
            # where you are in the file, as a neon bar: ━ for what is above the cursor, ─ for the rest
            n, frac = 10, (ed.row + 1) / max(1, len(ed.lines))
            bx = max(len(badge) + 2, w - len(right) - 13 - n - 4)
            self.put(y, bx, '░▒▓', self.rgb_attr(TEAL, None, 0, bg256=233))
            for j in range(n):
                on = j < max(1, round(frac * n))
                self.put(y, bx + 3 + j, '█' if on else '░', self.rgb_attr(neon(j / (n - 1)) if on else THEME['meter_off'], None, 0, bg256=233))
        # command / message line
        if ed.mode == ed.CMDLINE:
            self.put(h - 1, 0, ed.cmd_kind + ed.cmdline, self.attr('text'))
        elif ed.msg:
            self.put(h - 1, 0, ed.msg, self.attr('err' if ed.msg_err else 'msg'))
        elif ed.pending and ed.mode == ed.NORMAL:
            self.put(h - 1, max(0, w - 12), ''.join(k if len(k) == 1 else k for k in ed.pending)[-10:], self.attr('num'))

    def read_key(self):
        if self.pending_input:
            return self.pending_input.pop(0)
        try:
            ch = self.scr.get_wch()
        except curses.error:
            return None
        except KeyboardInterrupt:
            return '<C-c>'
        if ch == '\x1b':
            # bracketed paste, or a lone Esc
            self.scr.nodelay(True)
            seq = []
            try:
                for _ in range(5):
                    try:
                        c = self.scr.get_wch()
                    except curses.error:
                        break
                    seq.append(c)
                    if ''.join(x for x in seq if isinstance(x, str)) != '[200~'[:len(seq)]:
                        break
            finally:
                self.scr.nodelay(False)
            if [x for x in seq if isinstance(x, str)] == list('[200~'):
                return '<PASTE>' + self.read_paste()
            self.pending_input.extend(keyname(x) for x in seq if keyname(x))
            return '<Esc>'
        return keyname(ch)

    def read_paste(self):
        buf = []
        end = '\x1b[201~'
        self.scr.nodelay(False)
        while True:
            try:
                c = self.scr.get_wch()
            except curses.error:
                break
            if isinstance(c, int):
                continue
            buf.append(c)
            if len(buf) >= len(end) and ''.join(buf[-len(end):]) == end:
                del buf[-len(end):]
                break
        return ''.join(buf).replace('\r\n', '\n').replace('\r', '\n')


def load_rc(ed):
    for p in (os.path.expanduser('~/.pvimrc'), '/etc/pvimrc'):
        try:
            with open(p, encoding='utf-8', errors='replace') as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith('"'):
                        ed.ex(line.lstrip(':'))
            ed.say('')
            return
        except OSError:
            continue


def _terminfo_exists(name):
    dirs = [os.environ.get('TERMINFO', ''), os.path.expanduser('~/.terminfo'), '/etc/terminfo', '/usr/share/terminfo',
            '/lib/terminfo', '/usr/lib/terminfo']
    return any(d and (os.path.exists(os.path.join(d, name[0], name)) or os.path.exists(os.path.join(d, '%x' % ord(name[0]), name)))
               for d in dirs)


def upgrade_term():
    """An 8-colour TERM in front of a 256-colour terminal gets its 256-colour twin.

    The PosterChanOS terminal's SSH sessions run inside GNU screen, whose plain `screen` entry advertises EIGHT colours,
    so curses (and pvim) fell back to the 8-colour look -- "pvim is green and blue?" (2026-10-30) when the theme was
    ptop. screen passes 256 colours through untouched (ptop relies on it), so the twin entry is the honest one. The Linux
    console and anything without a twin keep what they are."""
    t = os.environ.get('TERM', '')
    twin = {'screen': 'screen-256color', 'tmux': 'tmux-256color', 'xterm': 'xterm-256color',
            'rxvt-unicode': 'rxvt-unicode-256color', 'putty': 'putty-256color'}.get(t)
    if twin and _terminfo_exists(twin):
        os.environ['TERM'] = twin


def main(argv):
    args = [a for a in argv[1:]]
    if args and args[0] in ('-v', '--version'):
        print('pvim %s — PosterChanOS editor' % VERSION)
        return 0
    if args and args[0] in ('-h', '--help'):
        print('usage: pvim [+N|+/pattern] [file]\n' + HELP)
        return 0
    start = None
    files = []
    for a in args:
        if a.startswith('+') and not files:
            start = a[1:]
        elif a == '--':
            continue
        elif a.startswith('-') and a not in ('-',):
            continue      # vim flags editors are commonly handed (-n, -u NONE...): accepted and ignored
        else:
            files.append(a)
    path = files[0] if files else None
    if path and os.path.isdir(path):
        print('pvim: %s is a directory' % path, file=sys.stderr)
        return 1
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print('pvim: needs a terminal', file=sys.stderr)
        return 1
    try:
        locale.setlocale(locale.LC_ALL, '')
    except locale.Error:
        pass
    os.environ.setdefault('ESCDELAY', '25')
    upgrade_term()
    _init_curses_keys()
    ed = Editor(path)
    load_rc(ed)
    if path:
        ed.load(path)
    if start is not None:
        if start == '':
            ed.feed('G')
        elif start.startswith('/'):
            ed.do_search_from_cli = True
            ed.search_origin = (0, 0, 0)
            ed.do_search(start[1:], True)
        elif start.isdigit():
            ed.ex(start)

    def run(scr):
        screen = Screen(scr, ed)
        try:
            while True:
                scr.timeout(16 if screen.animating() else 1000)     # the header's clock ticks; a key wakes it at once
                screen.draw()
                k = screen.read_key()
                if k is None:
                    continue
                if getattr(ed, 'help_text', None):
                    if k in ('q', '<Esc>', '<CR>', '<C-c>'):
                        ed.help_text = None
                        ed.say('')
                    continue
                if k == '<C-z>' and ed.mode == ed.NORMAL and not ed.pending:
                    screen.close()
                    curses.endwin()
                    os.kill(0, signal.SIGTSTP)
                    sys.stdout.write('\x1b[?2004h')
                    sys.stdout.flush()
                    scr.refresh()
                    continue
                if k == '<C-c>' and ed.mode == ed.NORMAL:
                    ed.pending = []
                    ed.say('Type  :q  and press <Enter> to exit pvim')
                    continue
                ed.msg = '' if ed.mode != ed.CMDLINE and k not in (':',) else ed.msg
                ed.msg_err = ed.msg_err if ed.msg else False
                try:
                    ed.feed(k)
                except Quit:
                    return
                except Exception as e:      # a bug must never cost the user their buffer
                    ed.mode = ed.NORMAL
                    ed.pending = []
                    ed._depth = 0
                    ed.say('pvim internal error: %s — your text is safe, :w still works' % e, True)
        finally:
            screen.close()

    curses.wrapper(run)
    sys.stdout.write('\x1b[0 q')
    sys.stdout.flush()
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
