CYAN = GREEN = BLUE = TEAL = (0, 0, 0)


def apply_theme(name):
    """Make `name` the colours every draw reads. Unknown names keep the current theme and answer False."""
    global THEME, CYAN, GREEN, BLUE, TEAL
    if name not in THEMES:
        return False
    THEME = THEMES[name]
    CYAN, GREEN, BLUE, TEAL = THEME['a'], THEME['b'], THEME['c'], THEME['dim']
    return True


