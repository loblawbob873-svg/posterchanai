# Posterchan AI Chat Service - IPEX-LLM on Intel Arc GPU
# NOTE: This is a template file. The installer generates the actual service
# file with the correct user and paths in /etc/systemd/system/
#
# To use this template manually, replace:
#   - YOUR_USER with your username
#   - /path/to/posterchanai with the actual installation path

[Unit]
Description=Posterchan AI Chat (IPEX-LLM Intel Arc GPU)
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/posterchanai

# Minimal environment - the run script sets up oneAPI and IPEX environment
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/home/YOUR_USER"

# The run script (run-intel.sh) handles:
# - Detecting and configuring Intel oneAPI
# - Setting LD_LIBRARY_PATH with all required library paths
# - IPEX-LLM optimization environment variables
# - Sourcing oneapi-vars.sh for SYCL compiler support
ExecStart=/path/to/posterchanai/run-intel.sh

Restart=always
RestartSec=5

# Give extra time for model loading on restart
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
