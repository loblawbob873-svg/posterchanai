/* Posterchanai TUI - Cyberpunk Theme */

/* ======== COLOR VARIABLES ======== */
$cyan: #00ffff;
$magenta: #ff00ff;
$orange: #ff6b00;
$bg: #0a0a0f;
$surface: #12121a;
$surface-bright: #1a1a25;
$surface-hover: #22222e;
$text: #e0e0e0;
$text-dim: #808090;
$text-muted: #505060;
$border: #2a2a40;
$border-bright: #3a3a55;
$error: #ff4444;
$success: #44ff88;
$warning: #ffaa00;

/* ======== GLOBAL ======== */
Screen {
    background: $bg;
}

/* ======== HEADER/FOOTER ======== */
Header {
    background: $surface;
    color: $cyan;
    text-style: bold;
}

Footer {
    background: $surface;
    color: $text-dim;
}

FooterKey {
    background: $surface-bright;
    color: $cyan;
}

FooterKey > .footer-key--key {
    background: $cyan;
    color: $bg;
}

/* ======== SIDEBAR ======== */
#sidebar {
    width: 32;
    background: $surface;
    border-right: solid $border;
}

#sidebar-content {
    height: 1fr;
}

#sidebar-title {
    height: 2;
    background: $surface-bright;
    padding: 0 1;
    text-style: bold;
    color: $cyan;
    border-bottom: solid $border;
}

#sidebar-header {
    height: 3;
    background: $surface-bright;
    padding: 1;
    text-style: bold;
    color: $cyan;
    border-bottom: solid $border;
}

#new-chat-btn {
    width: 100%;
    background: $cyan;
    color: $bg;
    text-style: bold;
    margin: 1;
}

#new-chat-btn:hover {
    background: $cyan 80%;
}

#conversation-list {
    height: 1fr;
}

.conversation-item {
    height: 3;
    padding: 0 1;
    border-bottom: solid $border 30%;
}

.conversation-item:hover {
    background: $surface-hover;
}

.conversation-item.--selected {
    background: $cyan 15%;
    border-left: thick $cyan;
}

.conversation-title {
    color: $text;
    text-style: bold;
}

.conversation-time {
    color: $text-muted;
    text-style: italic;
}

/* ======== CHAT AREA ======== */
#main-container {
    height: 1fr;
}

#chat-container {
    background: $bg;
    height: 1fr;
}

#chat-header {
    height: 3;
    background: $surface;
    padding: 0 2;
    border-bottom: solid $border;
    content-align: center middle;
}

#chat-title {
    color: $cyan;
    text-style: bold;
}

#chat-view {
    height: 1fr;
}

#messages-container {
    height: 1fr;
    padding: 1;
}

#typing-indicator {
    dock: bottom;
    height: 2;
    background: $magenta 20%;
    color: $magenta;
    text-align: center;
    text-style: bold italic;
    padding: 0 1;
    border: solid $magenta 50%;
}

#typing-indicator.--hidden {
    display: none;
}

/* ======== MESSAGES ======== */
MessageWidget {
    height: auto;
    margin: 0 1 1 1;
}

.message-inner {
    height: auto;
    padding: 1;
}

.message-user {
    background: $cyan 12%;
    border: solid $cyan 40%;
    margin-left: 20;
}

.message-user .message-role {
    color: $cyan;
    text-align: right;
}

.message-user .message-body {
    text-align: right;
}

.message-assistant {
    background: $magenta 12%;
    border: solid $magenta 40%;
    margin-right: 20;
}

.message-assistant.message-streaming {
    border: solid $magenta 80%;
}

.message-assistant .message-role {
    color: $magenta;
}

.message-system {
    background: $surface;
    text-align: center;
    color: $text-dim;
    border: solid $border;
    margin: 1 10;
}

.message-role {
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

.message-body {
    height: auto;
}

.message-content {
    color: $text;
}

.message-time {
    color: $text-muted;
    text-style: italic;
}

/* ======== CODE BLOCKS ======== */
.code-block {
    background: #1a1a2e;
    border: solid $border-bright;
    padding: 1;
    margin: 1 0;
}

.code-header {
    color: $text-muted;
    background: $surface-bright;
    padding: 0 1;
}

/* ======== INPUT AREA ======== */
#input-area {
    dock: bottom;
    height: auto;
    max-height: 12;
    background: $surface;
    border-top: double $border-bright;
    padding: 1;
}

#input-row {
    height: auto;
}

#message-input {
    background: $surface-bright;
    border: solid $border;
    color: $text;
    padding: 0 1;
}

#message-input:focus {
    border: solid $cyan;
}

#send-btn {
    width: 10;
    background: $cyan;
    color: $bg;
    text-style: bold;
    margin-left: 1;
}

#send-btn:hover {
    background: $cyan 80%;
}

#send-btn.--streaming {
    background: $error;
}

#stop-btn {
    width: 10;
    background: $error;
    color: $text;
    text-style: bold;
    margin-left: 1;
}

/* ======== BUTTONS ======== */
Button {
    background: $surface-bright;
    color: $text;
    border: solid $border;
}

Button:hover {
    background: $surface-hover;
    border: solid $border-bright;
}

Button:focus {
    border: solid $cyan;
}

Button.primary, Button.-primary {
    background: $cyan;
    color: $bg;
    border: none;
}

Button.primary:hover, Button.-primary:hover {
    background: $cyan 80%;
}

Button.danger, Button.-danger {
    background: $error;
    color: $text;
    border: none;
}

Button.danger:hover, Button.-danger:hover {
    background: $error 80%;
}

Button.-warning, Button.warning {
    background: $warning;
    color: $bg;
    border: none;
}

Button.-warning:hover, Button.warning:hover {
    background: $warning 80%;
}

/* ======== CMD BUTTONS (inline command links) ======== */
#message-buttons {
    height: auto;
    margin-top: 1;
    layout: horizontal;
}

.cmd-button {
    background: $cyan 15%;
    color: $cyan;
    padding: 0 1;
    margin-right: 1;
    border: solid $cyan 40%;
    height: 3;
    min-width: 10;
}

.cmd-button:hover {
    background: $cyan 30%;
    border: solid $cyan 60%;
}

/* ======== INPUTS ======== */
Input {
    background: $surface-bright;
    border: solid $border;
    color: $text;
}

Input:focus {
    border: solid $cyan;
}

Input.-invalid {
    border: solid $error;
}

/* ======== LOGIN SCREEN ======== */
#login-container {
    align: center middle;
    width: 50;
    height: auto;
    background: $surface;
    border: double $cyan;
    padding: 2;
}

#login-title {
    text-align: center;
    color: $cyan;
    text-style: bold;
    padding-bottom: 1;
}

#login-subtitle {
    text-align: center;
    color: $text-dim;
    padding-bottom: 2;
}

.form-row {
    height: 3;
    margin-bottom: 1;
}

.form-label {
    width: 12;
    color: $text-dim;
    padding-top: 1;
}

.form-input {
    width: 1fr;
}

#login-btn {
    width: 100%;
    margin-top: 1;
    background: $cyan;
    color: $bg;
    text-style: bold;
}

#login-error {
    color: $error;
    text-align: center;
    padding: 1;
}

/* ======== MUSIC PLAYER ======== */
#music-player {
    dock: bottom;
    height: auto;
    max-height: 10;
    background: $surface;
    border-top: double $magenta;
}

#music-player.--hidden {
    display: none;
}

#player-container {
    height: auto;
    padding: 1;
}

#player-title {
    color: $magenta;
    text-style: bold;
    text-align: center;
    height: 1;
}

#player-info {
    height: 1;
}

#track-info {
    color: $cyan;
    text-align: center;
    width: 1fr;
}

#visualizer {
    text-align: center;
    color: $cyan;
    height: 1;
}

#progress-row {
    height: 1;
    margin: 0 2;
}

#time-current, #time-total {
    width: 6;
    color: $text-dim;
}

#progress-bar {
    width: 1fr;
}

#player-controls {
    height: 3;
    align: center middle;
}

.player-btn {
    background: $surface-bright;
    color: $magenta;
    border: solid $magenta 50%;
    min-width: 6;
    margin: 0 1;
}

.player-btn:hover {
    background: $magenta 20%;
    color: $cyan;
}

.player-btn-main {
    min-width: 8;
    background: $magenta 20%;
}

/* Minimized player */
#player-minimized {
    height: 3;
    padding: 0 1;
    background: $surface;
    border-top: solid $magenta;
}

#player-minimized.--hidden {
    display: none;
}

#player-container.--hidden {
    display: none;
}

#track-info-mini {
    width: 1fr;
    color: $cyan;
    padding: 0 1;
}

.player-btn-mini {
    background: $surface-bright;
    color: $magenta;
    min-width: 4;
    height: 3;
    margin: 0;
    border: none;
}

.player-btn-mini:hover {
    background: $magenta 20%;
}

/* ======== SETTINGS ======== */
#settings-container {
    padding: 2;
}

.settings-section {
    background: $surface;
    margin: 1;
    padding: 1;
    border: solid $border;
}

.settings-title {
    color: $magenta;
    text-style: bold;
    padding-bottom: 1;
}

.settings-row {
    height: 3;
    margin-bottom: 1;
}

/* ======== TABS ======== */
Tabs {
    background: $surface;
}

Tab {
    background: $surface-bright;
    color: $text-dim;
    padding: 0 2;
}

Tab:hover {
    background: $surface-hover;
    color: $text;
}

Tab.-active {
    background: $cyan 20%;
    color: $cyan;
}

TabPane {
    padding: 1;
}

/* ======== SCROLLBARS ======== */
ScrollBar {
    background: $surface;
}

ScrollBar > .scrollbar--bar {
    background: $cyan 30%;
}

ScrollBar > .scrollbar--bar:hover {
    background: $cyan 50%;
}

/* ======== LOADING/SPINNER ======== */
LoadingIndicator {
    color: $cyan;
}

/* ======== PROGRESS BAR ======== */
ProgressBar > .bar--bar {
    color: $cyan;
}

ProgressBar > .bar--complete {
    color: $magenta;
}

/* ======== SPECIAL CONTENT ======== */
.search-results {
    padding: 1;
}

.search-result {
    background: $surface;
    padding: 1;
    margin-bottom: 1;
    border: solid $border;
}

.search-result-title {
    color: $cyan;
    text-style: bold;
}

.search-result-url {
    color: $text-muted;
}

/* ======== HELP SCREEN ======== */
#help-container {
    padding: 1;
    height: 1fr;
}

#help-title {
    dock: top;
    height: 2;
    background: $surface-bright;
    color: $magenta;
    text-style: bold;
    text-align: center;
    padding: 0 1;
    border-bottom: solid $border;
}

#help-scroll {
    height: 1fr;
}

#help-content {
    padding: 1;
}

#help-footer {
    dock: bottom;
    height: 1;
    background: $surface;
    color: $text-dim;
    text-align: center;
}

.help-section {
    margin-bottom: 2;
}

.help-title {
    color: $cyan;
    text-style: bold;
}

.help-key {
    background: $surface-bright;
    color: $magenta;
    padding: 0 1;
}

/* ======== CHAT INPUT ======== */
#chat-input {
    dock: bottom;
    height: auto;
    min-height: 7;
    max-height: 12;
    background: $surface;
    border-top: solid $cyan 50%;
    padding: 1;
}

#input-container {
    height: auto;
}

#input-row {
    height: 3;
}

#autocomplete-hint {
    color: $cyan;
    background: $surface-bright;
    padding: 0 1;
    height: 1;
}

#autocomplete-hint.--hidden {
    display: none;
}

/* ======== SETTINGS SCREEN ======== */
SettingsScreen {
    align: center middle;
}

#settings-header {
    dock: top;
    height: 3;
    background: $surface;
    border-bottom: double $magenta;
    content-align: center middle;
}

#settings-title {
    color: $magenta;
    text-style: bold;
    text-align: center;
}

#settings-tabs {
    height: 1fr;
    background: $bg;
}

#settings-tabs > TabPane {
    padding: 1 2;
}

#settings-buttons {
    dock: bottom;
    height: 3;
    background: $surface;
    border-top: solid $border;
    align: center middle;
    padding: 0 2;
}

#settings-buttons Button {
    margin: 0 1;
}

.settings-section-title {
    color: $cyan;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

.settings-description {
    color: $text-dim;
    margin-bottom: 1;
}

.settings-row {
    height: 3;
    margin-bottom: 1;
}

.settings-label {
    width: 20;
    padding-right: 1;
}

.settings-input {
    width: 1fr;
}

.settings-input-small {
    width: 15;
}

.settings-spacer {
    height: 1;
}

/* ======== TABBED CONTENT ======== */
TabbedContent {
    background: $bg;
}

Tabs {
    background: $surface;
    border-bottom: solid $border;
}

Tab {
    background: transparent;
    color: $text-dim;
    padding: 0 2;
}

Tab:hover {
    background: $surface-bright;
    color: $text;
}

Tab.-active {
    background: $bg;
    color: $cyan;
    text-style: bold;
}

Underline {
    color: $cyan;
}

TabPane {
    background: $bg;
    padding: 1;
}

/* Quick action buttons */
#quick-actions {
    height: 3;
    dock: top;
    padding: 0;
}

.quick-btn {
    min-width: 6;
    height: 3;
    margin: 0;
    padding: 0 1;
    background: $surface;
    color: $cyan;
    border: solid $cyan 30%;
}

.quick-btn:hover {
    background: $cyan 30%;
}

.quick-btn:focus {
    background: $cyan 40%;
}
