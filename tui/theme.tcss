/* ═══════════════════════════════════════════════════════════════════════════
   POSTERCHANAI TUI - NEON CYBERPUNK THEME
   "The future is now, choom"
   ═══════════════════════════════════════════════════════════════════════════ */

/* ═══════════ NEON COLOR PALETTE ═══════════ */
$neon-cyan: #00ffff;
$neon-magenta: #ff00ff;
$neon-pink: #ff1493;
$neon-orange: #ff6b00;
$neon-yellow: #ffff00;
$neon-green: #39ff14;
$neon-blue: #00bfff;
$neon-purple: #bf00ff;

/* Core colors */
$cyan: $neon-cyan;
$magenta: $neon-magenta;
$orange: $neon-orange;
$yellow: $neon-yellow;
$green: $neon-green;

/* Dark backgrounds */
$void: #05050a;
$bg: #0a0a12;
$surface: #0f0f1a;
$surface-bright: #161625;
$surface-hover: #1e1e32;
$surface-glow: #252540;

/* Text colors */
$text: #e8e8f0;
$text-dim: #9090a8;
$text-muted: #606078;
$text-glow: #ffffff;

/* Border colors */
$border: #303050;
$border-bright: #4a4a70;
$border-glow: #6060a0;

/* Status colors */
$error: #ff2255;
$success: #00ff88;
$warning: #ffaa00;

/* ═══════════ GLOBAL ═══════════ */
Screen {
    background: $void;
}

/* ═══════════ HEADER - NEON TITLE BAR ═══════════ */
Header {
    background: $surface;
    color: $cyan;
    text-style: bold;
    border-bottom: heavy $cyan 60%;
}

Footer {
    background: $surface;
    color: $text-dim;
    border-top: solid $magenta 30%;
}

FooterKey {
    background: $surface-bright;
    color: $cyan;
}

FooterKey > .footer-key--key {
    background: $cyan;
    color: $void;
    text-style: bold;
}

/* ═══════════ SIDEBAR - NEURAL NETWORK PANEL ═══════════ */
#sidebar {
    width: 34;
    background: $surface;
    border-right: double $cyan 50%;
}

#sidebar-content {
    height: 1fr;
}

#sidebar-title {
    height: 3;
    background: $cyan 15%;
    padding: 1 1;
    text-style: bold;
    color: $cyan;
    border-bottom: heavy $cyan 40%;
}

#sidebar-header {
    height: 3;
    background: $cyan 10%;
    padding: 1;
    text-style: bold;
    color: $cyan;
    border-bottom: solid $cyan 30%;
}

#new-chat-btn {
    width: 100%;
    background: $cyan;
    color: $void;
    text-style: bold;
    margin: 1;
    border: solid $neon-blue;
}

#new-chat-btn:hover {
    background: $neon-blue;
    color: $void;
}

#conversation-list {
    height: 1fr;
}

.conversation-item {
    height: 3;
    padding: 0 1;
    border-bottom: solid $border 20%;
    border-left: solid $magenta 0%;
}

.conversation-item:hover {
    background: $surface-hover;
    border-left: thick $magenta 50%;
}

.conversation-item.--selected {
    background: $cyan 20%;
    border-left: thick $cyan;
    color: $text-glow;
}

.conversation-title {
    color: $text;
    text-style: bold;
}

.conversation-time {
    color: $text-muted;
    text-style: italic;
}

/* ═══════════ CHAT AREA - DATASTREAM VIEWPORT ═══════════ */
#main-container {
    height: 1fr;
}

#chat-container {
    background: $bg;
    height: 1fr;
}

#chat-header {
    height: 3;
    background: $surface;
    padding: 0 2;
    border-bottom: heavy $magenta 40%;
    content-align: center middle;
}

#chat-title {
    color: $magenta;
    text-style: bold;
}

#chat-view {
    height: 1fr;
}

#messages-container {
    height: 1fr;
    padding: 1;
}

/* ═══════════ TYPING INDICATOR - NEURAL SYNC ═══════════ */
#typing-indicator {
    dock: bottom;
    height: 2;
    background: $magenta 25%;
    color: $magenta;
    text-align: center;
    text-style: bold italic;
    padding: 0 1;
    border: double $magenta 70%;
}

#typing-indicator.--hidden {
    display: none;
}

/* ═══════════ MESSAGES - DATA PACKETS ═══════════ */
MessageWidget {
    height: auto;
    margin: 0 1 0 1;
}

.message-inner {
    height: auto;
    padding: 0 1;
}

/* USER MESSAGES - Cyan Transmission */
.message-user {
    background: $cyan 15%;
    border: double $cyan 50%;
    border-left: thick $cyan;
    margin-left: 15;
}

.message-user .message-role {
    color: $cyan;
    text-align: right;
    text-style: bold;
}

.message-user .message-body {
    text-align: right;
}

/* ASSISTANT MESSAGES - Magenta Response */
.message-assistant {
    background: $magenta 15%;
    border: double $magenta 50%;
    border-left: thick $magenta;
    margin-right: 15;
}

.message-assistant.message-streaming {
    border: double $neon-pink;
    background: $magenta 20%;
}

.message-assistant .message-role {
    color: $magenta;
    text-style: bold;
}

/* SYSTEM MESSAGES - Yellow Alert */
.message-system {
    background: $yellow 10%;
    text-align: center;
    color: $yellow;
    border: solid $yellow 40%;
    margin: 1 8;
}

.message-header {
    height: 1;
    margin-bottom: 0;
    width: 100%;
}

.message-role {
    text-style: bold;
    width: auto;
}

.copy-btn {
    width: 8;
    min-width: 8;
    height: 1;
    padding: 0 1;
    margin: 0;
    margin-left: 1;
    background: $surface;
    color: $text-muted;
    border: round $primary 30%;
    text-align: center;
}

.copy-btn:hover {
    color: $cyan;
    background: $surface-hover;
    border: round $cyan 60%;
}

.copy-btn:focus {
    color: $cyan;
    background: $surface-hover;
    border: round $cyan 60%;
}

.message-body {
    height: auto;
}

.message-content {
    color: $text;
}

.message-time {
    color: $text-muted;
    text-style: italic;
}

/* ═══════════ CODE BLOCKS - HACKER TERMINAL ═══════════ */
.code-block {
    background: #0a0a18;
    border: double $green 40%;
    padding: 1;
    margin: 1 0;
}

.code-header {
    color: $green;
    background: $green 15%;
    padding: 0 1;
    text-style: bold;
}

/* ═══════════ INPUT AREA - COMMAND INTERFACE ═══════════ */
#input-area {
    dock: bottom;
    height: auto;
    max-height: 12;
    background: $surface;
    border-top: double $cyan 60%;
    padding: 1;
}

#input-row {
    height: auto;
}

#message-input {
    background: $surface-bright;
    border: solid $border-bright;
    color: $text;
    padding: 0 1;
}

#message-input:focus {
    border: double $cyan;
    background: $surface-glow;
}

#send-btn {
    width: 12;
    background: $cyan;
    color: $void;
    text-style: bold;
    margin-left: 1;
    border: solid $neon-blue;
}

#send-btn:hover {
    background: $neon-blue;
}

#send-btn.--streaming {
    background: $error;
    border: solid $neon-pink;
}

#stop-btn {
    width: 12;
    background: $error;
    color: $text;
    text-style: bold;
    margin-left: 1;
    border: solid $neon-pink;
}

/* ═══════════ BUTTONS - NEON CONTROLS ═══════════ */
Button {
    background: $surface-bright;
    color: $text;
    border: solid $border-bright;
}

Button:hover {
    background: $surface-hover;
    border: solid $cyan 50%;
    color: $cyan;
}

Button:focus {
    border: double $cyan;
}

Button.primary, Button.-primary {
    background: $cyan;
    color: $void;
    border: solid $neon-blue;
    text-style: bold;
}

Button.primary:hover, Button.-primary:hover {
    background: $neon-blue;
}

Button.danger, Button.-danger {
    background: $error;
    color: $text;
    border: solid $neon-pink;
    text-style: bold;
}

Button.danger:hover, Button.-danger:hover {
    background: $neon-pink;
}

Button.-warning, Button.warning {
    background: $warning;
    color: $void;
    border: solid $yellow;
    text-style: bold;
}

Button.-warning:hover, Button.warning:hover {
    background: $yellow;
    color: $void;
}

/* ═══════════ CMD BUTTONS - QUICK HACK LINKS ═══════════ */
#message-buttons {
    height: auto;
    margin-top: 1;
    layout: horizontal;
}

.cmd-button {
    background: $cyan 20%;
    color: $cyan;
    padding: 0 1;
    margin-right: 1;
    border: solid $cyan 60%;
    height: 3;
    min-width: 10;
    text-style: bold;
}

.cmd-button:hover {
    background: $cyan 40%;
    border: double $cyan;
    color: $text-glow;
}

/* ═══════════ INPUTS - DATA ENTRY ═══════════ */
Input {
    background: $surface-bright;
    border: solid $border;
    color: $text;
}

Input:focus {
    border: double $cyan;
    background: $surface-glow;
}

Input.-invalid {
    border: double $error;
}

/* ═══════════ LOGIN SCREEN - SYSTEM ACCESS ═══════════ */
#login-container {
    align: center middle;
    width: 60;
    height: auto;
    background: $surface;
    border: double $cyan;
    padding: 2;
}

#login-title {
    text-align: center;
    color: $cyan;
    text-style: bold;
    padding-bottom: 1;
}

#login-subtitle {
    text-align: center;
    color: $magenta;
    padding-bottom: 2;
}

.form-row {
    height: 3;
    margin-bottom: 1;
}

.form-label {
    width: 14;
    color: $cyan;
    padding-top: 1;
    text-style: bold;
}

.form-input {
    width: 1fr;
}

#login-btn {
    width: 100%;
    margin-top: 1;
    background: $cyan;
    color: $void;
    text-style: bold;
    border: solid $neon-blue;
}

#login-btn:hover {
    background: $neon-blue;
}

#login-error {
    color: $error;
    text-align: center;
    padding: 1;
    text-style: bold;
}

/* ═══════════ MUSIC PLAYER - AUDIO MATRIX ═══════════ */
#music-player {
    dock: bottom;
    height: auto;
    max-height: 12;
    background: $surface;
    border-top: double $magenta 80%;
}

#music-player.--hidden {
    display: none;
}

#player-container {
    height: auto;
    padding: 1;
}

#player-title {
    color: $magenta;
    text-style: bold;
    text-align: center;
    height: 1;
}

#player-info {
    height: 1;
}

#track-info {
    color: $cyan;
    text-align: center;
    width: 1fr;
    text-style: bold;
}

#visualizer {
    text-align: center;
    color: $green;
    height: 1;
}

#progress-row {
    height: 1;
    margin: 0 2;
}

#time-current, #time-total {
    width: 6;
    color: $magenta;
}

#progress-bar {
    width: 1fr;
}

#player-controls {
    height: 3;
    align: center middle;
}

.player-btn {
    background: $surface-bright;
    color: $magenta;
    border: solid $magenta 60%;
    min-width: 7;
    margin: 0 1;
}

.player-btn:hover {
    background: $magenta 30%;
    color: $text-glow;
    border: double $magenta;
}

.player-btn-main {
    min-width: 9;
    background: $magenta 25%;
    text-style: bold;
}

/* Minimized player */
#player-minimized {
    height: 3;
    padding: 0 1;
    background: $surface;
    border-top: heavy $magenta;
}

#player-minimized.--hidden {
    display: none;
}

#player-container.--hidden {
    display: none;
}

#track-info-mini {
    width: 1fr;
    color: $cyan;
    padding: 0 1;
    text-style: bold;
}

.player-btn-mini {
    background: $surface-bright;
    color: $magenta;
    min-width: 5;
    height: 3;
    margin: 0;
    border: solid $magenta 40%;
}

.player-btn-mini:hover {
    background: $magenta 30%;
    border: solid $magenta;
}

/* ═══════════ SETTINGS - SYSTEM CONFIG ═══════════ */
#settings-container {
    padding: 2;
}

.settings-section {
    background: $surface;
    margin: 1;
    padding: 1;
    border: double $border-bright;
}

.settings-title {
    color: $magenta;
    text-style: bold;
    padding-bottom: 1;
}

.settings-row {
    height: 3;
    margin-bottom: 1;
}

/* ═══════════ TABS - INTERFACE PANELS ═══════════ */
Tabs {
    background: $surface;
}

Tab {
    background: $surface-bright;
    color: $text-dim;
    padding: 0 2;
}

Tab:hover {
    background: $surface-hover;
    color: $cyan;
}

Tab.-active {
    background: $cyan 25%;
    color: $cyan;
    text-style: bold;
}

TabPane {
    padding: 1;
}

/* ═══════════ SCROLLBARS - DATA FLOW ═══════════ */
ScrollBar {
    background: $surface;
}

ScrollBar > .scrollbar--bar {
    background: $cyan 40%;
}

ScrollBar > .scrollbar--bar:hover {
    background: $cyan 70%;
}

/* ═══════════ LOADING - PROCESSING ═══════════ */
LoadingIndicator {
    color: $cyan;
}

/* ═══════════ PROGRESS BAR - DATA TRANSFER ═══════════ */
ProgressBar > .bar--bar {
    color: $cyan;
}

ProgressBar > .bar--complete {
    color: $green;
}

/* ═══════════ SEARCH RESULTS - DATA QUERY ═══════════ */
.search-results {
    padding: 1;
}

.search-result {
    background: $surface;
    padding: 1;
    margin-bottom: 1;
    border: solid $cyan 40%;
}

.search-result-title {
    color: $cyan;
    text-style: bold;
}

.search-result-url {
    color: $text-muted;
}

/* ═══════════ HELP SCREEN - DOCUMENTATION ═══════════ */
#help-container {
    padding: 1;
    height: 1fr;
}

#help-title {
    dock: top;
    height: 3;
    background: $cyan 15%;
    color: $cyan;
    text-style: bold;
    text-align: center;
    padding: 1;
    border-bottom: double $cyan 50%;
}

#help-scroll {
    height: 1fr;
}

#help-content {
    padding: 1;
}

#help-footer {
    dock: bottom;
    height: 1;
    background: $surface;
    color: $text-dim;
    text-align: center;
}

.help-section {
    margin-bottom: 2;
}

.help-title {
    color: $magenta;
    text-style: bold;
}

.help-key {
    background: $cyan 20%;
    color: $cyan;
    padding: 0 1;
    text-style: bold;
}

/* ═══════════ CHAT INPUT - TRANSMISSION TERMINAL ═══════════ */
#chat-input {
    dock: bottom;
    height: auto;
    min-height: 7;
    max-height: 12;
    background: $surface;
    border-top: double $cyan 70%;
    padding: 1;
}

#input-container {
    height: auto;
}

#input-row {
    height: 3;
}

#autocomplete-hint {
    color: $green;
    background: $green 15%;
    padding: 0 1;
    height: 1;
    text-style: italic;
}

#autocomplete-hint.--hidden {
    display: none;
}

/* ═══════════ SETTINGS SCREEN - SYSTEM CONFIGURATION ═══════════ */
SettingsScreen {
    align: center middle;
}

#settings-header {
    dock: top;
    height: 3;
    background: $surface;
    border-bottom: double $magenta 70%;
    content-align: center middle;
}

#settings-title {
    color: $magenta;
    text-style: bold;
    text-align: center;
}

#settings-tabs {
    height: 1fr;
    background: $bg;
}

#settings-tabs > TabPane {
    padding: 1 2;
}

#settings-buttons {
    dock: bottom;
    height: 3;
    background: $surface;
    border-top: solid $cyan 40%;
    align: center middle;
    padding: 0 2;
}

#settings-buttons Button {
    margin: 0 1;
}

.settings-section-title {
    color: $cyan;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

.settings-description {
    color: $text-dim;
    margin-bottom: 1;
}

.settings-row {
    height: 3;
    margin-bottom: 1;
}

.settings-label {
    width: 22;
    padding-right: 1;
    color: $cyan;
}

.settings-input {
    width: 1fr;
}

.settings-input-small {
    width: 15;
}

.settings-spacer {
    height: 1;
}

/* ═══════════ TABBED CONTENT - MULTI-PANEL ═══════════ */
TabbedContent {
    background: $bg;
}

Tabs {
    background: $surface;
    border-bottom: solid $magenta 40%;
}

Tab {
    background: transparent;
    color: $text-dim;
    padding: 0 2;
}

Tab:hover {
    background: $surface-bright;
    color: $magenta;
}

Tab.-active {
    background: $magenta 20%;
    color: $magenta;
    text-style: bold;
}

Underline {
    color: $magenta;
}

TabPane {
    background: $bg;
    padding: 1;
}

/* ═══════════ QUICK ACTIONS - NEURAL SHORTCUTS ═══════════ */
#quick-actions {
    height: 3;
    dock: top;
    padding: 0;
}

.quick-btn {
    min-width: 8;
    height: 3;
    margin: 0;
    padding: 0 1;
    background: $surface;
    color: $cyan;
    border: solid $cyan 40%;
    text-style: bold;
}

.quick-btn:hover {
    background: $cyan 35%;
    border: solid $cyan 80%;
}

.quick-btn:focus {
    background: $cyan 45%;
    border: double $cyan;
}

/* Dropdown toggle button */
.dropdown-toggle {
    min-width: 10;
}

/* Dropdown row - contains all popup menus */
#dropdown-row {
    height: 3;
    padding: 0;
    margin: 0;
}

#dropdown-row.--hidden {
    display: none;
}

/* Dropdown menu container */
.dropdown-menu {
    height: 3;
    padding: 0;
    margin: 0;
}

.dropdown-menu.--hidden {
    display: none;
}

/* Dropdown menu items */
.dropdown-item {
    min-width: 7;
    height: 3;
    margin: 0;
    padding: 0 1;
    background: $surface-darken-3;
    color: $magenta;
    border: solid $magenta 40%;
    text-style: bold;
}

.dropdown-item:hover {
    background: $magenta 35%;
    border: solid $magenta 80%;
}

.dropdown-item:focus {
    background: $magenta 45%;
    border: double $magenta;
}

/* ═══════════ DIALOGS - MODAL OVERLAYS ═══════════ */
ModalScreen {
    background: $void 80%;
}

#dialog {
    background: $surface;
    border: double $cyan;
    padding: 2;
    width: 60;
    height: auto;
}

#dialog-title {
    color: $cyan;
    text-style: bold;
    text-align: center;
    padding-bottom: 1;
    border-bottom: solid $cyan 40%;
}

#dialog-body {
    padding: 1;
    color: $text;
}

#dialog-buttons {
    align: center middle;
    padding-top: 1;
}

/* ═══════════ NOTIFICATIONS - SYSTEM ALERTS ═══════════ */
Toast {
    background: $surface;
    border: double $cyan;
    color: $text;
}

Toast.-information {
    border: double $cyan;
}

Toast.-warning {
    border: double $warning;
    color: $warning;
}

Toast.-error {
    border: double $error;
    color: $error;
}

/* ═══════════ SPECIAL EFFECTS ═══════════ */

/* Glowing borders for focused elements */
*:focus {
    border: double $cyan;
}

/* Selection highlighting */
.--highlight {
    background: $cyan 30%;
}

/* Error states */
.--error {
    border: double $error;
    color: $error;
}

/* Success states */
.--success {
    border: double $green;
    color: $green;
}

/* ═══════════ TORRENT LIST - INLINE BUTTONS ═══════════ */
.torrent-row {
    height: 3;
    width: 100%;
    padding: 0;
    margin: 0 0 1 0;
    layout: horizontal;
    align: left middle;
    overflow: hidden;
}

.torrent-text {
    width: 1fr;
    height: 3;
    padding: 0 1;
    color: $text;
    content-align: left top;
    overflow: hidden;
}

.torrent-btn {
    width: 3;
    min-width: 3;
    max-width: 3;
    height: 3;
    padding: 0;
    margin: 0 0 0 1;
    background: $magenta;
    color: $background;
    border: none;
    text-style: bold;
}

.torrent-btn:hover {
    background: $cyan;
}

.torrent-btn:focus {
    background: $cyan;
    text-style: bold;
}

.torrent-btn-danger {
    background: #ff3333;
}

.torrent-btn-danger:hover {
    background: #ff6666;
}

.torrent-btn-danger:focus {
    background: #ff6666;
}

/* ═══════════ MAIL LIST BUTTONS ═══════════ */
.mail-row {
    height: auto;
    min-height: 2;
    padding: 0 1;
    margin: 0 0 1 0;
}

.mail-text {
    width: 1fr;
    padding: 0 1;
    color: $text;
    content-align: left middle;
}

.mail-btn {
    width: 3;
    min-width: 3;
    height: 1;
    padding: 0;
    margin: 0;
    background: $neon-blue;
    color: $background;
    border: none;
    text-style: bold;
}

.mail-btn:hover {
    background: $cyan;
}

.mail-btn:focus {
    background: $green;
}

.mail-btn-danger {
    background: #ff3333;
}

.mail-btn-danger:hover {
    background: #ff6666;
}

/* ═══════════ ATTACH BUTTON - FILE UPLOAD ═══════════ */
.attach-btn {
    width: 5;
    min-width: 5;
    height: 3;
    margin: 0;
    padding: 0;
    background: $surface-bright;
    color: $orange;
    border: solid $orange 50%;
}

.attach-btn:hover {
    background: $orange 30%;
    border: solid $orange;
}

.attach-btn:focus {
    border: double $orange;
}

/* Attachments display */
#attachments-display {
    color: $orange;
    background: $orange 15%;
    padding: 0 1;
    height: 1;
    margin-bottom: 0;
}

#attachments-display.--hidden {
    display: none;
}

/* ═══════════ FILE PICKER - DATA BROWSER ═══════════ */
FilePickerScreen {
    align: center middle;
}

#file-picker-container {
    width: 80%;
    height: 80%;
    background: $surface;
    border: double $cyan;
    padding: 1;
}

#file-picker-title {
    text-align: center;
    text-style: bold;
    padding: 1;
    background: $cyan 25%;
    color: $cyan;
    border-bottom: solid $cyan 50%;
}

#file-tree {
    height: 1fr;
    border: solid $border-bright;
    margin: 1 0;
    background: $bg;
}

DirectoryTree {
    background: $bg;
}

DirectoryTree > .directory-tree--folder {
    color: $cyan;
    text-style: bold;
}

DirectoryTree > .directory-tree--file {
    color: $text;
}

DirectoryTree > .directory-tree--cursor {
    background: $cyan 30%;
}

DirectoryTree:focus > .directory-tree--cursor {
    background: $cyan 50%;
}

#selected-path {
    height: 3;
    margin: 0 0 1 0;
}

#selected-path Label {
    width: 10;
    color: $magenta;
    text-style: bold;
    padding-top: 1;
}

#selected-path Input {
    width: 1fr;
}

#path-input {
    background: $surface-bright;
    border: solid $border-bright;
}

#path-input:focus {
    border: double $magenta;
}

#file-picker-buttons {
    height: 3;
    align: center middle;
}

#file-picker-buttons Button {
    margin: 0 1;
}

#select-btn {
    background: $cyan;
    color: $void;
    border: solid $neon-blue;
}

#select-btn:hover {
    background: $neon-blue;
}

#cancel-btn {
    background: $surface-bright;
    color: $text;
    border: solid $border-bright;
}

#cancel-btn:hover {
    background: $error 30%;
    border: solid $error;
    color: $error;
}

/* ═══════════════════════════════════════════════════════════════════════════
   END OF THEME - "Wake up, Samurai. We have a city to burn."
   ═══════════════════════════════════════════════════════════════════════════ */
