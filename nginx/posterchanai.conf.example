# =============================================================================
# PosterChan AI — production nginx reverse proxy (TLS terminator)
# =============================================================================
# Fronts ONE PosterChan AI node (app on :3051, built-in Nostr relay on :3052) with
# HTTPS. Works for BOTH a full (AI) deployment and a Nostr-only deployment — the
# relay + web client + Blossom live at the same paths either way.
#
#   1. Copy:   sudo cp nginx/posterchanai.conf.example /etc/nginx/sites-available/posterchanai.conf
#   2. Edit:   replace EVERY  example.com  with your domain, and fix the cert paths.
#   3. Cert:   sudo certbot --nginx -d example.com         (or point ssl_certificate at your own)
#   4. Enable: sudo ln -s /etc/nginx/sites-available/posterchanai.conf /etc/nginx/sites-enabled/
#   5. Test:   sudo nginx -t && sudo systemctl reload nginx
#
# Then open https://example.com/client  and connect a Nostr client to  wss://example.com/relay
# (the app's own web client uses that automatically).
#
# WAF note: the chat/relay WebSockets use token auth, NOT cookies — do not block /ws/, /api/,
# /v1 or /relay by User-Agent, or chat + the relay will 403.
#
# RUNNING IN DOCKER? You probably don't need this file at all: `docker compose --profile <backend>
# --profile tls up -d` brings up a proxy container already configured, on a self-signed cert you
# replace with `certbot --nginx` (see docs/DOCKER.md). Use this file when you'd rather run nginx
# yourself. Two things change if you do:
#
#   * Upstreams. nginx ON THE HOST: compose publishes 3051/3052, so 127.0.0.1 below is correct.
#     nginx IN A CONTAINER: 127.0.0.1 is then nginx ITSELF and every request fails with
#     "connect() failed (111: Connection refused)" — use the compose service name instead
#     (`server nostr:3051;`), which needs no published ports at all.
#   * Published ports. Once TLS is up, move the two HTTP ports to loopback so http://<ip>:3051
#     stops answering around it — in a `.env` beside docker-compose.yml:
#         POSTERCHANAI_PORT=127.0.0.1:3051
#         POSTERCHANAI_NOSTR_RELAY_PORT=127.0.0.1:3052
#     ONLY those two. TURN (3478, 49160-49200/udp) and streaming (1935 RTMP from OBS, 8889 +
#     8189/udp WHIP from phones) are spoken to DIRECTLY by peers and publishers — they are not
#     HTTP, nginx does not front them, and moving them to loopback silently breaks voice/video
#     calls and going live. Leave those published and port-forwarded.
# =============================================================================

# Map the Upgrade header so WebSocket connections (chat, the relay) proxy correctly.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream posterchanai_app   { server 127.0.0.1:3051; }
upstream posterchanai_relay { server 127.0.0.1:3052; }
# CODE, if this node runs it. 127.0.0.1 ASSUMES NGINX AND CODE ARE THE SAME MACHINE, which is the
# single-box case this file is written for — but on a split deployment (this one: nginx on the
# router, the app and CODE on another host) it must name that HOST, e.g. `server 192.168.0.2:9983;`.
# Pointed at loopback from a separate front end it resolves, starts, and 502s every document.
upstream posterchanai_office { server 127.0.0.1:9983; }

# --- HTTP -> HTTPS redirect --------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name example.com;

    # Let certbot answer ACME challenges over plain HTTP.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# --- HTTPS -------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name example.com;

    # ---- TLS (point these at your certificate) ----
    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;  # enable once you're sure HTTPS is solid

    # Uploads / Blossom blobs / generated media can be large. 0 = no limit; set a cap if you prefer.
    client_max_body_size 0;

    # ~2.9 MB of client JS/CSS per cold load (app.js alone is 1.6 MB -> 622 KB), re-paid on every
    # deploy by the `?v=` cache-buster — and free here, since the /static block below serves it off
    # disk. text/javascript is the entry that does the work: that is what both nginx and the app
    # type .js as, so a list carrying only application/javascript compresses nothing at all.
    gzip            on;
    gzip_proxied    any;
    gzip_min_length 1024;
    gzip_types      text/plain text/css text/javascript text/xml application/javascript
                    application/json application/manifest+json image/svg+xml;

    # Headers every proxied location needs. X-Forwarded-Proto=$scheme is REQUIRED: the app uses it
    # to know it's behind HTTPS (sets the upgrade-insecure-requests CSP + secure cookies).
    # X-Real-IP is what the RELAY trusts for the client address (it prefers this over the forgeable
    # X-Forwarded-For); without it every relay connection is logged as the proxy's own address.
    #
    # Upgrade/Connection are hoisted UP HERE with them, and no `location` below sets a header of its
    # own. proxy_set_header is an nginx ARRAY directive: a location that sets one header inherits
    # NONE of these. With the two WebSocket headers declared per-location instead, /relay, /ws/,
    # /api/ and `location /` all silently lost Host + X-Forwarded-Proto + X-Real-IP — and nothing
    # errors, the relay just starts publishing the nginx upstream name as its NIP-11 host. Declaring
    # them here is safe for ordinary requests: the `map` above yields `close` when there's no upgrade.
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_buffering off;

    # ---- Optional built-in CODE office editor --------------------------------
    # Installed by `./install.sh --office`, or Docker's `--profile office`. CODE stays on loopback;
    # this same-origin prefix carries its assets, WOPI UI and long-lived editing WebSocket.
    #
    # ADD IT ONLY ONCE CODE IS ACTUALLY INSTALLED SOMEWHERE. The editor is opt-in and ships off, so
    # on a node that never ran `--office` this block is a location that can only 502 — and the
    # 📝 button it serves is hidden anyway (the client gates it on `office_enabled`, which the app
    # reports from POSTERCHANAI_OFFICE). Adding it "ready for later" buys nothing and gives a
    # support question a wrong answer.
    location ^~ /office-code/ {
        # NO REWRITE. The prefix is passed through UNTOUCHED, because CODE is started with
        # `--o:net.service_root=/office-code` and therefore both serves and ADVERTISES every path
        # under it. Stripping it here made cool.html load and then ask for /browser/<hash>/global.js
        # at the site root — a white document frame, four 404s in the console, and nothing in any
        # log, since cool.html itself had been served perfectly.
        proxy_pass http://posterchanai_office;
        proxy_set_header X-Forwarded-Prefix /office-code;
        # CODE derives frame-ancestors from the public web host. That permits an ordinary browser
        # and rejects the two bundled clients which embed this SAME authenticated WOPI session:
        # Electron is app://posterchan and Capacitor is https://localhost (older builds use
        # capacitor://localhost). Two CSP headers are intersected, not overridden, so hide CODE's
        # generated header before adding the complete constrained replacement.
        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-eval'; style-src 'self'; img-src 'self' data: blob: https://www.collaboraoffice.com; font-src 'self'; media-src 'self' blob:; object-src 'self'; connect-src 'self' wss:; frame-src 'self' blob: https://rating.collaboraonline.com; frame-ancestors 'self' app: capacitor: https://localhost" always;
        proxy_read_timeout 36000s;
        proxy_send_timeout 36000s;
    }

    # ---- Built-in Nostr relay (wss://example.com/relay) --------------------
    # The relay listens on ws://127.0.0.1:3052/relay. This makes it reachable as a normal
    # secure relay URL. (To give the relay its own hostname instead, copy this into a second
    # server block for relay.example.com as `location / { proxy_pass http://posterchanai_relay; }`
    # — with NO URI on the proxy_pass, so the relay's welcome page and NIP-11 doc advertise
    # wss://relay.example.com/ rather than a /relay path that name doesn't serve. A ready-made
    # version of that block is in nostr-docker.conf.example.)
    location = /relay {
        proxy_pass http://posterchanai_relay/relay;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    # NIP-11 relay info + the relay's welcome page (GET https://example.com/relay-info).
    location = /relay-info {
        proxy_pass http://posterchanai_relay/;
    }

    # ---- Chat WebSocket (/ws/chat/<id>) ------------------------------------
    location ^~ /ws/ {
        proxy_pass http://posterchanai_app;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ---- API (+ websockets used by some endpoints) -------------------------
    location ^~ /api/ {
        proxy_pass http://posterchanai_app;
        proxy_read_timeout 3600s;   # long LLM / media generations
        proxy_send_timeout 3600s;
    }

    # ---- OpenAI-compatible API (/v1/...) -----------------------------------
    location ^~ /v1 {
        proxy_pass http://posterchanai_app;   # nginx forwards Authorization as-is
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ---- Git-over-Nostr smart-HTTP (git clone/push at https://example.com/git/<npub>/<id>.git) ----
    # The GRASP git host runs as its OWN subprocess on 127.0.0.1:3053 (gated by the git_server_enabled
    # admin setting) so all pack work stays off the app's event loop. Clone packfiles must stream
    # (proxy_buffering off) and pushes can be large. The git host tolerates the /git/ prefix, so no URI
    # rewrite is needed — a plain proxy_pass keeps the full path.
    #
    #   * HOSTING node  (git_server_proxy_url EMPTY): proxy straight to the git host → 127.0.0.1:3053.
    #   * PROXY node    (git_server_proxy_url SET):    proxy to the APP → 127.0.0.1:3051 instead; the
    #                                                  app's /git/ reverse-proxy forwards smart-HTTP to
    #                                                  the hosting node (change 3053 → 3051 below).
    # git_server_bind/port/proxy_url are PER-NODE settings (Admin → Services), so this one block serves
    # both roles — only the upstream port differs by node.
    location ^~ /git/ {
        proxy_pass http://127.0.0.1:3053;    # PROXY node: use http://127.0.0.1:3051 (the app) instead
        proxy_buffering off;                 # stream clone packfiles
        client_max_body_size 0;              # large pushes (bounded by git_server_repo_max_mb)
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ---- Static assets (optional but recommended) --------------------------
    # The app serves /static fine, but PROXYING it means a brief "Loading failed for <script>" window
    # while the app restarts on deploy. If nginx is on the same host as the app, serve the files
    # straight off disk so the page keeps loading across restarts; fall back to the app for anything
    # not on disk. The `?v=<mtime>` query busts caches on deploy, and `no-cache` makes a CDN in front
    # (e.g. Cloudflare) REVALIDATE rather than pin a stale build — otherwise it can serve old JS for
    # weeks. (Delete this block to just proxy /static to the app via `location /` like everything else.)
    location ^~ /static/ {
        root /opt/posterchanai;                         # -> /opt/posterchanai/static/...  (your checkout)
        try_files $uri @app;
        add_header Cache-Control "no-cache, must-revalidate" always;
        access_log off;
    }
    location @app { proxy_pass http://posterchanai_app; }

    # ---- Everything else: web client, /client, /blossom, admin -------------
    location / {
        proxy_pass http://posterchanai_app;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# -----------------------------------------------------------------------------
# Optional: the relay on its own hostname — wss://relay.example.com/
# -----------------------------------------------------------------------------
# Most Nostr clients expect a relay at the ROOT of a host, and some paste-a-relay boxes quietly drop
# a path. Keeping both forms is free: the same relay process answers on both names. Add
# relay.example.com to DNS, include it on the cert (`certbot --nginx -d example.com -d
# relay.example.com`), and uncomment:
#
#   server {
#       listen 443 ssl;
#       listen [::]:443 ssl;
#       http2 on;
#       server_name relay.example.com;
#
#       ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
#       ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
#       ssl_protocols       TLSv1.2 TLSv1.3;
#
#       # Every header at server level, none inside the location — same array-directive rule as above.
#       proxy_http_version 1.1;
#       proxy_set_header Host              $host;
#       proxy_set_header X-Real-IP         $remote_addr;
#       proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#       proxy_set_header X-Forwarded-Proto $scheme;
#       proxy_set_header Upgrade           $http_upgrade;
#       proxy_set_header Connection        $connection_upgrade;
#       proxy_buffering off;
#
#       # NOTE the proxy_pass carries NO URI. The relay accepts the WebSocket upgrade on any path and
#       # echoes back the path it was reached on, so passing `/` through unchanged makes its welcome
#       # page and NIP-11 document advertise wss://relay.example.com/ — the URL that works on this
#       # name. Rewriting to /relay would hand every visitor a path this server block doesn't serve.
#       location / {
#           proxy_pass http://posterchanai_relay;
#           proxy_read_timeout 3600s;
#           proxy_send_timeout 3600s;
#       }
#
#       # NIP-05 for name@relay.example.com (the relay answers it, and sets CORS itself).
#       location = /.well-known/nostr.json { proxy_pass http://posterchanai_relay; }
#   }

# -----------------------------------------------------------------------------
# Optional: survive an app restart with ZERO error page (advanced, behind a CDN)
# -----------------------------------------------------------------------------
# An app restart makes `/` 502 for a few seconds → a CDN in front shows its own error page. To serve
# the last-good client shell instead, cache `location = /` with `proxy_cache_use_stale`:
#
#   # http{} context (next to the upstreams):
#   proxy_cache_path /tmp/pcai-cache levels=1:2 keys_zone=pcai:10m max_size=200m inactive=1d;
#
#   # inside the HTTPS server{}, BEFORE `location / {`:
#   location = / {
#       proxy_pass http://posterchanai_app/client;
#       proxy_buffering on; proxy_cache pcai; proxy_cache_valid 200 30s;   # short TTL keeps ?v= fresh
#       proxy_cache_use_stale error timeout updating http_502 http_503 http_504;
#   }
#
# Blossom blobs are immutable (sha256-addressed) → ideal to cache long in a tmpfs: same
# proxy_cache_path pattern with `proxy_cache_valid 200 30d` on the /blossom (or media subdomain) block.
