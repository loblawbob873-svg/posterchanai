# =============================================================================
# PosterChanAI — Nostr-only in Docker: nginx reverse proxy (TLS terminator)
# =============================================================================
# For the lean Nostr deployment:  docker compose --profile nostr up -d --build
# (relay + web client + Blossom, no AI). The container speaks plain HTTP/WS on
# :3051 (app) and :3052 (relay); this puts real HTTPS/WSS in front of both.
#
# You get:
#   https://example.com/client                    the web client
#   wss://example.com/relay                       the relay, on the same name
#   wss://relay.example.com/                      the relay on its OWN name (2nd server block)
#   https://example.com/.well-known/nostr.json    NIP-05 names (answered by the relay)
#   https://example.com/blossom/<sha256>          Blossom media
#
#   1. DNS:    point example.com (and relay.example.com if you keep that block) at this host.
#   2. Copy:   sudo cp nginx/nostr-docker.conf.example /etc/nginx/sites-available/posterchanai.conf
#   3. Edit:   replace EVERY  example.com  with your domain. Check the UPSTREAMS block below.
#   4. Cert:   sudo certbot --nginx -d example.com -d relay.example.com
#   5. Enable: sudo ln -s /etc/nginx/sites-available/posterchanai.conf /etc/nginx/sites-enabled/
#   6. Test:   sudo nginx -t && sudo systemctl reload nginx
#
# Then set the public URLs in the app so it stops advertising http://<ip>:3051 to the world:
#   Admin → Relay   → NIP-05 domain           = example.com
#   Admin → Blossom → Public base URL         = https://example.com/blossom
#   Admin → Git     → Public base URL         = https://example.com/git   (only with POSTERCHANAI_GIT=1)
#
# Running the AI build (cuda/rocm/intel/cpu) instead? Use posterchanai.conf.example — it adds the
# OpenAI-compatible /v1 API and serves /static off a bare-metal checkout, neither of which applies
# to a Nostr-only container. Everything below works for both.
# =============================================================================


# --- UPSTREAMS — read this, it is the one thing Docker changes -----------------
# nginx ON THE HOST (recommended): the compose file publishes 3051/3052, so localhost is right.
upstream posterchanai_app   { server 127.0.0.1:3051; }
upstream posterchanai_relay { server 127.0.0.1:3052; }
#
# nginx IN A CONTAINER on the same compose network: 127.0.0.1 is then NGINX ITSELF, and you get
# "connect() failed (111: Connection refused)" on every request. Use the compose SERVICE NAME
# (`nostr`) and the container-internal ports, which need no `ports:` publishing at all:
#
#   upstream posterchanai_app   { server nostr:3051; }
#   upstream posterchanai_relay { server nostr:3052; }
#
# Either way, once nginx fronts everything you want the published ports on loopback instead of
# 0.0.0.0 — otherwise http://<public-ip>:3051 still answers, bypassing TLS. In a `.env` next to
# docker-compose.yml (these two variables only set the host side of the port mapping):
#
#   POSTERCHANAI_PORT=127.0.0.1:3051
#   POSTERCHANAI_NOSTR_RELAY_PORT=127.0.0.1:3052
#
# ...then `docker compose --profile nostr up -d`. With nginx in a container, drop those port
# mappings entirely and publish only nginx's 80/443.
# ------------------------------------------------------------------------------

# WebSocket upgrade plumbing — the relay AND the app's own sockets both need it.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Optional: cap concurrent relay sockets per IP so one client can't open thousands. Keep it
# generous — a phone, a desktop and a NATted household share one address, and each open tab is
# a socket. Uncomment here AND the `limit_conn` line in the relay locations.
# limit_conn_zone $binary_remote_addr zone=relayconn:10m;


# --- HTTP -> HTTPS ------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name example.com relay.example.com;

    # Let certbot answer ACME challenges over plain HTTP.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}


# --- Main host: web client + Blossom + the relay at /relay --------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;  # once HTTPS is solid

    # The client is a few hundred KB of JS/CSS. Blobs and media are already compressed — don't
    # re-compress them.
    gzip            on;
    gzip_proxied    any;
    gzip_min_length 1024;
    gzip_types      text/plain text/css application/javascript application/json
                    application/manifest+json image/svg+xml;

    # Blossom uploads and Nostr media go through here. 0 = no limit; if you set a number, keep it
    # >= Admin → Blossom → Max upload MB, or uploads die at nginx with a 413 the client can't explain.
    client_max_body_size 0;

    # Headers every proxied location needs.
    #   Host               the relay builds its NIP-11 icon/banner URLs and its welcome page from
    #                      this. Lose it and they advertise the nginx UPSTREAM NAME as a hostname.
    #   X-Forwarded-Proto  the app reads it to know it's on HTTPS (secure cookies + the
    #                      upgrade-insecure-requests CSP). Without it the client can load over a
    #                      bare-http origin and browsers block its own subresources.
    #   X-Real-IP          AUTHORITATIVE for the relay (it prefers this header over XFF, which a
    #                      client can forge). In Docker the socket peer is the bridge gateway, so
    #                      without this every connection logs as one 172.x address and the relay's
    #                      per-IP accounting and "online people" count collapse into a single user.
    #
    # ALL SEVEN LIVE HERE, INCLUDING Upgrade/Connection, AND NO `location` BELOW SETS A HEADER OF
    # ITS OWN. proxy_set_header is an nginx ARRAY directive: a location that sets one header
    # inherits NONE of the server-level ones. The usual shape — these here, `Upgrade`/`Connection`
    # down in the WebSocket locations — silently drops Host, X-Real-IP and X-Forwarded-Proto on
    # exactly the locations that most need them, and nothing errors: the relay just starts
    # answering with the upstream's name in its NIP-11 doc. Hoisting the two WebSocket headers up
    # here is safe for ordinary requests too — the `map` above sends `Connection: close` whenever
    # the client didn't ask to upgrade.
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_buffering off;

    # ---- NIP-05 (name@example.com) ------------------------------------------
    # The RELAY answers this, not the app — configure the names in Admin → Relay → NIP-05 identity
    # server. It sets Access-Control-Allow-Origin itself, so browser clients can verify. Must be
    # served from the APEX of the name people put after the @.
    location = /.well-known/nostr.json {
        proxy_pass http://posterchanai_relay;
    }

    # ---- The relay: wss://example.com/relay ---------------------------------
    # A browser GET of the same URL returns the relay's welcome page, and a request with
    # `Accept: application/nostr+json` returns the NIP-11 info document — one location covers all
    # three. The path is preserved on purpose: the welcome page advertises the exact URL it was
    # reached on, so a rewrite here makes it tell clients to connect somewhere that doesn't exist.
    location = /relay {
        proxy_pass http://posterchanai_relay/relay;
        proxy_read_timeout 3600s;   # subscriptions are long-lived and mostly idle — a short
        proxy_send_timeout 3600s;   # timeout here shows up as a feed that "stops after a while"
        # limit_conn relayconn 32;
    }

    # ---- Blossom media (BUD-01/02) ------------------------------------------
    # Covered by the catch-all below, but uploads want their own rules: streaming the body through
    # instead of buffering a whole file to disk first, and time to finish on a slow uplink.
    location ^~ /blossom {
        proxy_pass http://posterchanai_app;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # ---- Git-over-Nostr (only with POSTERCHANAI_GIT=1) ----------------------
    # The GRASP host runs on :3053. Uncomment to serve clones/pushes over TLS instead of publishing
    # the port; also set POSTERCHANAI_GIT_PUBLIC_BASE=https://example.com/git so the clone URLs it
    # hands out match. In a container-nginx setup the upstream is `nostr:3053`. See docs/GIT.md.
    # location ^~ /git/ {
    #     proxy_pass http://127.0.0.1:3053;
    #     proxy_buffering off;             # clone packfiles stream
    #     client_max_body_size 0;          # pushes can be large
    #     proxy_read_timeout 3600s;
    #     proxy_send_timeout 3600s;
    # }

    # ---- Everything else: /client, /api, /ws, static assets, admin ----------
    location / {
        proxy_pass http://posterchanai_app;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}


# --- The relay on its own hostname: wss://relay.example.com/ ------------------
# Most Nostr clients expect a relay at the ROOT of a host, and some paste-a-relay boxes quietly
# drop the path. Keeping both is free — the same relay process answers on both names. Delete this
# block (and relay.example.com from the two server_name lines above) if you only want the path form.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name relay.example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;   # -d example.com -d relay.example.com
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;

    # Same rule as the main block: every header at server level, none in a location.
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_buffering off;

    # No proxy_pass URI here, deliberately. The relay accepts the WebSocket upgrade on ANY path, so
    # passing `/` straight through makes its welcome page and NIP-11 doc advertise
    # wss://relay.example.com/ — the URL that actually works on this name. Rewriting to /relay would
    # hand every visitor a URL with a path this server block doesn't define.
    location / {
        proxy_pass http://posterchanai_relay;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # limit_conn relayconn 32;
    }

    # NIP-05 for name@relay.example.com. Harmless to keep even if you only use the apex name.
    location = /.well-known/nostr.json {
        proxy_pass http://posterchanai_relay;
    }
}

# -----------------------------------------------------------------------------
# Running nginx as a container instead? Put this in docker-compose.override.yml, point the
# upstreams at `nostr:3051` / `nostr:3052` (see UPSTREAMS above), and drop the app/relay port
# mappings so nothing but 80/443 is published:
#
#   services:
#     nginx:
#       image: nginx:alpine
#       restart: unless-stopped
#       ports: ["80:80", "443:443"]
#       volumes:
#         - ./nginx/nostr-docker.conf.example:/etc/nginx/conf.d/default.conf:ro
#         - ./certs:/etc/letsencrypt:ro        # certs issued on the host, or by a certbot sidecar
#       depends_on: [nostr]
#
# Compose puts every service on one network, so `nostr` resolves by DNS. Note that certbot's
# --nginx plugin cannot edit a config inside a container: issue with `certbot certonly --webroot`
# (or DNS-01) and mount the result read-only.
# -----------------------------------------------------------------------------
#
# WAF / Cloudflare: the relay and the app's WebSockets authenticate with tokens, NOT cookies —
# filtering /relay, /ws/ or /api/ by User-Agent 403s real clients. Cloudflare's proxy also caps
# uploads (100 MB on the free plan), which shows up as failed Blossom uploads of larger files.
#
# Firewall: with nginx in front you usually want only 80/443 reachable from the internet.
