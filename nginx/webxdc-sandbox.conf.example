# ---------------------------------------------------------------------------------------------
# xdc.poster.place — the webxdc sandbox origin, where mini apps (.xdc games, polls, shared
# editors) actually run.
#
# An app is code written by whoever posted it. It runs in an iframe, and the only thing between
# that code and the client's localStorage — where the user's Nostr key and session live — is the
# same-origin policy. So it must not run on the instance's own origin. A separate hostname is a
# separate origin, and that is the whole requirement.
#
# TWO OTHER DESIGNS WERE TRIED FIRST, and both are recorded because both look right:
#
#   * A SUBDOMAIN PER APP (what Ditto does, via iframe.diy) also isolates apps from each other.
#     It needs a WILDCARD certificate, which certbot cannot issue over HTTP-01 — that means
#     DNS-01, which means a DNS provider API token living on this web server.
#   * A PORT (https://poster.place:8443) is a distinct origin needing no new certificate at all,
#     which made it the obvious answer. MEASURED, it does not survive Cloudflare: CF accepts 8443
#     from the browser and then connects to the ORIGIN on 443, so the request lands on the main
#     vhost and the sandbox is never reached. Proven with a marker header — present on a direct
#     request, absent through the CDN. Do not re-attempt it.
#
# So: one ordinary hostname, one extra -d on the certificate certbot already renews.
#
# ---------------------------------------------------------------------------------------------
# WHAT THIS NEEDS, once — and `./install.sh --webxdc` does all of it, including refusing before it
# writes anything if the DNS record is not there yet:
#   1. DNS:  xdc.poster.place  ->  wherever poster.place points (a CNAME to poster.place is fine;
#            proxied through Cloudflare is fine).
#   2. TLS:  sudo certbot --nginx -d xdc.poster.place
#            A certificate of its OWN, like every other subdomain here (ai., adguard., …), and
#            certbot registers its renewal. HTTP-01, no wildcard, no DNS API token.
#            NOT `--expand -d poster.place -d xdc.poster.place`: that rewrites the PRODUCTION
#            certificate to add a game feature, so a failed issuance takes the instance off TLS.
# Until both exist this vhost answers only over the LAN, with a certificate warning.
# ---------------------------------------------------------------------------------------------
#
# What it serves is TWO files, both from the app itself (hence a plain proxy_pass): the sandbox
# loader at /__sandbox__/ and the service worker at /sw.js. The app's own bytes never reach this
# server — the client downloads the .xdc, unzips it in the browser, and hands the files to that
# worker over postMessage. Having nothing here to fetch is what makes "no network access" (the
# webxdc spec's one hard rule) true by construction rather than by promise.
#
# Nothing else is exposed. This is not a second front door to the instance: every other path is
# refused, so a bug in an unrelated route cannot be reached from an origin untrusted code runs on.
#
# Reload: sudo nginx -t && sudo systemctl reload nginx
# ---------------------------------------------------------------------------------------------

server {
    listen 80;
    listen [::]:80;
    server_name xdc.poster.place;
    # A service worker needs a secure context, so an app reached over http:// would die at
    # registration with an error nobody can act on. Redirect — except the ACME challenge, which is
    # how this hostname gets onto the certificate in the first place.
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name xdc.poster.place;

    # This host has its OWN certificate (certbot --nginx -d xdc.poster.place), matching how every
    # other subdomain here is done. Do NOT point these at poster.place's: overwriting this file with
    # an older copy did exactly that once and took TLS down on the sandbox origin until it was spotted.
    ssl_certificate     /etc/letsencrypt/live/xdc.poster.place/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xdc.poster.place/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 1M;
    access_log off;

    location = /sw.js {
        proxy_pass http://192.168.0.2:3051;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store" always;
        # NB: Service-Worker-Allowed is set by the APP, not here. Setting it in both places sends the
        # header TWICE, fetch combines duplicates into "/, /", and that is not a valid scope prefix:
        # Chrome ignores it (the script is at the root, so "/" is already its maximum scope) and
        # FIREFOX REFUSES THE REGISTRATION with `SecurityError: The operation is insecure` — which
        # reads as "Firefox does not allow service workers here" and is not that at all.
    }

    location /__sandbox__ {
        proxy_pass http://192.168.0.2:3051;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store" always;
    }

    # Everything else here is the APP's, and its service worker answers it from the archive the
    # client unzipped. A request only reaches nginx when the worker is not yet CONTROLLING this
    # origin — a real race: the loader registers the worker, the worker activates and claims, and the
    # app frame can navigate in between. Chromium claims fast enough to hide it; Firefox does not,
    # and the reader got this server's 404 page inside the game window.
    #
    # So the miss reloads itself, ONCE. By the second load the worker is controlling and serves the
    # app. The `?r` guard is what stops a worker that never arrives from becoming a reload loop; it
    # says what happened instead, which is the one thing a blank 404 could not.
    location / {
        default_type text/html;
        return 200 '<!doctype html><meta charset="utf-8"><title>starting…</title><style>html,body{margin:0;height:100%;background:#000;color:#888;font:13px system-ui,sans-serif;display:flex;align-items:center;justify-content:center;text-align:center;padding:20px}</style><div id=m>starting…</div><script>if(!location.search.includes("r=1")){location.replace(location.pathname+"?r=1"+location.hash);}else{document.getElementById("m").textContent="The app could not start: its service worker never took control of this page. Close the app and open it again.";}</script>';
    }
}
