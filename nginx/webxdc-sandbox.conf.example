# ---------------------------------------------------------------------------------------------
# The webxdc sandbox origin — one throwaway subdomain per running mini app.
#
# A .xdc app is code written by whoever posted it. It runs in an iframe, and the only thing between
# that code and the client's localStorage — where the user's Nostr key and session live — is the
# same-origin policy. So every app gets its OWN origin here.
#
# This vhost serves TWO things, both from the app itself (which is why it is a plain proxy_pass like
# every other one): the sandbox loader at /__sandbox__/ and the service worker at /sw.js. The app's
# own bytes never reach this server — the client downloads the .xdc, unzips it in the browser, and
# hands the files to that worker over postMessage. Nothing here to fetch is what makes "no network
# access" (the webxdc spec's one hard rule) true by construction.
#
# THE SERVER_NAME IS A LENGTH-BOUNDED REGEX, deliberately. A bare wildcard would swallow every other
# subdomain that has its own vhost. The client's label is 50 characters of base36 (an HMAC of a
# per-device secret and the app's id), so 40-63 cannot collide with a real hostname like `news` or
# `ai` — and cannot shadow one added later either.
#
# WHAT STILL HAS TO BE ADDED BY HAND, once, and only you can do it:
#
#   1. PUBLIC DNS. `*.poster.place` does not exist (checked: NXDOMAIN, while the apex resolves to
#      Cloudflare). Add a wildcard A/CNAME for `*` in Cloudflare pointing where poster.place points.
#      Until then nothing outside the LAN can reach a sandbox at all.
#   2. THE ORIGIN CERTIFICATE. The Let's Encrypt cert here covers `poster.place` and nothing else.
#      Cloudflare's universal certificate covers one level of subdomain, so the PUBLIC side is fine
#      the moment the record exists — but if this zone is on SSL mode "Full (strict)", Cloudflare
#      validates the ORIGIN certificate against the hostname too, and a wildcard host would fail.
#      Either use a Cloudflare Origin CA certificate here, or reissue with a DNS-01 wildcard.
#
# This file is the vhost as DEPLOYED on router.lan (/etc/nginx/sites-enabled/webxdc.conf).
# Reload: sudo nginx -t && sudo systemctl reload nginx
#
# NB: the regex is QUOTED. nginx reads a bare { as the start of a block, so an unquoted {40,63}
# fails the config test with "server_name is not terminated by ;" — which is a syntax error about
# a line that is syntactically fine, and reads as nonsense until you know why.
# ---------------------------------------------------------------------------------------------

server {
    listen 80;
    server_name "~^[a-z0-9]{40,63}\.poster\.place$";
    # A service worker needs a secure context, so an app reached over http:// would die at
    # registration with an error nobody can act on. Redirect, never serve.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name "~^[a-z0-9]{40,63}\.poster\.place$";

    # The apex certificate. Cloudflare terminates TLS for the public with its own universal
    # certificate (which covers one level of subdomain); this is what CF connects to behind it.
    ssl_certificate     /etc/letsencrypt/live/poster.place/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/poster.place/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Mini apps are small and self-contained; nothing is uploaded to this origin at all.
    client_max_body_size 1M;
    access_log off;

    # Host is load-bearing rather than boilerplate: the app decides WHICH service worker to serve at
    # /sw.js from the hostname — the PWA's on poster.place, the sandbox's on one of these labels —
    # and refuses /__sandbox__/ anywhere but here. Rewriting Host would serve the wrong one.
    location / {
        proxy_pass http://192.168.0.2:3051;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;

        # Never cached, anywhere. The loader and the worker are tiny, and a stale worker on an
        # origin that is meant to be disposable is a mini app that cannot start with no way to say
        # why. (The app's own files are not served from here at all, so there is nothing else to
        # cache.)
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        add_header Cache-Control "no-store" always;
    }
}
