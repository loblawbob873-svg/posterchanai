# Copy to media-center.env for the bare-metal installer's systemd service.
# The installer creates that file only if absent; updates preserve your settings.
# Docker: pass these through Compose instead. See docs/MEDIA_CENTER.md.
# Default: $POSTERCHANAI_DATA/media, or /var/lib/posterchanai/media.
# Uncomment to use existing mounts:
# POSTERCHANAI_MEDIA_ROOTS=/srv/media:/mnt/movies
POSTERCHANAI_MEDIA_CACHE=/tmp/posterchan-media-center
POSTERCHANAI_MEDIA_VAAPI_DEVICE=/dev/dri/renderD128
# NAS proxy address, permissions and bandwidth limits are persisted through Admin.
