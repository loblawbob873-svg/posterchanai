{
  "manifest_version": 3,
  "name": "PosterChan Passwords",
  "version": "1.4.6",
  "description": "Autofill, one-time codes and a password generator for your PosterChan vault. Decrypted on your device, never sent to any server.",
  "browser_specific_settings": {
    "gecko": {
      "id": "passwords@poster.place",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo"
        ],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": [
      "vendor/nostr.bundle.js",
      "vaultcore.js",
      "bookmarks.js",
      "shot.js",
      "drive.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "PosterChan Passwords",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "inject.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "permissions": [
    "activeTab",
    "alarms",
    "bookmarks",
    "clipboardWrite",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
